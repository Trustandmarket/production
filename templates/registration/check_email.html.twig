{% extends 'base.html.twig' %}

{% block title %}Trust & Market | Confirmation email{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        body {
            background: #f5f5f5 !important;
            background-image: none !important;
        }

        .tm-check-email-page {
            min-height: 100vh;
            padding: 320px 18px 104px;
            background: #f5f5f5;
            font-family: "Palanquin", sans-serif;
            color: #212529;
            width: 100%;
            box-sizing: border-box;
            display: flex;
            align-items: flex-start;
            justify-content: center;
        }

        .tm-check-email-wrap {
            width: 100%;
            max-width: 920px;
            margin: 0;
            display: flex;
            justify-content: center;
        }

        .tm-check-email-card {
            position: relative;
            width: 100%;
            max-width: 920px;
            margin: 0;
            padding: 1.2rem 1.15rem 1.8rem;
            border-radius: 32px;
            background:
                radial-gradient(circle at top left, rgba(241, 124, 48, 0.14), transparent 22%),
                radial-gradient(circle at bottom right, rgba(16, 16, 16, 0.04), transparent 26%),
                linear-gradient(135deg, #fff9f4 0%, #ffffff 46%, #f6f7f9 100%);
            border: 1px solid rgba(241, 124, 48, 0.18);
            box-shadow: 0 24px 60px rgba(26, 26, 26, 0.10);
            overflow: hidden;
        }

        .tm-check-email-topbar {
            position: relative;
            min-height: 56px;
            margin-bottom: clamp(1.1rem, 2vh, 1.45rem);
        }

        .tm-check-email-logo {
            position: absolute;
            top: 0;
            left: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .tm-check-email-logo img {
            width: 46px;
            height: 46px;
            object-fit: contain;
        }

        .tm-check-email-heading-group {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding-top: 52px;
        }

        .tm-check-email-kicker {
            margin: 0 0 .35rem 0;
            font-size: .78rem;
            font-weight: 700;
            letter-spacing: .22em;
            text-transform: uppercase;
            color: #f17c30;
            font-family: "Palanquin Dark", sans-serif;
            text-align: center;
        }

        .tm-check-email-heading {
            margin: 0;
            color: #101010;
            font-size: clamp(1.9rem, 3.1vh, 2.15rem);
            line-height: 1.15;
            font-family: "Palanquin Dark", sans-serif;
            font-weight: 700;
            text-transform: uppercase;
            text-align: center;
        }

        .tm-check-email-subheading {
            margin: 10px 0 0 0;
            color: #212529;
            font-size: .98rem;
            line-height: 1.55;
            text-align: center;
            font-family: "Palanquin", sans-serif;
        }

        .tm-check-email-steps {
            margin-bottom: 22px;
            padding: 1rem 1.1rem;
            border-radius: 26px;
            background: linear-gradient(180deg, rgba(255,255,255,0.98) 0%, rgba(255,255,255,0.92) 100%);
            border: 1px solid rgba(18, 18, 18, 0.07);
            box-shadow: 0 16px 36px rgba(17, 17, 17, 0.07);
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: .8rem;
            backdrop-filter: blur(6px);
        }

        .tm-check-email-step {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            min-height: 82px;
            gap: .3rem;
            color: #212529;
        }

        .tm-check-email-step.is-upcoming {
            opacity: .72;
        }

        .tm-check-email-step-index {
            display: inline-flex;
            width: 24px;
            height: 24px;
            align-items: center;
            justify-content: center;
            border-radius: 999px;
            background: rgba(17, 17, 17, 0.10);
            color: #fff;
            font-size: .68rem;
            font-weight: 600;
        }

        .tm-check-email-step.is-active .tm-check-email-step-index {
            background: linear-gradient(90deg, #f17c30 0%, #ffb787 100%);
        }

        .tm-check-email-step strong {
            display: block;
            font-size: .98rem;
            font-family: "Palanquin Dark", sans-serif;
            font-weight: 700;
            letter-spacing: .16em;
            text-transform: uppercase;
        }

        .tm-check-email-step span {
            display: block;
            font-size: .86rem;
            line-height: 1.42;
            font-family: "Palanquin", sans-serif;
        }

        .tm-check-email-panel {
            width: 100%;
            max-width: 680px;
            margin: 30px auto 0;
            text-align: center;
        }

        .tm-check-email-panel p {
            margin: 0;
            color: #212529;
            font-size: .98rem;
            line-height: 1.72;
        }

        .tm-check-email-message {
            max-width: 580px;
            margin: 0 auto;
            text-align: left;
            font-size: .98rem;
            font-family: "Palanquin", sans-serif;
        }

        .tm-check-email-status {
            margin: 1.45rem auto 0;
            max-width: 580px;
            display: flex;
            align-items: center;
            gap: .75rem;
            padding: 1rem 1.2rem;
            border-radius: 22px;
            background: linear-gradient(180deg, rgba(255,255,255,0.98) 0%, rgba(255,255,255,0.92) 100%);
            border: 1px solid rgba(18, 18, 18, 0.07);
            box-shadow: 0 16px 36px rgba(17, 17, 17, 0.07);
            text-align: left;
            margin-bottom: 1.55rem;
        }

        .tm-check-email-status-icon {
            width: 30px;
            height: 30px;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 auto;
            background: rgba(241, 124, 48, 0.10);
            color: #f17c30;
            font-size: .95rem;
        }

        .tm-check-email-status-text {
            font-size: 0;
            line-height: 1.5;
            font-family: "Palanquin Dark", sans-serif;
            font-weight: 700;
        }

        .tm-check-email-status-text::after {
            content: "Découvrez votre compte dès maintenant. Ensuite, validez votre email et accédez à toutes les fonctionnalités.";
            display: block;
            font-size: .98rem;
            line-height: 1.5;
        }

        .tm-check-email-profile-title {
            margin: 0 auto 1rem;
            max-width: 580px;
            text-align: left;
            font-size: .98rem;
            line-height: 1.4;
            color: #212529;
            font-weight: 700;
            font-family: "Palanquin Dark", sans-serif;
        }

        .tm-check-email-profile-card {
            width: 100%;
            max-width: 580px;
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 1.05rem 1.15rem;
            border-radius: 22px;
            background: rgba(255,255,255,0.98);
            border: 1px solid rgba(18, 18, 18, 0.08);
            box-shadow: 0 14px 30px rgba(17, 17, 17, 0.06);
            text-align: left;
        }

        .tm-check-email-profile-copy strong {
            display: block;
            margin-bottom: .3rem;
            font-size: .98rem;
            line-height: 1.3;
            color: #212529;
            font-family: "Palanquin Dark", sans-serif;
            font-weight: 700;
        }

        .tm-check-email-profile-copy span {
            display: block;
            font-size: .95rem;
            line-height: 1.5;
            color: #212529;
            opacity: .82;
            font-family: "Palanquin", sans-serif;
        }

        .tm-check-email-profile-arrow {
            color: #c4b49f;
            font-size: 1.35rem;
            line-height: 1;
            flex: 0 0 auto;
        }

        .tm-check-email-actions {
            margin-top: 1.9rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1.05rem;
        }

        .tm-check-email-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 336px;
            min-height: 50px;
            padding: .85rem 2.5rem;
            border-radius: 16px;
            border: 1px solid transparent;
            text-decoration: none;
            font-family: "Palanquin Dark", sans-serif;
            font-size: .98rem;
            font-weight: 700;
            transition: border-color .2s ease, box-shadow .2s ease, color .2s ease, background .2s ease;
        }

        .tm-check-email-btn-primary {
            background: linear-gradient(135deg, #f17c30 0%, #ff9f60 100%);
            color: #ffffff;
            border-color: transparent;
            box-shadow: 0 12px 26px rgba(241, 124, 48, 0.22);
        }

        .tm-check-email-btn-primary:hover,
        .tm-check-email-btn-primary:focus {
            color: #ffffff;
            border-color: transparent;
            box-shadow: 0 16px 30px rgba(241, 124, 48, 0.28);
        }

        .tm-check-email-btn-secondary {
            background: transparent;
            color: #212529;
            border-color: transparent;
            min-height: auto;
            padding: 0;
            min-width: 0;
            font-family: "Palanquin", sans-serif;
            font-weight: 400;
            box-shadow: none;
        }

        .tm-check-email-link {
            color: #212529;
            text-decoration: none;
            font-size: .98rem;
            line-height: 1.5;
            opacity: .78;
        }

        .tm-check-email-link:hover,
        .tm-check-email-btn-secondary:hover {
            opacity: 1;
            color: #212529;
            text-decoration: none;
        }

        .tm-check-email-footer {
            margin-top: 18px;
            display: flex;
            justify-content: flex-start;
            font-size: .96rem;
        }

        .tm-check-email-footer a {
            color: #212529;
            text-decoration: none;
        }

        .tm-check-email-alert {
            max-width: 740px;
            margin: 0 auto 18px;
            padding: .95rem 1rem;
            border-radius: 18px;
            background: #fff4f4;
            border: 1px solid rgba(193, 61, 61, 0.22);
            color: #b43737;
            font-size: .95rem;
            line-height: 1.5;
            text-align: left;
        }

        @media (max-width: 991px) {
            .tm-check-email-page {
                padding: 450px 18px 64px;
            }

            .tm-check-email-card {
                border-radius: 24px;
                padding: 20px 16px 24px;
            }

            .tm-check-email-topbar {
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 14px;
                min-height: auto;
            }

            .tm-check-email-logo {
                position: static;
                order: 1;
            }

            .tm-check-email-heading-group {
                order: 2;
                width: 100%;
                padding-top: 0;
            }

            .tm-check-email-steps {
                grid-template-columns: 1fr;
                gap: 12px;
            }

            .tm-check-email-step {
                min-height: auto;
            }

            .tm-check-email-panel {
                padding: 0;
            }

            .tm-check-email-message,
            .tm-check-email-status,
            .tm-check-email-profile-title,
            .tm-check-email-profile-card {
                max-width: 100%;
            }

            .tm-check-email-btn {
                width: 100%;
                max-width: 320px;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <main class="tm-check-email-page">
        <div class="tm-check-email-wrap">
            <section class="tm-check-email-card">
                <div class="tm-check-email-topbar">
                    <a href="{{ path('home') }}" class="tm-check-email-logo" aria-label="Accueil Trust &amp; Market">
                        <img src="{{ prerender(asset('assets/img/logo_new.svg')) }}" alt="Trust &amp; Market">
                    </a>
                    <div class="tm-check-email-heading-group">
                        <p class="tm-check-email-kicker">Création de compte</p>
                        <h1 class="tm-check-email-heading">CONFIRMEZ VOTRE EMAIL</h1>
                        <p class="tm-check-email-subheading">Votre compte a bien été créé.</p>
                    </div>
                </div>

                <div class="tm-check-email-steps">
                    <div class="tm-check-email-step">
                        <span class="tm-check-email-step-index">1</span>
                        <strong>Créez</strong>
                        <span>Email, mot de passe et type de profil.</span>
                    </div>
                    <div class="tm-check-email-step is-active">
                        <span class="tm-check-email-step-index">2</span>
                        <strong>Confirmez</strong>
                        <span>Validation du compte par email.</span>
                    </div>
                    <div class="tm-check-email-step is-upcoming">
                        <span class="tm-check-email-step-index">3</span>
                        <strong>Complétez</strong>
                        <span>Complétez ensuite votre profil.</span>
                    </div>
                </div>

                {% for message in app.session.flashbag.get('register_email_error') %}
                    <div class="tm-check-email-alert">
                        L’email d’activation n’a pas pu être envoyé automatiquement. {{ message }}
                    </div>
                {% endfor %}

                <div class="tm-check-email-panel">
                    <p class="tm-check-email-message">Nous vous avons envoyé un lien d’activation pour confirmer votre adresse email{% if pending_email %}, {{ pending_email }}{% endif %}, et accéder à la dernière étape de votre profil.</p>

                    <div class="tm-check-email-status">
                        <span class="tm-check-email-status-icon"><i class="fa fa-plus-circle" aria-hidden="true"></i></span>
                        <span class="tm-check-email-status-text">Votre compte n’est pas encore activé.</span>
                    </div>

                    <p class="tm-check-email-profile-title">Je me suis inscrit en tant que :</p>

                    <div class="tm-check-email-profile-card">
                        <div class="tm-check-email-profile-copy">
                            <strong>{{ role_card.title }}</strong>
                            <span>{{ role_card.description }}</span>
                        </div>
                        <span class="tm-check-email-profile-arrow" aria-hidden="true">&rsaquo;</span>
                    </div>

                    <div class="tm-check-email-actions">
                        <a href="{{ path('app_registration_complete_profile') }}" class="tm-check-email-btn tm-check-email-btn-primary">Compléter mon profil</a>
                        <a href="{{ path('app_login') }}" class="tm-check-email-btn tm-check-email-btn-secondary">Se connecter</a>
                    </div>
                </div>

                <div class="tm-check-email-footer">
                    <a href="{{ path('home') }}">&larr;&nbsp;<span>Accueil</span></a>
                </div>
            </section>
        </div>
    </main>
{% endblock %}
