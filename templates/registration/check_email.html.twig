{% extends 'base.html.twig' %}

{% block title %}Trust & Market | Confirmation email{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .tm-check-email-page {
            min-height: 100vh;
            padding: 160px 18px 80px;
            background: #f5f5f5;
            font-family: "Roboto", sans-serif;
            color: #212529;
        }

        .tm-check-email-wrap {
            width: 100%;
            max-width: 920px;
            margin: 0 auto;
        }

        .tm-check-email-card {
            position: relative;
            max-width: 920px;
            margin: 0 auto;
            padding: 1.35rem 1.35rem 1.6rem;
            border-radius: 32px;
            background:
                radial-gradient(circle at top left, rgba(241, 124, 48, 0.14), transparent 22%),
                radial-gradient(circle at bottom right, rgba(16, 16, 16, 0.04), transparent 26%),
                linear-gradient(135deg, #fff9f4 0%, #ffffff 46%, #f6f7f9 100%);
            border: 1px solid rgba(241, 124, 48, 0.18);
            box-shadow: 0 24px 60px rgba(26, 26, 26, 0.10);
            overflow: hidden;
        }

        .tm-check-email-topbar {
            position: relative;
            min-height: 56px;
            margin-bottom: 1.4rem;
        }

        .tm-check-email-logo {
            position: absolute;
            top: 0;
            left: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .tm-check-email-logo img {
            width: 46px;
            height: 46px;
            object-fit: contain;
        }

        .tm-check-email-heading-group {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding-top: 52px;
        }

        .tm-check-email-heading {
            margin: 0;
            color: #212529;
            font-size: clamp(1.72rem, 2.8vh, 2rem);
            line-height: 1.1;
            font-family: "Palanquin Dark", sans-serif;
            font-weight: 700;
            text-transform: uppercase;
            text-align: center;
        }

        .tm-check-email-subheading {
            margin: 10px 0 0 0;
            color: #212529;
            font-size: clamp(.95rem, 1.35vh, 1.05rem);
            line-height: 1.5;
            text-align: center;
        }

        .tm-check-email-steps {
            margin-bottom: 22px;
            padding: 1rem 1.1rem;
            border-radius: 26px;
            background: linear-gradient(180deg, rgba(255,255,255,0.98) 0%, rgba(255,255,255,0.92) 100%);
            border: 1px solid rgba(18, 18, 18, 0.07);
            box-shadow: 0 16px 36px rgba(17, 17, 17, 0.07);
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: .8rem;
            backdrop-filter: blur(6px);
        }

        .tm-check-email-step {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            min-height: 82px;
            gap: .3rem;
            color: #212529;
        }

        .tm-check-email-step.is-upcoming {
            opacity: .72;
        }

        .tm-check-email-step-index {
            display: inline-flex;
            width: 24px;
            height: 24px;
            align-items: center;
            justify-content: center;
            border-radius: 999px;
            background: rgba(17, 17, 17, 0.10);
            color: #fff;
            font-size: .68rem;
            font-weight: 600;
        }

        .tm-check-email-step.is-active .tm-check-email-step-index {
            background: linear-gradient(90deg, #f17c30 0%, #ffb787 100%);
        }

        .tm-check-email-step strong {
            display: block;
            font-size: .98rem;
            font-family: "Palanquin Dark", sans-serif;
            font-weight: 700;
            letter-spacing: .16em;
            text-transform: uppercase;
        }

        .tm-check-email-step span {
            display: block;
            font-size: .86rem;
            line-height: 1.3;
        }

        .tm-check-email-panel {
            max-width: 740px;
            margin: 22px auto 0;
            padding: 1.4rem 1.3rem;
            border-radius: 26px;
            background: linear-gradient(180deg, rgba(255,255,255,0.98) 0%, rgba(255,255,255,0.92) 100%);
            border: 1px solid rgba(18, 18, 18, 0.07);
            box-shadow: 0 16px 36px rgba(17, 17, 17, 0.07);
            text-align: center;
        }

        .tm-check-email-panel h2 {
            margin: 0 0 .75rem 0;
            color: #212529;
            font-size: 1.38rem;
            line-height: 1.2;
            font-family: "Palanquin Dark", sans-serif;
            font-weight: 700;
        }

        .tm-check-email-panel p {
            margin: 0;
            color: #212529;
            font-size: 1rem;
            line-height: 1.65;
        }

        .tm-check-email-address {
            margin: 1rem auto 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 48px;
            padding: .7rem 1rem;
            border-radius: 16px;
            background: rgba(255,255,255,0.9);
            border: 1px solid rgba(18, 18, 18, 0.09);
            box-shadow: 0 8px 18px rgba(17, 17, 17, 0.05);
            font-size: 1rem;
            font-weight: 500;
            word-break: break-word;
        }

        .tm-check-email-help {
            margin-top: 1rem;
            font-size: .94rem;
            color: #212529;
            opacity: .8;
        }

        .tm-check-email-actions {
            margin-top: 1.5rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: .9rem;
        }

        .tm-check-email-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 248px;
            min-height: 42px;
            padding: .62rem 2.2rem;
            border-radius: 14px;
            border: 1px solid transparent;
            text-decoration: none;
            font-family: "Palanquin Dark", sans-serif;
            font-size: .98rem;
            font-weight: 700;
        }

        .tm-check-email-btn-primary {
            background: linear-gradient(135deg, #f17c30 0%, #ff9f60 100%);
            color: #fff;
        }

        .tm-check-email-btn-secondary {
            background: #fff;
            color: #212529;
            border-color: rgba(18, 18, 18, 0.12);
        }

        .tm-check-email-footer {
            margin-top: 18px;
            display: flex;
            justify-content: flex-start;
            font-size: .96rem;
        }

        .tm-check-email-footer a {
            color: #212529;
            text-decoration: none;
        }

        @media (max-width: 991px) {
            .tm-check-email-page {
                padding: 600px 18px 64px;
            }

            .tm-check-email-card {
                border-radius: 24px;
                padding: 20px 16px 24px;
            }

            .tm-check-email-topbar {
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 14px;
                min-height: auto;
            }

            .tm-check-email-logo {
                position: static;
                order: 1;
            }

            .tm-check-email-heading-group {
                order: 2;
                width: 100%;
                padding-top: 0;
            }

            .tm-check-email-steps {
                grid-template-columns: 1fr;
                gap: 12px;
            }

            .tm-check-email-step {
                min-height: auto;
            }

            .tm-check-email-panel {
                padding: 1.2rem 1rem;
            }

            .tm-check-email-btn {
                width: 100%;
                max-width: 320px;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <main class="tm-check-email-page">
        <div class="tm-check-email-wrap">
            <section class="tm-check-email-card">
                <div class="tm-check-email-topbar">
                    <a href="{{ path('home') }}" class="tm-check-email-logo" aria-label="Accueil Trust &amp; Market">
                        <img src="{{ prerender(asset('assets/img/logo_new.svg')) }}" alt="Trust &amp; Market">
                    </a>
                    <div class="tm-check-email-heading-group">
                        <h1 class="tm-check-email-heading">CONFIRMEZ VOTRE EMAIL</h1>
                        <p class="tm-check-email-subheading">Votre compte a bien été créé.</p>
                    </div>
                </div>

                <div class="tm-check-email-steps">
                    <div class="tm-check-email-step">
                        <span class="tm-check-email-step-index">1</span>
                        <strong>Créez</strong>
                        <span>Email, mot de passe et type de profil.</span>
                    </div>
                    <div class="tm-check-email-step is-active">
                        <span class="tm-check-email-step-index">2</span>
                        <strong>Confirmez</strong>
                        <span>Validation du compte par email.</span>
                    </div>
                    <div class="tm-check-email-step is-upcoming">
                        <span class="tm-check-email-step-index">3</span>
                        <strong>Complétez</strong>
                        <span>Complétez ensuite votre profil.</span>
                    </div>
                </div>

                <div class="tm-check-email-panel">
                    <h2>Vérifiez votre boîte mail</h2>
                    <p>Nous vous avons envoyé un lien d’activation pour confirmer votre adresse email et accéder à la dernière étape de votre profil.</p>
                    {% if pending_email %}
                        <div class="tm-check-email-address">{{ pending_email }}</div>
                    {% endif %}
                    <p class="tm-check-email-help">Pensez aussi à vérifier vos courriers indésirables si vous ne voyez pas l’email dans les prochaines minutes.</p>

                    <div class="tm-check-email-actions">
                        <a href="{{ path('home') }}" class="tm-check-email-btn tm-check-email-btn-primary">J’AI COMPRIS</a>
                        <a href="{{ path('app_login') }}" class="tm-check-email-btn tm-check-email-btn-secondary">SE CONNECTER</a>
                    </div>
                </div>

                <div class="tm-check-email-footer">
                    <a href="{{ path('home') }}">&larr;&nbsp;<span>Accueil</span></a>
                </div>
            </section>
        </div>
    </main>
{% endblock %}
