{% extends 'base.html.twig' %}

{% block title %}Trust & Market | Confirmation email{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        html,
        body {
            height: 100%;
            margin: 0;
            padding: 0;
        }

        body {
            background: #f2eee9;
            background-image: none !important;
        }

        .tm-check-email-page,
        .tm-check-email-wrap,
        .tm-check-email-visual,
        .tm-check-email-panel,
        .tm-check-email-panel-content {
            box-sizing: border-box;
        }

        .tm-check-email-page {
            height: 100vh;
            height: 100dvh;
            min-height: 100vh;
            min-height: 100dvh;
            width: 100%;
            font-family: "Palanquin", sans-serif;
            color: #212529;
        }

        .tm-check-email-wrap {
            width: 100%;
            height: 100vh;
            height: 100dvh;
            min-height: 100vh;
            min-height: 100dvh;
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            background: #fff;
            overflow: hidden;
        }

        .tm-check-email-visual {
            position: relative;
            height: 100vh;
            height: 100dvh;
            min-height: 100vh;
            min-height: 100dvh;
            padding: clamp(24px, 4.2vmin, 64px);
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
            color: #fff;
            background-image:
                linear-gradient(180deg, rgba(14, 10, 8, 0.28) 0%, rgba(14, 10, 8, 0.68) 100%),
                var(--tm-check-email-visual-image);
            background-size: cover;
            background-position: center;
            isolation: isolate;
        }

        .tm-check-email-visual::after {
            content: "";
            position: absolute;
            inset: 0;
            background:
                linear-gradient(rgba(255,255,255,0.06) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,0.06) 1px, transparent 1px);
            background-size: 72px 72px;
            opacity: .18;
            pointer-events: none;
            z-index: 0;
        }

        .tm-check-email-visual > * {
            position: relative;
            z-index: 1;
        }

        .tm-check-email-visual-copy {
            max-width: clamp(320px, 30vw, 540px);
            text-shadow: 0 1px 16px rgba(0, 0, 0, .34);
        }

        .tm-check-email-visual-copy strong {
            display: block;
            margin-bottom: clamp(8px, 1.2vh, 16px);
            font-family: "Palanquin Dark", sans-serif;
            font-size: clamp(2rem, 5.2vmin, 3.6rem);
            line-height: .95;
            font-weight: 700;
        }

        .tm-check-email-visual-copy span {
            display: block;
            max-width: clamp(280px, 26vw, 440px);
            color: rgba(255, 255, 255, .82);
            font-size: clamp(.86rem, 1.05vw, 1.12rem);
            line-height: 1.35;
        }

        .tm-check-email-panel {
            max-width: none;
            margin: 0;
            height: 100vh;
            height: 100dvh;
            min-height: 100vh;
            min-height: 100dvh;
            padding: clamp(16px, 4vh, 52px) clamp(28px, 5vw, 92px);
            border: 0;
            border-radius: 0;
            background: #fff;
            box-shadow: none;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            overflow-y: auto;
            overscroll-behavior: contain;
            scrollbar-gutter: stable;
        }

        .tm-check-email-panel-content {
            width: clamp(360px, 31vw, 520px);
            max-width: 100%;
            margin: auto;
        }

        .tm-check-email-topbar {
            margin-bottom: clamp(10px, 2.1vh, 24px);
            min-height: 0;
        }

        .tm-check-email-heading {
            margin: 0;
            color: #212529;
            font-size: clamp(1.55rem, 2.25vw, 2.3rem);
            line-height: 1.05;
            font-family: "Palanquin Dark", sans-serif;
            font-weight: 700;
            text-align: left;
            text-transform: none;
            letter-spacing: 0;
        }

        .tm-check-email-subheading {
            margin-top: clamp(3px, .7vh, 8px);
            color: #424242;
            font-size: clamp(.86rem, 1vw, 1.06rem);
            line-height: 1.35;
            text-align: left;
        }

        .tm-register-steps {
            margin: 0 0 clamp(12px, 2.4vh, 28px);
            padding: 0;
            display: flex;
            align-items: center;
            gap: clamp(5px, .7vw, 10px);
            border: 0;
            border-radius: 0;
            background: transparent;
            box-shadow: none;
            backdrop-filter: none;
        }

        .tm-step-pill {
            min-height: 0;
            display: flex;
            flex-direction: row;
            align-items: center;
            gap: clamp(4px, .55vw, 8px);
            color: #888;
            white-space: nowrap;
        }

        .tm-step-pill.is-upcoming {
            color: #777;
        }

        .tm-step-pill:not(:last-child)::after {
            content: "";
            width: clamp(18px, 3.1vw, 34px);
            height: 1px;
            margin-left: 4px;
            background: #cfc8c1;
        }

        .tm-step-pill-index {
            width: clamp(18px, 1.55vw, 22px);
            height: clamp(18px, 1.55vw, 22px);
            margin-bottom: 0;
            background: #fff;
            border: 1px solid #bfb8b1;
            border-radius: 50%;
            color: #69625c;
            font-size: clamp(.66rem, .7vw, .78rem);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
        }

        .tm-step-pill.is-active .tm-step-pill-index {
            background: #111;
            border-color: #111;
            color: #fff;
        }

        .tm-step-pill.is-passed .tm-step-pill-index {
            background: #ff7e10;
            border-color: #ff7e10;
            color: #fff;
        }

        .tm-step-pill strong {
            font-size: clamp(.74rem, .82vw, .88rem);
            letter-spacing: 0;
            text-transform: none;
            font-family: "Palanquin Dark", sans-serif;
            font-weight: 700;
        }

        .tm-step-pill strong + span {
            display: none;
        }

        .tm-check-email-content {
            margin-top: clamp(14px, 2.6vh, 30px);
        }

        .tm-check-email-alert {
            margin: 0 0 14px;
            padding: .95rem 1rem;
            border-radius: 12px;
            background: #fff4f4;
            border: 1px solid rgba(193, 61, 61, 0.22);
            color: #b43737;
            font-size: .88rem;
            line-height: 1.5;
            text-align: left;
        }

        .tm-check-email-message {
            margin: 0;
            color: #212529;
            line-height: 1.45;
            font-size: clamp(.86rem, .95vw, 1rem);
            font-family: "Palanquin", sans-serif;
        }

        .tm-check-email-status {
            margin-top: clamp(14px, 2vh, 20px);
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: clamp(12px, 1.8vh, 18px) clamp(14px, 1.6vw, 22px);
            border: 1px solid rgba(255, 126, 16, .28);
            border-radius: 26px;
            background: #fff;
            box-shadow: 0 10px 28px rgba(255, 126, 16, .06);
        }

        .tm-check-email-status-icon {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            border: 1px solid rgba(255, 126, 16, .62);
            color: #ff7e10;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 auto;
            margin-top: 2px;
            font-size: .72rem;
        }

        .tm-check-email-status-text {
            margin: 0;
            color: #212529;
            line-height: 1.38;
            font-size: clamp(.86rem, .95vw, 1rem);
        }

        .tm-check-email-profile-title {
            margin: clamp(16px, 2.1vh, 24px) 0 clamp(8px, 1.2vh, 12px);
            color: #212529;
            font-size: clamp(.82rem, .9vw, .96rem);
            line-height: 1.25;
            font-family: "Palanquin Dark", sans-serif;
            font-weight: 700;
        }

        .tm-check-email-profile-card {
            gap: clamp(8px, .8vw, 12px);
            padding: clamp(13px, 1.9vh, 20px) clamp(18px, 1.8vw, 28px);
            border: 2px solid rgba(255, 126, 16, .28);
            border-radius: 26px;
            background: #fff;
            box-shadow: 0 10px 28px rgba(255, 126, 16, .06);
        }

        .tm-check-email-profile-copy strong {
            display: block;
            margin-bottom: clamp(4px, .7vh, 8px);
            font-size: clamp(1rem, 1.08vw, 1.18rem);
            line-height: 1.12;
            color: #121212;
            font-family: "Palanquin Dark", sans-serif;
            font-weight: 700;
        }

        .tm-check-email-profile-copy span {
            display: block;
            color: #333;
            font-size: clamp(.86rem, .95vw, 1rem);
            line-height: 1.38;
            font-family: "Palanquin", sans-serif;
        }

        .tm-check-email-actions {
            margin-top: clamp(18px, 2.5vh, 28px);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: clamp(6px, 1vh, 10px);
        }

        .tm-check-email-btn-primary {
            width: 100%;
            max-width: 100%;
            min-width: 0;
            min-height: clamp(38px, 5vh, 50px);
            border-radius: 14px;
            background: #fff;
            border: 1px solid #111;
            color: #111;
            font-family: "Palanquin Dark", sans-serif;
            font-weight: 700;
            font-size: clamp(.82rem, .9vw, .98rem);
            box-shadow: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            padding: clamp(8px, 1vh, 10px) clamp(18px, 2vw, 28px);
            transition: background .2s ease, border-color .2s ease, color .2s ease;
        }

        .tm-check-email-btn-primary:hover,
        .tm-check-email-btn-primary:focus {
            background: #ff7e10;
            border-color: #ff7e10;
            color: #fff;
            text-decoration: none;
        }

        .tm-login-note {
            color: #212529;
            font-size: clamp(.74rem, .8vw, .86rem);
            text-align: center;
            margin: 0;
            font-family: "Roboto", sans-serif;
        }

        .tm-login-note a {
            color: #212529;
            text-decoration: underline;
        }

        .tm-note-link {
            color: #212529;
            text-decoration: underline;
        }

        .tm-note-link-prefix {
            text-decoration: none;
        }

        @media (min-width: 992px) {
            html,
            body {
                overflow: hidden;
            }
        }

        @media (max-width: 991px) {
            html,
            body,
            .tm-check-email-page,
            .tm-check-email-wrap,
            .tm-check-email-visual,
            .tm-check-email-panel {
                height: auto;
            }

            html,
            body {
                overflow: auto;
                margin: 0;
                padding: 0;
                overflow-x: hidden;
            }

            .tm-check-email-wrap {
                grid-template-columns: 1fr;
                max-width: none;
                min-height: 100vh;
                min-height: 100dvh;
                margin: 0;
                overflow: visible;
            }

            .tm-check-email-visual {
                min-height: clamp(260px, 42vh, 420px);
                padding: 28px;
            }

            .tm-check-email-panel {
                min-height: auto;
                padding: 28px 20px 30px;
                justify-content: flex-start;
                overflow: visible;
            }

            .tm-check-email-panel-content {
                width: min(460px, 100%);
                margin: auto;
            }

            .tm-register-steps {
                gap: 6px;
                overflow-x: auto;
                padding-bottom: 4px;
            }

            .tm-step-pill:not(:last-child)::after {
                width: 18px;
            }
        }

        @media (max-width: 520px) {
            .tm-check-email-visual {
                min-height: 240px;
                padding: 22px;
            }

            .tm-check-email-visual-copy strong {
                font-size: 1.8rem;
            }

            .tm-check-email-visual-copy span {
                font-size: .9rem;
            }

            .tm-check-email-panel {
                padding: 24px 16px 28px;
            }

            .tm-check-email-heading {
                font-size: 1.55rem;
            }
        }
    </style>
{% endblock %}

{% block body %}
    {% set checkEmailVisualImage = include('Seo/Meta/security_image.html.twig', {code: 'verifier_email_creation_compte_image'})|trim %}
    {% set checkEmailVisualBackground = checkEmailVisualImage ?: absolute_url(asset('assets/img/john-raptis.png')) %}

    <main class="tm-check-email-page">
        <div class="tm-check-email-wrap">
            <section class="tm-check-email-visual" style="--tm-check-email-visual-image: url('{{ checkEmailVisualBackground|e('css') }}');" aria-label="Trust &amp; Market">
                <div class="tm-check-email-visual-copy">
                    <strong>La plateforme de la production musicale.</strong>
                    <span>Studios, musiciens, producteurs : trouvez le bon partenaire pour votre projet.</span>
                </div>
            </section>

            <section class="tm-check-email-panel">
                <div class="tm-check-email-panel-content">
                    <div class="tm-check-email-topbar">
                        <h1 class="tm-check-email-heading">Confirmez votre email</h1>
                        <p class="tm-check-email-subheading">Votre compte a bien &eacute;t&eacute; cr&eacute;&eacute;.</p>
                    </div>

                    <div class="tm-register-steps">
                        <div class="tm-step-pill is-passed">
                            <span class="tm-step-pill-index">1</span>
                            <strong>Choisir</strong>
                            <span>Choix du type de profil.</span>
                        </div>
                        <div class="tm-step-pill is-passed">
                            <span class="tm-step-pill-index">2</span>
                            <strong>Cr&eacute;er</strong>
                            <span>Email, mot de passe et validation.</span>
                        </div>
                        <div class="tm-step-pill is-active">
                            <span class="tm-step-pill-index">3</span>
                            <strong>Confirmer</strong>
                            <span>Validation du compte par email.</span>
                        </div>
                        <div class="tm-step-pill is-upcoming">
                            <span class="tm-step-pill-index">4</span>
                            <strong>Compl&eacute;ter</strong>
                            <span>Compl&eacute;tez ensuite votre profil.</span>
                        </div>
                    </div>

                    <div class="tm-check-email-content">
                        {% for message in app.session.flashbag.get('register_email_error') %}
                            <div class="tm-check-email-alert">
                                L'email d'activation n'a pas pu &ecirc;tre envoy&eacute; automatiquement. {{ message }}
                            </div>
                        {% endfor %}

                        <p class="tm-check-email-message">
                            Vous pouvez d&egrave;s &agrave; pr&eacute;sent d&eacute;couvrir votre profil. Vous avez re&ccedil;u un lien pour v&eacute;rifier votre adresse email{% if pending_email %}, {{ pending_email }}{% endif %}, et activer toutes le fonctionnalit&eacute;s de votre profil.
                        </p>

                        <div class="tm-check-email-status">
                            <span class="tm-check-email-status-icon"><i class="fa fa-plus-circle" aria-hidden="true"></i></span>
                            <p class="tm-check-email-status-text">Votre email n'est pas encore v&eacute;rifi&eacute;.</p>
                        </div>

                        <p class="tm-check-email-profile-title">Je me suis inscrit en tant que :</p>

                        <div class="tm-check-email-profile-card">
                            <div class="tm-check-email-profile-copy">
                                <strong>{{ role_card.title }}</strong>
                                <span>{{ role_card.description }}</span>
                            </div>
                        </div>

                        <div class="tm-check-email-actions">
                            <a href="{{ path('app_registration_complete_profile') }}" class="tm-check-email-btn-primary">Compl&eacute;ter mon profil</a>
                            <p class="tm-login-note"><span class="tm-note-link-prefix" aria-hidden="true">&larr; </span><a href="{{ path('home') }}" class="tm-note-link">Accueil</a> <span aria-hidden="true">|</span> <a href="{{ path('app_login') }}">Se connecter</a></p>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </main>
{% endblock %}
