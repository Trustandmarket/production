{% extends 'base.html.twig' %}

{% block title %}Trust & Market | Compléter mon profil{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        body {
            background: #f5f5f5 !important;
            background-image: none !important;
        }

        .tm-complete-page {
            min-height: 100vh;
            padding: 500px 18px 104px;
            background: #f5f5f5;
            font-family: "Roboto", sans-serif;
            color: #212529;
            width: 100%;
            box-sizing: border-box;
        }

        .tm-complete-wrap {
            width: 100%;
            max-width: 920px;
            margin: 0 auto;
        }

        .tm-complete-card {
            position: relative;
            width: 100%;
            max-width: 920px;
            margin: 0 auto;
            padding: 1.2rem 1.15rem 1.8rem;
            border-radius: 32px;
            background:
                radial-gradient(circle at top left, rgba(241, 124, 48, 0.14), transparent 22%),
                radial-gradient(circle at bottom right, rgba(16, 16, 16, 0.04), transparent 26%),
                linear-gradient(135deg, #fff9f4 0%, #ffffff 46%, #f6f7f9 100%);
            border: 1px solid rgba(241, 124, 48, 0.18);
            box-shadow: 0 24px 60px rgba(26, 26, 26, 0.10);
            overflow: hidden;
        }

        .tm-complete-topbar {
            position: relative;
            min-height: 56px;
            margin-bottom: clamp(1.1rem, 2vh, 1.45rem);
        }

        .tm-complete-logo {
            position: absolute;
            top: 0;
            left: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .tm-complete-logo img {
            width: 46px;
            height: 46px;
            object-fit: contain;
        }

        .tm-complete-heading-group {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding-top: 52px;
        }

        .tm-complete-heading {
            margin: 0;
            color: #212529;
            font-size: clamp(1.72rem, 2.8vh, 2rem);
            line-height: 1.1;
            font-family: "Palanquin Dark", sans-serif;
            font-weight: 700;
            text-transform: uppercase;
            text-align: center;
        }

        .tm-complete-subheading {
            margin: 10px 0 0 0;
            color: #212529;
            font-size: clamp(.95rem, 1.35vh, 1.05rem);
            line-height: 1.5;
            text-align: center;
        }

        .tm-complete-steps {
            margin-bottom: 22px;
            padding: 1rem 1.1rem;
            border-radius: 26px;
            background: linear-gradient(180deg, rgba(255,255,255,0.98) 0%, rgba(255,255,255,0.92) 100%);
            border: 1px solid rgba(18, 18, 18, 0.07);
            box-shadow: 0 16px 36px rgba(17, 17, 17, 0.07);
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: .8rem;
            backdrop-filter: blur(6px);
        }

        .tm-complete-step {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            min-height: 82px;
            gap: .3rem;
            color: #212529;
        }

        .tm-complete-step.is-upcoming {
            opacity: .72;
        }

        .tm-complete-step-index {
            display: inline-flex;
            width: 24px;
            height: 24px;
            align-items: center;
            justify-content: center;
            border-radius: 999px;
            background: rgba(17, 17, 17, 0.10);
            color: #fff;
            font-size: .68rem;
            font-weight: 600;
        }

        .tm-complete-step.is-active .tm-complete-step-index {
            background: linear-gradient(90deg, #f17c30 0%, #ffb787 100%);
        }

        .tm-complete-step strong {
            display: block;
            font-size: .98rem;
            font-family: "Palanquin Dark", sans-serif;
            font-weight: 700;
            letter-spacing: .16em;
            text-transform: uppercase;
        }

        .tm-complete-step span {
            display: block;
            font-size: .86rem;
            line-height: 1.3;
        }

        .tm-complete-panel {
            width: 100%;
            max-width: 680px;
            margin: 30px auto 0;
            text-align: center;
        }

        .tm-complete-intro {
            max-width: 580px;
            margin: 0 auto 1.3rem;
            text-align: left;
            font-size: .98rem;
            line-height: 1.7;
        }

        .tm-complete-profile-title {
            margin: 0 auto .95rem;
            max-width: 580px;
            text-align: left;
            font-size: .98rem;
            line-height: 1.4;
            color: #212529;
            font-weight: 700;
        }

        .tm-complete-profile-card {
            width: 100%;
            max-width: 580px;
            margin: 0 auto 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 1.05rem 1.15rem;
            border-radius: 22px;
            background: rgba(255,255,255,0.98);
            border: 1px solid rgba(18, 18, 18, 0.08);
            box-shadow: 0 14px 30px rgba(17, 17, 17, 0.06);
            text-align: left;
        }

        .tm-complete-profile-copy strong {
            display: block;
            margin-bottom: .3rem;
            font-size: .98rem;
            line-height: 1.3;
            color: #212529;
            font-family: "Palanquin Dark", sans-serif;
            font-weight: 700;
        }

        .tm-complete-profile-copy span {
            display: block;
            font-size: .95rem;
            line-height: 1.5;
            color: #212529;
            opacity: .82;
        }

        .tm-complete-profile-arrow {
            color: #c4b49f;
            font-size: 1.35rem;
            line-height: 1;
            flex: 0 0 auto;
        }

        .tm-complete-form {
            width: 100%;
            max-width: 580px;
            margin: 0 auto;
            text-align: left;
        }

        .tm-complete-field + .tm-complete-field {
            margin-top: 18px;
        }

        .tm-complete-field label {
            display: block;
            margin: 0 0 6px;
            color: #212529;
            font-size: .98rem;
            font-weight: 600;
            font-family: "Palanquin Dark", sans-serif;
        }

        .tm-complete-input,
        .tm-complete-select {
            width: 100%;
            min-height: 42px;
            padding: .75rem .95rem;
            border-radius: 16px;
            border: 1px solid rgba(18, 18, 18, 0.10);
            background: #fff;
            color: #212529;
            font-size: .98rem;
            font-family: "Roboto", sans-serif;
            box-shadow: 0 6px 16px rgba(17, 17, 17, 0.03);
        }

        .tm-complete-input:focus,
        .tm-complete-select:focus {
            outline: none;
            border-color: rgba(241, 124, 48, 0.55);
            box-shadow: 0 0 0 3px rgba(241, 124, 48, 0.10);
        }

        .tm-complete-select-wrap {
            position: relative;
        }

        .tm-complete-select {
            appearance: none;
            -webkit-appearance: none;
            padding-right: 3.25rem;
            background:
                linear-gradient(180deg, rgba(255,255,255,0.98) 0%, rgba(255,249,244,0.92) 100%);
            cursor: pointer;
        }

        .tm-complete-select-wrap::after {
            content: "";
            position: absolute;
            top: 50%;
            right: 1.1rem;
            width: 10px;
            height: 10px;
            border-right: 2px solid #b49a78;
            border-bottom: 2px solid #b49a78;
            transform: translateY(-60%) rotate(45deg);
            pointer-events: none;
        }

        .tm-complete-select option {
            color: #212529;
            background: #ffffff;
        }

        .tm-complete-actions {
            margin-top: 1.9rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1.05rem;
        }

        .tm-complete-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 336px;
            min-height: 50px;
            padding: .85rem 2.5rem;
            border-radius: 16px;
            border: 1px solid transparent;
            text-decoration: none;
            font-family: "Palanquin Dark", sans-serif;
            font-size: .98rem;
            font-weight: 700;
        }

        .tm-complete-btn-primary {
            background: #111111;
            color: #ffffff;
            border-color: #111111;
            box-shadow: 0 10px 22px rgba(17, 17, 17, 0.10);
        }

        .tm-complete-btn-secondary {
            background: transparent;
            color: #212529;
            border-color: transparent;
            min-height: auto;
            padding: 0;
            min-width: 0;
            font-family: "Roboto", sans-serif;
            font-weight: 400;
            box-shadow: none;
        }

        .tm-complete-footer {
            margin-top: 18px;
            display: flex;
            justify-content: flex-start;
            font-size: .96rem;
        }

        .tm-complete-footer a {
            color: #212529;
            text-decoration: none;
        }

        @media (max-width: 991px) {
            .tm-complete-page {
                padding: 840px 18px 64px;
            }

            .tm-complete-card {
                border-radius: 24px;
                padding: 20px 16px 24px;
            }

            .tm-complete-topbar {
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 14px;
                min-height: auto;
            }

            .tm-complete-logo {
                position: static;
                margin: 0 auto .5rem;
            }

            .tm-complete-heading-group {
                width: 100%;
                padding-top: 0;
            }

            .tm-complete-steps {
                grid-template-columns: 1fr;
                gap: 12px;
            }

            .tm-complete-step {
                min-height: auto;
            }

            .tm-complete-intro,
            .tm-complete-profile-title {
                max-width: 100%;
            }

            .tm-complete-profile-card,
            .tm-complete-form {
                max-width: 100%;
            }

            .tm-complete-btn {
                width: 100%;
                max-width: 320px;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <main class="tm-complete-page">
        <div class="tm-complete-wrap">
            <section class="tm-complete-card">
                <div class="tm-complete-topbar">
                    <a href="{{ path('home') }}" class="tm-complete-logo" aria-label="Accueil Trust &amp; Market">
                        <img src="{{ prerender(asset('assets/img/logo_new.svg')) }}" alt="Trust &amp; Market">
                    </a>
                    <div class="tm-complete-heading-group">
                        <h1 class="tm-complete-heading">COMPLÉTEZ MON PROFIL</h1>
                        <p class="tm-complete-subheading">Quelques informations suffisent pour terminer votre parcours.</p>
                    </div>
                </div>

                <div class="tm-complete-steps">
                    <div class="tm-complete-step">
                        <span class="tm-complete-step-index">1</span>
                        <strong>Créez</strong>
                        <span>Email, mot de passe et type de profil.</span>
                    </div>
                    <div class="tm-complete-step">
                        <span class="tm-complete-step-index">2</span>
                        <strong>Confirmez</strong>
                        <span>Validation du compte par email.</span>
                    </div>
                    <div class="tm-complete-step is-active">
                        <span class="tm-complete-step-index">3</span>
                        <strong>Complétez</strong>
                        <span>Complétez ensuite votre profil.</span>
                    </div>
                </div>

                <div class="tm-complete-panel">
                    <p class="tm-complete-intro">Renseignez les informations essentielles pour finaliser votre profil et poursuivre votre parcours sur Trust &amp; Market.</p>

                    <p class="tm-complete-profile-title">Je complète mon profil en tant que :</p>

                    <div class="tm-complete-profile-card">
                        <div class="tm-complete-profile-copy">
                            <strong>{{ role_card.title }}</strong>
                            <span>{{ role_card.description }}</span>
                        </div>
                        <span class="tm-complete-profile-arrow" aria-hidden="true">&rsaquo;</span>
                    </div>

                    <form class="tm-complete-form" action="#" method="post">
                        <div class="tm-complete-field">
                            <label for="complete_first_name">Prénom</label>
                            <input id="complete_first_name" class="tm-complete-input" type="text" name="first_name" placeholder="Votre prénom">
                        </div>

                        <div class="tm-complete-field">
                            <label for="complete_last_name">Nom</label>
                            <input id="complete_last_name" class="tm-complete-input" type="text" name="last_name" placeholder="Votre nom">
                        </div>

                        <div class="tm-complete-field">
                            <label for="complete_residence">Pays de résidence</label>
                            <div class="tm-complete-select-wrap">
                                <select id="complete_residence" class="tm-complete-select" name="residence">
                                    <option value="">Sélectionnez votre pays de résidence</option>
                                    {% include 'countryRegister.html.twig' %}
                                </select>
                            </div>
                        </div>

                        {% if role_card.is_professional %}
                            <div class="tm-complete-field">
                                <label for="complete_activity">Activité principale</label>
                                <div class="tm-complete-select-wrap">
                                    <select id="complete_activity" class="tm-complete-select" name="activite">
                                        <option value="">Sélectionnez votre activité principale</option>
                                        {% for item in activities %}
                                            <option value="{{ item.termId }}">
                                                {% if app.request.locale == 'en' %}{{ item.content }}{% else %}{{ item.name }}{% endif %}
                                            </option>
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>
                        {% endif %}

                        <div class="tm-complete-actions">
                            <button class="tm-complete-btn tm-complete-btn-primary" type="submit">ENREGISTRER MON PROFIL</button>
                            <a href="{{ path('home') }}" class="tm-complete-btn tm-complete-btn-secondary">Plus tard</a>
                        </div>
                    </form>
                </div>

                <div class="tm-complete-footer">
                    <a href="{{ path('home') }}">&larr;&nbsp;<span>Accueil</span></a>
                </div>
            </section>
        </div>
    </main>
{% endblock %}
