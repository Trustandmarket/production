{% extends 'base.html.twig' %}

{% block title %}Trust & Market | Compl&eacute;ter mon profil{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        html,
        body {
            height: 100%;
            margin: 0;
            padding: 0;
        }

        body {
            background: #f2eee9;
            background-image: none !important;
        }

        .tm-complete-page,
        .tm-complete-wrap,
        .tm-complete-visual,
        .tm-complete-panel,
        .tm-complete-panel-content {
            box-sizing: border-box;
        }

        .tm-complete-page {
            height: 100vh;
            height: 100dvh;
            min-height: 100vh;
            min-height: 100dvh;
            width: 100%;
            font-family: "Palanquin", sans-serif;
            color: #212529;
        }

        .tm-complete-wrap {
            width: 100%;
            height: 100vh;
            height: 100dvh;
            min-height: 100vh;
            min-height: 100dvh;
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            background: #fff;
            overflow: hidden;
        }

        .tm-complete-visual {
            position: relative;
            height: 100vh;
            height: 100dvh;
            min-height: 100vh;
            min-height: 100dvh;
            padding: clamp(24px, 4.2vmin, 64px);
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
            color: #fff;
            background-image:
                linear-gradient(180deg, rgba(14, 10, 8, 0.28) 0%, rgba(14, 10, 8, 0.68) 100%),
                var(--tm-complete-visual-image);
            background-size: cover;
            background-position: center;
            isolation: isolate;
        }

        .tm-complete-visual::after {
            content: "";
            position: absolute;
            inset: 0;
            background:
                linear-gradient(rgba(255,255,255,0.06) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,0.06) 1px, transparent 1px);
            background-size: 72px 72px;
            opacity: .18;
            pointer-events: none;
            z-index: 0;
        }

        .tm-complete-visual > * {
            position: relative;
            z-index: 1;
        }

        .tm-complete-visual-copy {
            max-width: clamp(320px, 30vw, 540px);
            text-shadow: 0 1px 16px rgba(0, 0, 0, .34);
        }

        .tm-complete-visual-copy strong {
            display: block;
            margin-bottom: clamp(8px, 1.2vh, 16px);
            font-family: "Palanquin Dark", sans-serif;
            font-size: clamp(2rem, 5.2vmin, 3.6rem);
            line-height: .95;
            font-weight: 700;
        }

        .tm-complete-visual-copy span {
            display: block;
            max-width: clamp(280px, 26vw, 440px);
            color: rgba(255, 255, 255, .82);
            font-size: clamp(.86rem, 1.05vw, 1.12rem);
            line-height: 1.35;
        }

        .tm-complete-panel {
            max-width: none;
            margin: 0;
            height: 100vh;
            height: 100dvh;
            min-height: 100vh;
            min-height: 100dvh;
            padding: clamp(16px, 4vh, 52px) clamp(28px, 5vw, 92px);
            border: 0;
            border-radius: 0;
            background: #fff;
            box-shadow: none;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            overflow-y: auto;
            overscroll-behavior: contain;
            scrollbar-gutter: stable;
        }

        .tm-complete-panel-content {
            width: clamp(360px, 31vw, 520px);
            max-width: 100%;
            margin: auto;
        }

        .tm-complete-topbar {
            margin-bottom: clamp(10px, 2.1vh, 24px);
            min-height: 0;
        }

        .tm-complete-heading {
            margin: 0;
            color: #212529;
            font-size: clamp(1.55rem, 2.25vw, 2.3rem);
            line-height: 1.05;
            font-family: "Palanquin Dark", sans-serif;
            font-weight: 700;
            text-align: left;
            text-transform: none;
            letter-spacing: 0;
        }

        .tm-complete-subheading {
            margin-top: clamp(3px, .7vh, 8px);
            color: #424242;
            font-size: clamp(.86rem, 1vw, 1.06rem);
            line-height: 1.35;
            text-align: left;
        }

        .tm-register-steps {
            margin: 0 0 clamp(12px, 2.4vh, 28px);
            padding: 0;
            display: flex;
            align-items: center;
            gap: clamp(5px, .7vw, 10px);
            border: 0;
            border-radius: 0;
            background: transparent;
            box-shadow: none;
            backdrop-filter: none;
        }

        .tm-step-pill {
            min-height: 0;
            display: flex;
            flex-direction: row;
            align-items: center;
            gap: clamp(4px, .55vw, 8px);
            color: #888;
            white-space: nowrap;
        }

        .tm-step-pill.is-upcoming {
            color: #777;
        }

        .tm-step-pill:not(:last-child)::after {
            content: "";
            width: clamp(18px, 3.1vw, 34px);
            height: 1px;
            margin-left: 4px;
            background: #cfc8c1;
        }

        .tm-step-pill-index {
            width: clamp(18px, 1.55vw, 22px);
            height: clamp(18px, 1.55vw, 22px);
            margin-bottom: 0;
            background: #fff;
            border: 1px solid #bfb8b1;
            border-radius: 50%;
            color: #69625c;
            font-size: clamp(.66rem, .7vw, .78rem);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
        }

        .tm-step-pill.is-active .tm-step-pill-index {
            background: #111;
            border-color: #111;
            color: #fff;
        }

        .tm-step-pill.is-passed .tm-step-pill-index {
            background: #ff7e10;
            border-color: #ff7e10;
            color: #fff;
        }

        .tm-step-pill strong {
            font-size: clamp(.74rem, .82vw, .88rem);
            letter-spacing: 0;
            text-transform: none;
            font-family: "Palanquin Dark", sans-serif;
            font-weight: 700;
        }

        .tm-step-pill strong + span {
            display: none;
        }

        .tm-complete-content {
            margin-top: clamp(14px, 2.6vh, 30px);
        }

        .tm-complete-intro {
            margin: 0;
            color: #212529;
            line-height: 1.45;
            font-size: clamp(.86rem, .95vw, 1rem);
            font-family: "Palanquin", sans-serif;
        }

        .tm-complete-profile-title {
            margin: clamp(16px, 2.1vh, 24px) 0 clamp(8px, 1.2vh, 12px);
            color: #212529;
            font-size: clamp(.82rem, .9vw, .96rem);
            line-height: 1.25;
            font-family: "Palanquin Dark", sans-serif;
            font-weight: 700;
        }

        .tm-complete-profile-card {
            gap: clamp(8px, .8vw, 12px);
            padding: clamp(13px, 1.9vh, 20px) clamp(18px, 1.8vw, 28px);
            border: 2px solid rgba(255, 126, 16, .28);
            border-radius: 26px;
            background: #fff;
            box-shadow: 0 10px 28px rgba(255, 126, 16, .06);
            margin-bottom: clamp(14px, 2vh, 20px);
        }

        .tm-complete-profile-copy strong {
            display: block;
            margin-bottom: clamp(4px, .7vh, 8px);
            font-size: clamp(1rem, 1.08vw, 1.18rem);
            line-height: 1.12;
            color: #121212;
            font-family: "Palanquin Dark", sans-serif;
            font-weight: 700;
        }

        .tm-complete-profile-copy span {
            display: block;
            color: #333;
            font-size: clamp(.86rem, .95vw, 1rem);
            line-height: 1.38;
            font-family: "Palanquin", sans-serif;
        }

        .tm-complete-flashes {
            width: 100%;
            margin: 0 0 clamp(10px, 1.5vh, 14px);
            display: flex;
            flex-direction: column;
            gap: .6rem;
        }

        .tm-complete-flash {
            padding: .85rem .95rem;
            border-radius: 12px;
            border: 1px solid rgba(18, 18, 18, 0.08);
            background: rgba(255,255,255,0.96);
            color: #212529;
            font-size: .86rem;
            line-height: 1.45;
        }

        .tm-complete-flash.is-success {
            border-color: rgba(25, 135, 84, 0.22);
            background: rgba(25, 135, 84, 0.08);
        }

        .tm-complete-flash.is-error {
            border-color: rgba(220, 53, 69, 0.22);
            background: rgba(220, 53, 69, 0.08);
        }

        .tm-complete-form {
            width: 100%;
            margin: 0;
            text-align: left;
        }

        .tm-complete-field + .tm-complete-field {
            margin-top: clamp(10px, 1.5vh, 16px);
        }

        .tm-complete-field label {
            display: block;
            margin: 0 0 clamp(3px, .5vh, 5px);
            color: #212529;
            font-size: clamp(.82rem, .9vw, .96rem);
            font-weight: 600;
            line-height: 1.25;
            font-family: "Palanquin Dark", sans-serif;
        }

        .tm-complete-required {
            color: #ff7e10;
            font-size: .9em;
        }

        .tm-complete-input,
        .tm-complete-select {
            width: 100%;
            min-height: clamp(34px, 4.55vh, 46px);
            border-radius: 5px;
            border: 1px solid #cfc8c1;
            background: #fff;
            color: #212529;
            box-shadow: none;
            padding: clamp(6px, .9vh, 9px) clamp(9px, 1vw, 12px);
            font-size: clamp(.86rem, .92vw, 1rem);
            font-family: "Palanquin", sans-serif;
        }

        .tm-complete-input:focus,
        .tm-complete-select:focus {
            outline: none;
            border-color: #111;
            box-shadow: 0 0 0 3px rgba(241, 124, 48, .14);
        }

        .tm-complete-select-wrap {
            position: relative;
        }

        .tm-complete-select {
            appearance: none;
            -webkit-appearance: none;
            padding-right: 2.4rem;
            cursor: pointer;
            background: #fff;
        }

        .tm-complete-select-wrap::after {
            content: "";
            position: absolute;
            top: 50%;
            right: .95rem;
            width: 8px;
            height: 8px;
            border-right: 2px solid #9a948e;
            border-bottom: 2px solid #9a948e;
            transform: translateY(-62%) rotate(45deg);
            pointer-events: none;
        }

        .tm-complete-select option {
            color: #212529;
            background: #ffffff;
        }

        .tm-complete-actions {
            margin-top: clamp(18px, 2.5vh, 28px);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: clamp(6px, 1vh, 10px);
        }

        .tm-complete-btn-primary {
            width: 100%;
            max-width: 100%;
            min-width: 0;
            min-height: clamp(38px, 5vh, 50px);
            border-radius: 14px;
            background: #fff;
            border: 1px solid #111;
            color: #111;
            font-family: "Palanquin Dark", sans-serif;
            font-weight: 700;
            font-size: clamp(.82rem, .9vw, .98rem);
            box-shadow: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            padding: clamp(8px, 1vh, 10px) clamp(18px, 2vw, 28px);
            transition: background .2s ease, border-color .2s ease, color .2s ease;
        }

        .tm-complete-btn-primary:hover,
        .tm-complete-btn-primary:focus {
            background: #ff7e10;
            border-color: #ff7e10;
            color: #fff;
            text-decoration: none;
        }

        .tm-complete-btn-primary[disabled] {
            background: #b8b8b8;
            border-color: #b8b8b8;
            color: rgba(255, 255, 255, 0.88);
            cursor: not-allowed;
        }

        .tm-complete-btn-secondary {
            color: #212529;
            text-decoration: underline;
            font-size: clamp(.74rem, .8vw, .86rem);
            font-family: "Roboto", sans-serif;
        }

        @media (min-width: 992px) {
            html,
            body {
                overflow: hidden;
            }
        }

        @media (max-width: 991px) {
            html,
            body,
            .tm-complete-page,
            .tm-complete-wrap,
            .tm-complete-visual,
            .tm-complete-panel {
                height: auto;
            }

            html,
            body {
                overflow: auto;
                margin: 0;
                padding: 0;
                overflow-x: hidden;
            }

            .tm-complete-wrap {
                grid-template-columns: 1fr;
                max-width: none;
                min-height: 100vh;
                min-height: 100dvh;
                margin: 0;
                overflow: visible;
                align-content: flex-start;
            }

            .tm-complete-visual {
                min-height: clamp(180px, 32vh, 300px);
                padding: clamp(18px, 5vw, 28px);
            }

            .tm-complete-panel {
                min-height: auto;
                padding: clamp(22px, 5vw, 30px) clamp(16px, 4.5vw, 22px) clamp(28px, 6vw, 34px);
                justify-content: flex-start;
                overflow: visible;
                align-items: stretch;
            }

            .tm-complete-panel-content {
                width: 100%;
                max-width: 520px;
                margin: 0 auto;
            }

            .tm-register-steps {
                gap: 6px;
                overflow-x: auto;
                padding-bottom: 4px;
            }

            .tm-step-pill:not(:last-child)::after {
                width: 18px;
            }

            .tm-complete-field + .tm-complete-field {
                margin-top: 12px;
            }

            .tm-complete-actions {
                margin-top: 18px;
            }
        }

        @media (max-width: 520px) {
            .tm-complete-visual {
                min-height: 180px;
                padding: 18px 16px;
            }

            .tm-complete-visual-copy strong {
                font-size: 1.8rem;
            }

            .tm-complete-visual-copy span {
                font-size: .9rem;
            }

            .tm-complete-panel {
                padding: 22px 14px 26px;
            }

            .tm-complete-heading {
                font-size: 1.55rem;
            }
        }
    </style>
{% endblock %}

{% block body %}
    {% set completeProfileVisualImage = include('Seo/Meta/security_image.html.twig', {code: 'verifier_email_creation_compte_image'})|trim %}
    {% set completeProfileVisualBackground = completeProfileVisualImage ?: absolute_url(asset('assets/img/john-raptis.png')) %}

    <main class="tm-complete-page">
        <div class="tm-complete-wrap">
            <section class="tm-complete-visual" style="--tm-complete-visual-image: url('{{ completeProfileVisualBackground|e('css') }}');" aria-label="Trust &amp; Market">
                <div class="tm-complete-visual-copy">
                    <strong>La plateforme de la production musicale.</strong>
                    <span>Studios, musiciens, producteurs : trouvez le bon partenaire pour votre projet.</span>
                </div>
            </section>

            <section class="tm-complete-panel">
                <div class="tm-complete-panel-content">
                    <div class="tm-complete-topbar">
                        <h1 class="tm-complete-heading">Compl&eacute;tez votre profil</h1>
                        <p class="tm-complete-subheading">Quelques informations suffisent pour terminer votre parcours.</p>
                    </div>

                    <div class="tm-register-steps">
                        <div class="tm-step-pill is-passed">
                            <span class="tm-step-pill-index">1</span>
                            <strong>Choisir</strong>
                            <span>Choix du type de profil.</span>
                        </div>
                        <div class="tm-step-pill is-passed">
                            <span class="tm-step-pill-index">2</span>
                            <strong>Cr&eacute;er</strong>
                            <span>Email, mot de passe et validation.</span>
                        </div>
                        <div class="tm-step-pill is-passed">
                            <span class="tm-step-pill-index">3</span>
                            <strong>Confirmer</strong>
                            <span>Validation du compte par email.</span>
                        </div>
                        <div class="tm-step-pill is-active">
                            <span class="tm-step-pill-index">4</span>
                            <strong>Compl&eacute;ter</strong>
                            <span>Compl&eacute;tez ensuite votre profil.</span>
                        </div>
                    </div>

                    <div class="tm-complete-content">
                        <p class="tm-complete-intro">Renseignez les informations essentielles pour finaliser votre profil et poursuivre votre parcours sur Trust &amp; Market.</p>

                        <p class="tm-complete-profile-title">Je compl&egrave;te mon profil en tant que :</p>

                        <div class="tm-complete-profile-card">
                            <div class="tm-complete-profile-copy">
                                <strong>{{ role_card.title }}</strong>
                                <span>{{ role_card.description }}</span>
                            </div>
                        </div>

                        {% set successMessages = app.flashes('complete_profile_success') %}
                        {% set errorMessages = app.flashes('complete_profile_error') %}

                        {% if successMessages or errorMessages %}
                            <div class="tm-complete-flashes">
                                {% for message in successMessages %}
                                    <div class="tm-complete-flash is-success">{{ message }}</div>
                                {% endfor %}
                                {% for message in errorMessages %}
                                    <div class="tm-complete-flash is-error">{{ message }}</div>
                                {% endfor %}
                            </div>
                        {% endif %}

                        <form class="tm-complete-form" action="{{ path('app_registration_complete_profile') }}" method="post">
                            <input type="hidden" name="_token" value="{{ csrf_token('complete_profile') }}">

                            <div class="tm-complete-field">
                                <label for="complete_first_name">Pr&eacute;nom <span class="tm-complete-required">*</span></label>
                                <input id="complete_first_name" class="tm-complete-input" type="text" name="first_name" placeholder="Votre pr&eacute;nom" value="{{ form_data.first_name|default('')|e('html_attr') }}" autocomplete="given-name" required>
                            </div>

                            <div class="tm-complete-field">
                                <label for="complete_last_name">Nom <span class="tm-complete-required">*</span></label>
                                <input id="complete_last_name" class="tm-complete-input" type="text" name="last_name" placeholder="Votre nom" value="{{ form_data.last_name|default('')|e('html_attr') }}" autocomplete="family-name" required>
                            </div>

                            <div class="tm-complete-field">
                                <label for="complete_residence">Pays de r&eacute;sidence <span class="tm-complete-required">*</span></label>
                                <div class="tm-complete-select-wrap">
                                    <select id="complete_residence" class="tm-complete-select" name="residence" data-selected-value="{{ form_data.residence|default('')|e('html_attr') }}" autocomplete="country-name" required>
                                        <option value="">S&eacute;lectionnez votre pays de r&eacute;sidence</option>
                                        {% include 'countryRegister.html.twig' %}
                                    </select>
                                </div>
                            </div>

                            {% if role_card.is_professional %}
                                <div class="tm-complete-field">
                                    <label for="complete_activity">Activit&eacute; principale <span class="tm-complete-required">*</span></label>
                                    <div class="tm-complete-select-wrap">
                                        <select id="complete_activity" class="tm-complete-select" name="activite" data-selected-value="{{ form_data.activite|default('')|e('html_attr') }}" required>
                                            <option value="">S&eacute;lectionnez votre activit&eacute; principale</option>
                                            {% for item in activities %}
                                                <option value="{{ item.termId }}">
                                                    {% if app.request.locale == 'en' %}{{ item.content }}{% else %}{{ item.name }}{% endif %}
                                                </option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                </div>
                            {% endif %}

                            <div class="tm-complete-actions">
                                <button id="tm-complete-submit" class="tm-complete-btn-primary" type="submit">Enregistrer mon profil</button>
                                <a href="{{ path('home') }}" class="tm-complete-btn-secondary">Plus tard</a>
                            </div>
                        </form>
                    </div>
                </div>
            </section>
        </div>
    </main>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.tm-complete-select[data-selected-value]').forEach(function (select) {
                var selectedValue = select.getAttribute('data-selected-value');

                if (selectedValue !== null && selectedValue !== '') {
                    select.value = selectedValue;
                }
            });
        });
    </script>
{% endblock %}
