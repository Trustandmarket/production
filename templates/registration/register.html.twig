{% extends 'base.html.twig' %}

{% block head %}
    {{ parent() }}
    <meta name="title" content="{{ include('Seo/Meta/title.html.twig', {code: 'creer-un-compte'}) }}">
    <meta name="description" content="{{ include('Seo/Meta/description.html.twig', {code: 'creer-un-compte'}) }}"/>
    <link rel="canonical" href="{{ absolute_url(path('app_register')) }}">
    <link rel="shortlink" href="{{ absolute_url(path('app_register')) }}">

    <meta property="og:title" content="{{ include('Seo/Meta/title.html.twig', {code: 'creer-un-compte'}) }}">
    <meta property="og:description" content="{{ include('Seo/Meta/description.html.twig', {code: 'creer-un-compte'}) }}">
    <meta property="og:image" content="{{ include('Seo/Meta/security_image.html.twig', {code: 'register_image'}) }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ absolute_url(path('app_register')) }}">

    <meta name="twitter:card" content="summary">
    <meta name="twitter:site" content="@trustandmarket">
    <meta name="twitter:title" content="{{ include('Seo/Meta/title.html.twig', {code: 'creer-un-compte'}) }}">
    <meta name="twitter:description" content="{{ include('Seo/Meta/description.html.twig', {code: 'creer-un-compte'}) }}">
    <meta name="twitter:image" content="{{ include('Seo/Meta/security_image.html.twig', {code: 'register_image'}) }}">
    <meta name="twitter:image:alt" content="{{ include('Seo/Meta/title.html.twig', {code: 'register'}) }}">

    <script type="application/ld+json">
    {
        "@context": "http://schema.org",
        "@type": "WebPage",
        "name": "{{ include('Seo/Meta/title.html.twig', {code: 'creer-un-compte'}) }}",
        "description": "{{ include('Seo/Meta/description.html.twig', {code: 'creer-un-compte'}) }}",
        "publisher": {
            "@type": "RegisterPage",
            "name": "Trust&Market"
        }
    }
    </script>

    {% if recaptcha_enabled and recaptcha_site_key %}
        <script src="https://www.google.com/recaptcha/enterprise.js?render={{ recaptcha_site_key|url_encode }}" async defer></script>
    {% endif %}
{% endblock %}

{% block title %}Trust & Market | {{ include('Seo/Meta/title.html.twig', {code: 'creer-un-compte'}) }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .tm-register-form {
            width: 100%;
            min-height: auto;
            margin: 0 auto;
            display: block;
            font-family: "Palanquin", sans-serif;
            color: #212529;
        }

        body {
            background: #f5f5f5;
        }

        #g-recaptcha-response {
            display: block !important;
            position: absolute;
            margin: -78px 0 0 0 !important;
            width: 302px !important;
            height: 55px !important;
            z-index: -999999;
            opacity: 0;
        }

        .tm-register-shell {
            min-height: 100vh;
            width: 100%;
            padding: 500px 18px 104px;
            display: flex;
            align-items: flex-start;
            justify-content: center;
            box-sizing: border-box;
        }

        .tm-register-wrap {
            width: 100%;
            max-width: 920px;
            margin: 0;
            display: flex;
            justify-content: center;
        }

        .tm-register-panel {
            position: relative;
            padding: clamp(1.2rem, 2.3vh, 1.55rem) clamp(1.15rem, 2.2vw, 1.6rem) clamp(1.3rem, 2.6vh, 1.8rem);
            border-radius: 32px;
            background:
                radial-gradient(circle at top left, rgba(241, 124, 48, 0.14), transparent 22%),
                radial-gradient(circle at bottom right, rgba(16, 16, 16, 0.04), transparent 26%),
                linear-gradient(135deg, #fff9f4 0%, #ffffff 46%, #f6f7f9 100%);
            border: 1px solid rgba(241, 124, 48, 0.18);
            box-shadow: 0 24px 60px rgba(26, 26, 26, 0.10);
            max-width: 920px;
            margin: 0;
            overflow: hidden;
        }

        .tm-register-topbar {
            position: relative;
            margin-bottom: clamp(1.1rem, 2vh, 1.45rem);
            min-height: 56px;
        }

        .tm-register-topbar-main {
            min-width: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding-top: 52px;
        }

        .tm-register-heading {
            display: block;
            margin: 0;
            color: #212529;
            font-size: clamp(1.72rem, 2.8vh, 2rem);
            font-family: "Palanquin Dark", sans-serif;
            line-height: 1.1;
            font-weight: 700;
            text-transform: uppercase;
            text-align: center;
            letter-spacing: .01em;
        }

        .tm-register-logo-link {
            position: absolute;
            top: 0;
            left: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 auto;
        }

        .tm-register-logo-link img {
            width: 46px;
            height: 46px;
            object-fit: contain;
        }

        .tm-register-subheading {
            margin: 10px 0 0 0;
            color: #212529;
            font-size: clamp(.95rem, 1.35vh, 1.05rem);
            font-family: "Palanquin", sans-serif;
            line-height: 1.5;
            text-align: center;
        }

        .tm-register-steps {
            margin-bottom: clamp(1rem, 1.8vh, 1.35rem);
            padding: clamp(.95rem, 1.45vh, 1.15rem) clamp(1rem, 1.7vw, 1.2rem);
            border-radius: 26px;
            background: linear-gradient(180deg, rgba(255,255,255,0.98) 0%, rgba(255,255,255,0.92) 100%);
            border: 1px solid rgba(18, 18, 18, 0.07);
            box-shadow: 0 16px 36px rgba(17, 17, 17, 0.07);
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: clamp(.55rem, 1vh, .8rem);
            backdrop-filter: blur(6px);
        }

        .tm-step-pill {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            justify-content: center;
            min-height: 82px;
            gap: .3rem;
            color: #858585;
            transition: color .2s ease;
        }

        .tm-step-pill.is-active {
            color: #212529;
        }

        .tm-step-pill.is-upcoming {
            color: #212529;
        }

        .tm-step-pill-index {
            display: inline-flex;
            width: clamp(18px, 2.4vh, 24px);
            height: clamp(18px, 2.4vh, 24px);
            align-items: center;
            justify-content: center;
            border-radius: 999px;
            background: rgba(17, 17, 17, 0.10);
            color: #fff;
            font-size: clamp(.58rem, .95vh, .68rem);
            font-weight: 600;
            margin-bottom: 2px;
        }

        .tm-step-pill.is-active .tm-step-pill-index {
            background: linear-gradient(90deg, #f17c30 0%, #ffb787 100%);
        }

        .tm-step-pill.is-upcoming .tm-step-pill-index {
            background: rgba(17, 17, 17, 0.08);
            color: #fff;
        }

        .tm-step-pill strong {
            display: block;
            font-size: .98rem;
            font-family: "Palanquin Dark", sans-serif;
            font-weight: 700;
            letter-spacing: .16em;
            text-transform: uppercase;
        }

        .tm-step-pill span {
            display: block;
            font-size: clamp(.76rem, 1.15vh, .86rem);
            line-height: 1.28;
            font-family: "Palanquin", sans-serif;
        }

        .tm-step-panel {
            width: 100%;
            max-width: 740px;
            margin: 22px auto 0;
        }

        .tm-step-title {
            margin: 0;
            color: #121212;
            font-size: clamp(1.02rem, 2.2vh, 1.32rem);
            line-height: 1.1;
            font-family: "Palanquin Dark", sans-serif;
        }

        .tm-step-lead {
            display: block;
            margin-top: .35rem;
            color: #5b5b5b;
            font-family: "Palanquin", sans-serif;
            line-height: 1.42;
            margin-bottom: clamp(14px, 1.6vh, 20px);
            font-size: clamp(.7rem, 1.2vh, .84rem);
        }

        .tm-field-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: clamp(6px, .8vh, 10px);
        }

        .tm-password-row {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            column-gap: clamp(6px, .8vh, 10px);
            row-gap: clamp(3px, .5vh, 5px);
            align-items: start;
            grid-template-areas:
                "label1 label2"
                "field1 field2";
        }

        .tm-password-row .tm-password-label {
            margin: 0;
            color: #212529;
            font-size: .98rem;
            font-weight: 600;
            line-height: 1.1;
            font-family: "Palanquin Dark", sans-serif;
        }

        .tm-password-row .tm-password-label:nth-of-type(1) {
            grid-area: label1;
        }

        .tm-password-row .tm-password-label:nth-of-type(2) {
            grid-area: label2;
        }

        .tm-password-row .tm-password-field {
            min-width: 0;
        }

        .tm-password-row .tm-password-field:nth-of-type(1) {
            grid-area: field1;
        }

        .tm-password-row .tm-password-field:nth-of-type(2) {
            grid-area: field2;
        }

        .tm-password-input-wrap {
            position: relative;
        }

        .tm-password-input-wrap .form-control {
            padding-right: 48px;
        }

        .tm-password-toggle {
            position: absolute;
            top: 50%;
            right: 14px;
            transform: translateY(-50%);
            width: 24px;
            height: 24px;
            padding: 0;
            border: 0;
            background: transparent;
            color: #7a7a7a;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        .tm-password-toggle:hover,
        .tm-password-toggle:focus {
            color: #262626;
            outline: none;
        }

        .tm-password-row + .tm-register-consents {
            margin-top: 18px;
        }

        .tm-register-consents + .tm-field-block {
            margin-top: clamp(12px, 1.6vh, 20px);
        }

        .tm-recaptcha-block {
            margin-top: clamp(12px, 1.6vh, 20px);
            margin-bottom: 44px;
        }

        .tm-field-grid + .tm-field-grid,
        .tm-field-grid + .tm-role-grid,
        .tm-role-grid + .tm-field-grid,
        .tm-role-grid + .tm-register-consents,
        .tm-register-consents + .tm-step-actions,
        .tm-field-block + .tm-field-block,
        .tm-field-grid + .tm-field-block,
        .tm-field-block + .tm-step-actions {
            margin-top: clamp(6px, .8vh, 10px);
        }

        .tm-field-grid + .tm-field-block {
            margin-top: 18px;
        }

        .tm-hidden-field + .tm-password-row {
            margin-top: 18px;
        }


        .tm-field,
        .tm-field-block {
            width: 100%;
        }

        .tm-field label,
        .tm-field-block label,
        .tm-choice-label {
            display: block;
            margin: 0 0 clamp(3px, .5vh, 5px);
            color: #212529;
            font-size: .98rem;
            font-weight: 600;
            font-family: "Palanquin Dark", sans-serif;
        }

        .tm-register-panel .form-control {
            min-height: clamp(34px, 4.4vh, 42px);
            border-radius: 16px;
            border: 1px solid rgba(18, 18, 18, 0.10);
            background: #fff;
            color: #212529;
            box-shadow: 0 6px 16px rgba(17, 17, 17, 0.03);
            padding: clamp(6px, .9vh, 9px) clamp(9px, 1vw, 12px);
            font-size: clamp(.95rem, 1.3vh, 1.02rem);
            font-family: "Palanquin", sans-serif;
        }

        .tm-register-panel .form-control:focus {
            border-color: rgba(241, 124, 48, 0.7);
            box-shadow: 0 0 0 3px rgba(241, 124, 48, 0.12);
        }

        .tm-field .invalid-feedback,
        .tm-field-block .invalid-feedback,
        .tm-register-panel .invalid-feedback,
        .tm-register-panel .form-error-message {
            display: block;
            color: #c13d3d;
            font-size: .74rem;
            margin-top: 4px;
            font-family: "Palanquin", sans-serif;
        }

        .tm-role-list {
            display: grid;
            grid-template-columns: 1fr;
            gap: clamp(.35rem, .8vh, .55rem);
        }

        .tm-role-card {
            position: relative;
            display: flex;
            align-items: flex-start;
            gap: .85rem;
            border: 1px solid rgba(18, 18, 18, 0.07);
            border-radius: 22px;
            padding: clamp(.75rem, 1.25vh, 1.05rem) clamp(.9rem, 1.35vw, 1.15rem);
            background: linear-gradient(180deg, rgba(255,255,255,0.98) 0%, rgba(255,255,255,0.94) 100%);
            box-shadow: 0 16px 36px rgba(17, 17, 17, 0.07);
            cursor: pointer;
            transition: border-color .2s ease, box-shadow .2s ease, background .2s ease, transform .2s ease;
            backdrop-filter: blur(6px);
        }

        .tm-role-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 20px 44px rgba(17, 17, 17, 0.10);
            border-color: rgba(241, 124, 48, 0.20);
        }

        .tm-role-card.is-selected {
            border-color: rgba(241, 124, 48, 0.34);
            box-shadow: inset 0 0 0 1px rgba(241, 124, 48, 0.30), 0 18px 38px rgba(241, 124, 48, 0.10);
            background: linear-gradient(180deg, rgba(255,255,255,1) 0%, rgba(255,249,244,0.96) 100%);
        }

        .tm-role-card input[type="radio"] {
            appearance: none;
            -webkit-appearance: none;
            flex: 0 0 auto;
            width: clamp(14px, 1.8vh, 18px);
            height: clamp(14px, 1.8vh, 18px);
            margin: .18rem 0 0 0;
            border-radius: 50%;
            border: 1.5px solid rgba(17, 17, 17, 0.5);
            background: #fff;
            position: relative;
            pointer-events: none;
        }

        .tm-role-card input[type="radio"]::after {
            content: "";
            position: absolute;
            inset: 3px;
            border-radius: 50%;
            background: #f17c30;
            transform: scale(0);
            transition: transform .18s ease;
        }

        .tm-role-card.is-selected input[type="radio"] {
            border-color: #f17c30;
        }

        .tm-role-card.is-selected input[type="radio"]::after {
            transform: scale(1);
        }

        .tm-role-card-body {
            min-width: 0;
        }

        .tm-role-card strong {
            display: block;
            font-size: .98rem;
            color: #121212;
            margin-bottom: .25rem;
            line-height: 1.22;
            font-family: "Palanquin Dark", sans-serif;
            font-weight: 700;
        }

        .tm-role-card span {
            display: block;
            color: #212529;
            line-height: 1.38;
            font-size: clamp(.92rem, 1.25vh, 1rem);
            font-family: "Palanquin", sans-serif;
        }

        .tm-register-consents {
            padding: clamp(.6rem, 1vh, .88rem) clamp(.72rem, 1.1vw, .98rem);
            border-radius: 22px;
            background: linear-gradient(180deg, rgba(255,255,255,0.98) 0%, rgba(255,255,255,0.93) 100%);
            border: 1px solid rgba(18, 18, 18, 0.07);
            box-shadow: 0 12px 28px rgba(17, 17, 17, 0.06);
        }

        .tm-consent {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            color: #212529;
            line-height: 1.45;
            font-size: clamp(.8rem, 1.02vh, .88rem);
            font-family: "Palanquin", sans-serif;
        }

        .tm-consent + .tm-consent {
            margin-top: 6px;
        }

        .tm-consent input {
            margin-top: 4px;
        }

        .tm-consent a {
            color: #212529;
            text-decoration: underline;
        }

        .tm-step-actions {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 10px;
            flex-wrap: wrap;
            margin-top: 48px;
        }

        .tm-btn-secondary,
        .tm-btn-primary {
            border-radius: 14px;
            min-height: clamp(32px, 4vh, 38px);
            min-width: 248px;
            padding: clamp(8px, 1vh, 10px) clamp(34px, 3vw, 48px);
            font-family: "Palanquin Dark", sans-serif;
            font-size: clamp(.94rem, 1.2vh, 1.02rem);
            font-weight: 700;
        }

        .tm-btn-secondary {
            border: 1px solid #d7d0ca;
            background: #fff;
            color: #212529;
        }

        .tm-btn-primary,
        .tm-btn-primary:hover,
        .tm-btn-primary:focus {
            background: linear-gradient(135deg, #f17c30 0%, #ff9f60 100%);
            border-color: transparent;
            color: #fff;
        }

        .tm-step-note {
            color: #212529;
            font-size: clamp(.62rem, .9vh, .72rem);
            line-height: 1.25;
            text-align: center;
            font-family: "Palanquin", sans-serif;
        }

        .tm-login-note {
            color: #212529;
            font-size: clamp(.9rem, 1.15vh, .98rem);
            text-align: center;
            margin: 0;
            font-family: "Roboto", sans-serif;
        }

        .tm-login-note a {
            color: #212529;
            text-decoration: underline;
        }

        .tm-note-link {
            color: #212529;
            text-decoration: underline;
        }

        .tm-note-link-prefix {
            text-decoration: none;
        }

        .tm-hidden-field {
            display: none;
        }

        .tm-register-footer {
            display: flex;
            align-items: center;
            justify-content: flex-start;
            margin-top: 18px;
            color: #212529;
            font-size: clamp(.9rem, 1.1vh, .96rem);
            font-family: "Roboto", sans-serif;
        }

        .tm-register-footer a {
            color: #212529;
            text-decoration: none;
        }

        .tm-register-alert {
            margin-bottom: 18px;
        }

        @media (min-width: 992px) and (max-height: 900px) {
            .tm-register-shell {
                padding-top: 500px;
                padding-bottom: 72px;
            }

            .tm-register-panel {
                padding: .9rem;
            }

            .tm-register-steps {
                margin-bottom: .7rem;
                padding: .55rem .7rem;
            }

            .tm-step-title {
                font-size: 1.14rem;
            }

            .tm-step-lead {
                margin-bottom: 8px;
                font-size: .88rem;
            }

            .tm-role-card strong {
                font-size: .98rem;
            }

            .tm-role-card span {
                font-size: .9rem;
            }
        }

        @media (min-width: 992px) and (max-height: 780px) {
            .tm-register-shell {
                padding-top: 500px;
                padding-bottom: 72px;
            }

            .tm-register-wrap,
            .tm-register-panel {
                max-width: 820px;
            }

        }

        @media (max-width: 991px) {
            .tm-register-shell {
                padding: 860px 18px 64px;
            }

            .tm-register-wrap {
                margin-top: 0;
                max-width: 100%;
            }

            .tm-register-panel {
                padding: 20px 16px 24px;
                border-radius: 24px;
            }

            .tm-register-topbar {
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 14px;
                min-height: auto;
            }

            .tm-register-logo-link {
                order: 1;
            }

            .tm-register-topbar-main {
                order: 2;
                width: 100%;
                align-items: center;
                padding-top: 0;
            }

            .tm-register-heading {
                text-align: center;
            }

            .tm-register-steps {
                grid-template-columns: 1fr;
                gap: 12px;
            }

            .tm-step-pill {
                min-height: auto;
            }

            .tm-field-grid {
                grid-template-columns: 1fr;
            }

            .tm-register-logo-link {
                position: static;
                margin: 0 auto .5rem;
            }

            .tm-password-row {
                grid-template-columns: 1fr;
                grid-template-areas:
                    "label1"
                    "field1"
                    "label2"
                    "field2";
                row-gap: 8px;
            }

            .tm-step-actions {
                margin-top: 32px;
            }

            .tm-btn-primary,
            .tm-btn-secondary {
                width: 100%;
                max-width: 320px;
            }
        }

        .tm-register-form {
            height: 100vh;
            height: 100dvh;
            min-height: 100vh;
            min-height: 100dvh;
        }

        html {
            height: 100%;
            margin: 0;
            padding: 0;
        }

        body {
            background: #f2eee9;
            height: 100vh;
            height: 100dvh;
            min-height: 100vh;
            min-height: 100dvh;
            margin: 0;
            padding: 0;
        }

        .tm-register-form,
        .tm-register-shell,
        .tm-register-wrap,
        .tm-register-visual,
        .tm-register-panel,
        .tm-register-panel-content {
            box-sizing: border-box;
        }

        .tm-register-shell {
            height: 100vh;
            height: 100dvh;
            min-height: 100vh;
            min-height: 100dvh;
            width: 100%;
            padding: 0;
            align-items: stretch;
            justify-content: stretch;
            background: #fff;
        }

        .tm-register-wrap {
            width: 100%;
            max-width: none;
            height: 100vh;
            height: 100dvh;
            min-height: 100vh;
            min-height: 100dvh;
            margin: 0;
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            background: #fff;
            border: 0;
            border-radius: 0;
            box-shadow: none;
            overflow: hidden;
        }

        .tm-register-visual {
            position: relative;
            height: 100vh;
            height: 100dvh;
            min-height: 100vh;
            min-height: 100dvh;
            padding: clamp(24px, 4.2vmin, 64px);
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
            color: #fff;
            background-image:
                linear-gradient(180deg, rgba(14, 10, 8, 0.28) 0%, rgba(14, 10, 8, 0.68) 100%),
                var(--tm-register-visual-image);
            background-size: cover;
            background-position: center;
            isolation: isolate;
        }

        .tm-register-visual::after {
            content: "";
            position: absolute;
            inset: 0;
            background:
                linear-gradient(rgba(255,255,255,0.06) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,0.06) 1px, transparent 1px);
            background-size: 72px 72px;
            opacity: .18;
            pointer-events: none;
            z-index: 0;
        }

        .tm-register-visual > * {
            position: relative;
            z-index: 1;
        }

        .tm-register-visual-copy {
            max-width: clamp(320px, 30vw, 540px);
            text-shadow: 0 1px 16px rgba(0, 0, 0, .34);
        }

        .tm-register-visual-copy strong {
            display: block;
            margin-bottom: clamp(8px, 1.2vh, 16px);
            font-family: "Palanquin Dark", sans-serif;
            font-size: clamp(2rem, 5.2vmin, 3.6rem);
            line-height: .95;
            font-weight: 700;
        }

        .tm-register-visual-copy span {
            display: block;
            max-width: clamp(280px, 26vw, 440px);
            color: rgba(255, 255, 255, .82);
            font-size: clamp(.86rem, 1.05vw, 1.12rem);
            line-height: 1.35;
        }

        .tm-register-panel {
            max-width: none;
            margin: 0;
            height: 100vh;
            height: 100dvh;
            min-height: 100vh;
            min-height: 100dvh;
            padding: clamp(16px, 4vh, 52px) clamp(28px, 5vw, 92px);
            border: 0;
            border-radius: 0;
            background: #fff;
            box-shadow: none;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            overflow-y: auto;
            overscroll-behavior: contain;
            scrollbar-gutter: stable;
        }

        .tm-register-panel-content {
            width: clamp(360px, 31vw, 520px);
            max-width: 100%;
            margin: auto;
        }

        .tm-register-topbar {
            margin-bottom: clamp(10px, 2.1vh, 24px);
            min-height: 0;
        }

        .tm-register-logo-link {
            display: none;
        }

        .tm-register-topbar-main {
            align-items: flex-start;
            padding-top: 0;
        }

        .tm-register-heading {
            font-size: clamp(1.55rem, 2.25vw, 2.3rem);
            line-height: 1.05;
            text-align: left;
            text-transform: none;
            letter-spacing: 0;
        }

        .tm-register-subheading {
            margin-top: clamp(3px, .7vh, 8px);
            color: #424242;
            font-size: clamp(.86rem, 1vw, 1.06rem);
            line-height: 1.35;
            text-align: left;
        }

        .tm-register-steps {
            margin: 0 0 clamp(12px, 2.4vh, 28px);
            padding: 0;
            display: flex;
            align-items: center;
            gap: clamp(5px, .7vw, 10px);
            border: 0;
            border-radius: 0;
            background: transparent;
            box-shadow: none;
            backdrop-filter: none;
        }

        .tm-step-pill {
            min-height: 0;
            flex-direction: row;
            gap: clamp(4px, .55vw, 8px);
            color: #888;
            white-space: nowrap;
        }

        .tm-step-pill.is-upcoming {
            color: #777;
        }

        .tm-step-pill:not(:last-child)::after {
            content: "";
            width: clamp(18px, 3.1vw, 34px);
            height: 1px;
            margin-left: 4px;
            background: #cfc8c1;
        }

        .tm-step-pill-index {
            width: clamp(18px, 1.55vw, 22px);
            height: clamp(18px, 1.55vw, 22px);
            margin-bottom: 0;
            background: #fff;
            border: 1px solid #bfb8b1;
            color: #69625c;
            font-size: clamp(.66rem, .7vw, .78rem);
        }

        .tm-step-pill.is-active .tm-step-pill-index {
            background: #111;
            border-color: #111;
            color: #fff;
        }

        .tm-step-pill.is-passed .tm-step-pill-index,
        .tm-step-pill.is-completed .tm-step-pill-index {
            background: #ff7e10;
            border-color: #ff7e10;
            color: #fff;
        }

        .tm-step-pill.is-upcoming .tm-step-pill-index {
            background: #fff;
            border-color: #bfb8b1;
            color: #69625c;
        }

        .tm-step-pill strong {
            font-size: clamp(.74rem, .82vw, .88rem);
            letter-spacing: 0;
            text-transform: none;
        }

        .tm-step-pill strong + span {
            display: none;
        }

        .tm-step-panel {
            max-width: none;
            margin: clamp(14px, 2.6vh, 30px) 0 0;
        }

        .tm-step-panel[hidden] {
            display: none;
        }

        .tm-creation-panel {
            padding-top: clamp(4px, .8vh, 10px);
        }

        .tm-field-block label,
        .tm-choice-label {
            font-size: clamp(.82rem, .9vw, .96rem);
            line-height: 1.25;
        }

        .tm-role-list {
            gap: clamp(7px, 1.05vh, 12px);
        }

        .tm-role-card {
            gap: clamp(8px, .8vw, 12px);
            padding: clamp(13px, 1.9vh, 20px) clamp(18px, 1.8vw, 28px);
            border: 2px solid rgba(255, 126, 16, .28);
            border-radius: 26px;
            background: #fff;
            box-shadow: 0 10px 28px rgba(255, 126, 16, .06);
            backdrop-filter: none;
            transform: none;
        }

        .tm-role-card:hover {
            transform: none;
            border-color: rgba(255, 126, 16, .56);
            box-shadow: 0 12px 30px rgba(255, 126, 16, .10);
        }

        .tm-role-card.is-selected {
            border-color: rgba(255, 126, 16, .58);
            background: linear-gradient(180deg, #fff 0%, #fffaf6 100%);
            box-shadow: inset 0 0 0 1px rgba(255, 126, 16, .20), 0 12px 30px rgba(255, 126, 16, .10);
        }

        .tm-role-card input[type="radio"] {
            width: 16px;
            height: 16px;
            margin-top: 2px;
            border-color: rgba(255, 126, 16, .62);
        }

        .tm-role-card input[type="radio"]::after {
            inset: 3px;
            background: #ff7e10;
        }

        .tm-role-card.is-selected input[type="radio"] {
            border-color: #ff7e10;
        }

        .tm-role-card strong {
            margin-bottom: clamp(4px, .7vh, 8px);
            font-size: clamp(1rem, 1.08vw, 1.18rem);
            line-height: 1.12;
        }

        .tm-role-card span {
            color: #333;
            font-size: clamp(.86rem, .95vw, 1rem);
            line-height: 1.38;
        }

        .tm-field-grid,
        .tm-password-row {
            grid-template-columns: 1fr;
        }

        .tm-field-grid + .tm-field-block,
        .tm-hidden-field + .tm-password-row {
            margin-top: clamp(10px, 1.6vh, 18px);
        }

        .tm-creation-panel .tm-field-grid + .tm-hidden-field + .tm-password-row,
        .tm-creation-panel .tm-field-grid + .tm-password-row {
            margin-top: clamp(16px, 2.4vh, 26px);
        }

        .tm-password-row {
            row-gap: clamp(6px, 1vh, 10px);
            grid-template-areas:
                "label1"
                "field1"
                "label2"
                "field2";
        }

        .tm-password-row .tm-password-label {
            font-size: clamp(.82rem, .9vw, .96rem);
        }

        .tm-register-panel .form-control {
            min-height: clamp(34px, 4.55vh, 46px);
            border-radius: 5px;
            border-color: #cfc8c1;
            box-shadow: none;
            font-size: clamp(.86rem, .92vw, 1rem);
        }

        .tm-register-panel .form-control:focus {
            border-color: #111;
            box-shadow: 0 0 0 3px rgba(241, 124, 48, .14);
        }

        .tm-register-consents {
            padding: 0;
            border: 0;
            border-radius: 0;
            background: transparent;
            box-shadow: none;
        }

        .tm-creation-panel .tm-register-consents {
            margin-top: clamp(16px, 2.3vh, 24px);
        }

        .tm-consent {
            color: #282828;
            font-size: clamp(.7rem, .74vw, .82rem);
            line-height: 1.32;
        }

        .tm-recaptcha-block {
            margin: clamp(8px, 1.4vh, 16px) 0 clamp(12px, 2vh, 22px);
        }

        .tm-step-actions {
            margin-top: clamp(10px, 1.8vh, 20px);
            gap: clamp(6px, 1vh, 10px);
        }

        .tm-btn-primary {
            width: 100%;
            max-width: 100%;
            min-width: 0;
            min-height: clamp(38px, 5vh, 50px);
            border-radius: 14px;
            background: #fff;
            border: 1px solid #111;
            color: #111;
            font-family: "Palanquin Dark", sans-serif;
            font-weight: 700;
            font-size: clamp(.82rem, .9vw, .98rem);
            box-shadow: none;
        }

        .tm-btn-primary:hover,
        .tm-btn-primary:focus {
            background: #ff7e10;
            border-color: #ff7e10;
            color: #fff;
        }

        .tm-step-actions-row {
            width: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
        }

        .tm-step-actions-row .tm-btn-primary,
        .tm-step-actions-row .tm-btn-secondary {
            min-width: 0;
            width: 100%;
            max-width: 100%;
            display: block;
            margin: 0 auto;
            flex: 0 1 auto;
            min-height: clamp(38px, 5vh, 50px);
            border-radius: 14px;
            background: #fff;
            border: 1px solid #111;
            color: #111;
            font-family: "Palanquin Dark", sans-serif;
            font-size: clamp(.82rem, .9vw, .98rem);
            font-weight: 700;
            box-shadow: none;
            padding: clamp(8px, 1vh, 10px) clamp(18px, 2vw, 28px);
        }

        .tm-step-actions-row .tm-btn-primary:hover,
        .tm-step-actions-row .tm-btn-primary:focus {
            background: #ff7e10;
            border-color: #ff7e10;
            color: #fff;
        }

        .tm-step-actions-row .tm-btn-secondary:hover,
        .tm-step-actions-row .tm-btn-secondary:focus {
            background: #111;
            border-color: #111;
            color: #fff;
        }

        .tm-choice-error {
            display: none;
            margin-top: 10px;
            color: #b54000;
            font-size: clamp(.76rem, .82vw, .88rem);
            line-height: 1.35;
        }

        .tm-choice-error.is-visible {
            display: block;
        }

        .tm-login-note {
            font-size: clamp(.74rem, .8vw, .86rem);
        }

        .tm-register-footer {
            margin-top: clamp(10px, 2vh, 20px);
            font-size: clamp(.74rem, .82vw, .88rem);
        }

        @media (max-width: 1180px) {
            .tm-register-panel {
                padding: clamp(18px, 4.5vh, 48px) clamp(24px, 4vw, 48px);
            }

            .tm-register-panel-content {
                width: clamp(340px, 34vw, 450px);
            }

            .tm-register-heading {
                font-size: clamp(1.45rem, 2vw, 1.8rem);
            }

        }

        @media (min-height: 940px) and (min-width: 992px) {
            .tm-register-panel {
                justify-content: center;
            }
        }

        @media (min-width: 992px) {
            html,
            body {
                overflow: hidden;
            }
        }

        @media (max-height: 820px) and (min-width: 992px) {
            .tm-register-panel {
                justify-content: flex-start;
                padding-top: clamp(10px, 2.5vh, 20px);
                padding-bottom: clamp(10px, 2.5vh, 20px);
            }

            .tm-register-panel-content {
                width: clamp(340px, 29vw, 430px);
                margin: auto;
            }

            .tm-register-heading {
                font-size: clamp(1.34rem, 1.75vw, 1.62rem);
            }

            .tm-register-subheading {
                font-size: .82rem;
            }

            .tm-register-steps {
                margin-bottom: 10px;
            }

            .tm-role-card {
                padding: 10px 14px;
                border-radius: 20px;
            }

            .tm-role-card span {
                font-size: .78rem;
            }

            .tm-register-panel .form-control {
                min-height: 34px;
            }

            .tm-recaptcha-block {
                margin-bottom: 10px;
            }
        }

        @media (min-width: 1800px) and (min-height: 950px) {
            .tm-register-panel-content {
                width: clamp(500px, 29vw, 590px);
            }

            .tm-role-card {
                border-radius: 10px;
            }
        }

        @media (max-width: 991px) {
            html,
            body,
            .tm-register-form,
            .tm-register-shell,
            .tm-register-wrap,
            .tm-register-visual,
            .tm-register-panel {
                height: auto;
            }

            html,
            body {
                overflow: auto;
                margin: 0;
                padding: 0;
                overflow-x: hidden;
            }

            .tm-register-shell {
                padding: 0;
                align-items: stretch;
            }

            .tm-register-wrap {
                grid-template-columns: 1fr;
                max-width: none;
                min-height: 100vh;
                min-height: 100dvh;
                margin: 0;
                overflow: visible;
                align-content: flex-start;
            }

            .tm-register-visual {
                min-height: clamp(180px, 32vh, 300px);
                padding: clamp(18px, 5vw, 28px);
            }

            .tm-register-panel {
                min-height: auto;
                padding: clamp(22px, 5vw, 30px) clamp(16px, 4.5vw, 22px) clamp(28px, 6vw, 34px);
                justify-content: flex-start;
                overflow: visible;
                align-items: stretch;
            }

            .tm-register-panel-content {
                width: 100%;
                max-width: 520px;
                margin: 0 auto;
            }

            .tm-register-topbar {
                align-items: flex-start;
            }

            .tm-register-topbar-main {
                align-items: flex-start;
            }

            .tm-register-heading,
            .tm-register-subheading {
                text-align: left;
            }

            .tm-register-steps {
                gap: 6px;
                overflow-x: auto;
                padding-bottom: 4px;
            }

            .tm-step-pill:not(:last-child)::after {
                width: 18px;
            }

            .tm-step-panel {
                margin-top: clamp(12px, 2vh, 20px);
            }

            .tm-register-panel .form-control {
                font-size: 16px;
            }

        }

        @media (max-width: 520px) {
            .tm-register-visual {
                min-height: 180px;
                padding: 18px 16px;
            }

            .tm-register-visual-copy strong {
                font-size: 1.8rem;
            }

            .tm-register-visual-copy span {
                font-size: .9rem;
            }

            .tm-register-panel {
                padding: 22px 14px 26px;
            }

            .tm-register-heading {
                font-size: 1.55rem;
            }
        }
    </style>
{% endblock %}

{% block body %}
    {% set registerVisualImage = include('Seo/Meta/security_image.html.twig', {code: 'register_image'})|trim %}
    {% set registerVisualBackground = registerVisualImage ?: absolute_url(asset('assets/img/john-raptis.png')) %}

    {{ form_start(registrationForm, {
        'attr': {
            'id': 'registration-form',
            'class': 'tm-register-form',
            'data-initial-step': app.request.method == 'POST' ? '2' : '1',
            'onsubmit': 'return gtagSendEvent(this);'
        }
    }) }}

    <main class="tm-register-shell">
        <div class="tm-register-wrap">
            <section class="tm-register-visual" style="--tm-register-visual-image: url('{{ registerVisualBackground|e('css') }}');" aria-label="Trust &amp; Market">
                <div class="tm-register-visual-copy">
                    <strong>La plateforme de la production musicale.</strong>
                    <span>Studios, musiciens, producteurs : trouvez le bon partenaire pour votre projet.</span>
                </div>
            </section>

            <section class="tm-register-panel">
                <div class="tm-register-panel-content">
                    <div class="tm-register-topbar">
                        <div class="tm-register-topbar-main">
                            <h1 class="tm-register-heading">Cr&eacute;ez votre compte</h1>
                            <p class="tm-register-subheading">Gratuit, sans engagement.</p>
                        </div>
                        <a href="{{ path('home') }}" class="tm-register-logo-link" aria-label="Accueil Trust &amp; Market">
                            <img src="{{ prerender(asset('assets/img/logo_new.svg')) }}" alt="Trust &amp; Market">
                        </a>
                    </div>

                    {% for message in app.session.flashbag.get('register_recaptcha_error') %}
                        <div class="alert alert-danger tm-register-alert">{{ message ?: 'Veuillez valider le contr&ocirc;le de s&eacute;curit&eacute;.' }}</div>
                    {% endfor %}
                    {% for message in app.session.flashbag.get('register_activity_error') %}
                        <div class="alert alert-danger tm-register-alert">{{ message }}</div>
                    {% endfor %}

                    <div class="tm-register-steps">
                        <div class="tm-step-pill is-active" data-step-indicator="1">
                            <span class="tm-step-pill-index">1</span>
                            <strong>Choisir</strong>
                            <span>Choix du type de profil.</span>
                        </div>
                        <div class="tm-step-pill is-upcoming" data-step-indicator="2">
                            <span class="tm-step-pill-index">2</span>
                            <strong>Cr&eacute;er</strong>
                            <span>Email, mot de passe et validation.</span>
                        </div>
                        <div class="tm-step-pill is-upcoming" data-step-indicator="3">
                            <span class="tm-step-pill-index">3</span>
                            <strong>Confirmer</strong>
                            <span>Validation du compte par email.</span>
                        </div>
                        <div class="tm-step-pill is-upcoming" data-step-indicator="4">
                            <span class="tm-step-pill-index">4</span>
                            <strong>Compl&eacute;ter</strong>
                            <span>Compl&eacute;tez ensuite votre profil.</span>
                        </div>
                    </div>

                    <div class="tm-step-panel" data-register-step-panel="1">
                        <div class="tm-field-block">
                            <label>Vous &ecirc;tes :</label>
                        </div>

                        <div class="tm-role-list">
                            <label class="tm-role-card {% if selected_role == 'ROLE_ABONNE' %}is-selected{% endif %}" data-role-card>
                                <input type="radio" name="role_user" value="ROLE_ABONNE" {% if selected_role == 'ROLE_ABONNE' %}checked{% endif %} required>
                                <span class="tm-role-card-body">
                                    <strong>Artiste / Cr&eacute;ateur</strong>
                                    <span>Je cherche un studio ou un prestataire pour mon projet.</span>
                                </span>
                            </label>
                            <label class="tm-role-card {% if selected_role == 'ROLE_AUTO_ENTREPRENEUR' %}is-selected{% endif %}" data-role-card>
                                <input type="radio" name="role_user" value="ROLE_AUTO_ENTREPRENEUR" {% if selected_role == 'ROLE_AUTO_ENTREPRENEUR' %}checked{% endif %} required>
                                <span class="tm-role-card-body">
                                    <strong>Professionnel ind&eacute;pendant</strong>
                                    <span>Je propose mes services en auto-entrepreneur.</span>
                                </span>
                            </label>
                            <label class="tm-role-card {% if selected_role == 'ROLE_SOCIETE' %}is-selected{% endif %}" data-role-card>
                                <input type="radio" name="role_user" value="ROLE_SOCIETE" {% if selected_role == 'ROLE_SOCIETE' %}checked{% endif %} required>
                                <span class="tm-role-card-body">
                                    <strong>Structure / Soci&eacute;t&eacute;</strong>
                                    <span>Mon activit&eacute; est port&eacute;e par une soci&eacute;t&eacute; ou une agence.</span>
                                </span>
                            </label>
                        </div>

                        <p class="tm-choice-error" data-role-error>Choisissez un profil pour continuer.</p>

                        <div class="tm-step-actions">
                            <button class="btn tm-btn-primary" type="button" data-next-register-step>Suivant</button>
                            <p class="tm-login-note"><span class="tm-note-link-prefix" aria-hidden="true">&larr; </span><a href="{{ path('home') }}" class="tm-note-link">Accueil</a> <span aria-hidden="true">|</span> <a href="{{ path('app_login') }}">Se connecter</a></p>
                        </div>
                    </div>

                    <div class="tm-step-panel tm-creation-panel" data-register-step-panel="2" hidden>

                        <div class="tm-field-grid">
                            <div class="tm-field-block">
                                <label for="{{ registrationForm.email_canonical.vars.id }}">{{ 'general.email'|trans }}</label>
                                {{ form_widget(registrationForm.email_canonical, {
                                    'attr': {
                                        'class': 'form-control',
                                        'placeholder': 'Adresse email',
                                        'autocomplete': 'email'
                                    }
                                }) }}
                                {{ form_errors(registrationForm.email_canonical) }}
                            </div>
                        </div>

                        <div class="tm-hidden-field">
                            <input type="hidden" name="activite" value="profile_to_complete">
                            {{ form_widget(registrationForm.first_name, {'attr': {'tabindex': '-1'}}) }}
                            {{ form_widget(registrationForm.last_name, {'attr': {'tabindex': '-1'}}) }}
                            {{ form_widget(registrationForm.dateNaissance, {'attr': {'tabindex': '-1', 'autocomplete': 'off'}}) }}
                        </div>

                        <div class="tm-password-row">
                            <label class="tm-password-label" for="{{ registrationForm.plainPassword.first.vars.id }}">{{ 'inscription.passe'|trans }}</label>
                            <label class="tm-password-label" for="{{ registrationForm.plainPassword.second.vars.id }}">{{ 'inscription.confirmation'|trans }}</label>

                            <div class="tm-password-field">
                                <div class="tm-password-input-wrap">
                                    {{ form_widget(registrationForm.plainPassword.first, {
                                        'attr': {
                                            'class': 'form-control',
                                            'placeholder': '8 caractères minimum',
                                            'autocomplete': 'new-password'
                                        }
                                    }) }}
                                    <button class="tm-password-toggle" type="button" data-password-toggle="{{ registrationForm.plainPassword.first.vars.id }}" aria-label="Afficher le mot de passe">
                                        <i class="fa fa-eye" aria-hidden="true"></i>
                                    </button>
                                </div>
                                {{ form_errors(registrationForm.plainPassword.first) }}
                            </div>
                            <div class="tm-password-field">
                                <div class="tm-password-input-wrap">
                                    {{ form_widget(registrationForm.plainPassword.second, {
                                        'attr': {
                                            'class': 'form-control',
                                            'placeholder': 'Confirmez votre mot de passe',
                                            'autocomplete': 'new-password'
                                        }
                                    }) }}
                                    <button class="tm-password-toggle" type="button" data-password-toggle="{{ registrationForm.plainPassword.second.vars.id }}" aria-label="Afficher le mot de passe">
                                        <i class="fa fa-eye" aria-hidden="true"></i>
                                    </button>
                                </div>
                                {{ form_errors(registrationForm.plainPassword.second) }}
                            </div>
                        </div>

                        <div class="tm-register-consents">
                            <label class="tm-consent">
                                <input type="checkbox" required name="agreeTerms" id="agreeTerms">
                                <span>
                                    {{ 'inscription.condition-utilisation'|trans }}
                                    <a target="_blank" href="{{ path('page_navigation', {idPage: 'nos-conditions', id: 'conditions-generales-dutilisation'}) }}">{{ 'inscription.accepter-condition'|trans }}</a>
                                </span>
                            </label>
                            <label class="tm-consent">
                                <input type="checkbox" name="_email_newsletter">
                                <span>Je souhaite recevoir les actualit&eacute;s et offres Trust &amp; Market.</span>
                            </label>
                        </div>

                        {% if recaptcha_enabled and recaptcha_site_key %}
                            <div class="tm-field-block tm-recaptcha-block">
                                <input type="hidden" name="recaptcha_token" id="tm-register-recaptcha-token">
                                <input type="hidden" name="recaptcha_action" value="{{ recaptcha_action }}">
                                <div class="alert alert-danger tm-register-alert" id="tm-register-recaptcha-error" style="display:none;">La v&eacute;rification de s&eacute;curit&eacute; est indisponible. Merci de r&eacute;essayer.</div>
                            </div>
                        {% endif %}

                        <div class="tm-step-actions">
                            <div class="tm-step-actions-row">
                                <button class="btn tm-btn-primary" type="submit">Cr&eacute;er mon compte</button>
                            </div>
                            <p class="tm-login-note"><span class="tm-note-link-prefix" aria-hidden="true">&larr; </span><a href="#" class="tm-note-link" data-prev-register-step-link>Pr&eacute;c&eacute;dent</a> <span aria-hidden="true">|</span> <a href="{{ path('app_login') }}">Se connecter</a></p>
                        </div>
                    </div>

                </div>
            </section>
        </div>
    </main>

    {{ form_end(registrationForm) }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script>
        $(document).ready(function () {
            const $roleCards = $('[data-role-card]');
            const $passwordToggles = $('[data-password-toggle]');
            const $form = $('#registration-form');
            const $stepPanels = $('[data-register-step-panel]');
            const $stepIndicators = $('[data-step-indicator]');
            const $roleError = $('[data-role-error]');
            const initialStep = parseInt($form.data('initial-step'), 10) || 1;

            function getSelectedRole() {
                return $('input[name="role_user"]:checked').val() || '';
            }

            function setRegistrationStep(step) {
                const normalizedStep = step === 2 ? 2 : 1;

                $stepPanels.each(function () {
                    const $panel = $(this);
                    $panel.prop('hidden', parseInt($panel.data('register-step-panel'), 10) !== normalizedStep);
                });

                $stepIndicators.each(function () {
                    const $indicator = $(this);
                    const indicatorStep = parseInt($indicator.data('step-indicator'), 10);

                    $indicator.toggleClass('is-passed', indicatorStep < normalizedStep);
                    $indicator.toggleClass('is-active', indicatorStep === normalizedStep);
                    $indicator.toggleClass('is-upcoming', indicatorStep > normalizedStep);
                });

                $('.tm-register-panel').scrollTop(0);
            }

            function showRoleError(visible) {
                $roleError.toggleClass('is-visible', visible);
            }

            function toggleRoleCards() {
                const selectedRole = getSelectedRole();
                $roleCards.each(function () {
                    const $card = $(this);
                    const isSelected = $card.find('input').val() === selectedRole;
                    $card.toggleClass('is-selected', isSelected);
                });
            }

            $roleCards.on('click', function () {
                $(this).find('input').prop('checked', true).trigger('change');
            });

            $('input[name="role_user"]').on('change', function () {
                showRoleError(false);
                toggleRoleCards();
            });

            toggleRoleCards();
            setRegistrationStep(initialStep);

            $('[data-next-register-step]').on('click', function () {
                if (!getSelectedRole()) {
                    showRoleError(true);
                    return;
                }

                setRegistrationStep(2);
            });

            $('[data-prev-register-step]').on('click', function () {
                setRegistrationStep(1);
            });

            $('[data-prev-register-step-link]').on('click', function (event) {
                event.preventDefault();
                setRegistrationStep(1);
            });

            $passwordToggles.on('click', function () {
                const $toggle = $(this);
                const inputId = $toggle.data('password-toggle');
                const $input = $('#' + inputId);
                const $icon = $toggle.find('i');
                const isPassword = $input.attr('type') === 'password';

                $input.attr('type', isPassword ? 'text' : 'password');
                $toggle.attr('aria-label', isPassword ? 'Masquer le mot de passe' : 'Afficher le mot de passe');
                $icon.toggleClass('fa-eye', !isPassword);
                $icon.toggleClass('fa-eye-slash', isPassword);
            });
        });

        window.addEventListener('load', function () {
            const recaptchaField = document.querySelector('#g-recaptcha-response');
            if (recaptchaField) {
                recaptchaField.setAttribute('required', 'required');
            }

            const form = document.querySelector('#registration-form');
            const tokenField = document.querySelector('#tm-register-recaptcha-token');
            const errorBox = document.querySelector('#tm-register-recaptcha-error');
            const recaptchaEnabled = {{ recaptcha_enabled ? 'true' : 'false' }};
            const siteKey = {{ recaptcha_site_key|json_encode|raw }};
            const actionName = {{ recaptcha_action|json_encode|raw }};
            let isSubmittingWithToken = false;

            if (!form || !recaptchaEnabled || !tokenField || !siteKey) {
                return;
            }

            form.addEventListener('submit', function (event) {
                if (isSubmittingWithToken) {
                    return;
                }

                event.preventDefault();
                if (errorBox) {
                    errorBox.style.display = 'none';
                }

                if (typeof grecaptcha === 'undefined' || !grecaptcha.enterprise) {
                    if (errorBox) {
                        errorBox.style.display = 'block';
                    }
                    return;
                }

                grecaptcha.enterprise.ready(async function () {
                    try {
                        const token = await grecaptcha.enterprise.execute(siteKey, {action: actionName});
                        if (!token) {
                            if (errorBox) {
                                errorBox.style.display = 'block';
                            }
                            return;
                        }

                        tokenField.value = token;
                        isSubmittingWithToken = true;
                        form.submit();
                    } catch (error) {
                        if (errorBox) {
                            errorBox.style.display = 'block';
                        }
                    }
                });
            });
        });
    </script>
{% endblock %}
