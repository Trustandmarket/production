{% set is_clarity_enabled = (environnement is defined and environnement == 'prod') or app.environment == 'prod' %}
{% set clarity_id = app.request is defined ? app.request.server.get('MICROSOFT_CLARITY_ID') : null %}
{% if is_clarity_enabled and clarity_id %}
    <script type="text/javascript">
        (function(c,l,a,r,i,t,y){
            c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
            t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
            y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", "{{ clarity_id|e('js') }}");
    </script>
{% endif %}
