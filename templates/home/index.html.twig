{% extends 'homeLayout.html.twig' %}

{% block head %}
	{{ parent() }}

	<link rel="icon" href="{{ absolute_url(asset('assets/img/favicon/cropped-cropped-logo-trust-and-market-32x32.png')) }}" sizes="32x32"/>
	<link rel="apple-touch-icon-precomposed" href="{{ absolute_url(asset('assets/img/favicon/cropped-cropped-logo-trust-and-market-180x180.png')) }}"/>
	<meta name="msapplication-TileImage" content="{{ absolute_url(asset('assets/img/favicon/cropped-cropped-logo-trust-and-market-270x270.png')) }}"/>
	<meta name="title" content="{{ include('Seo/Meta/title.html.twig', {code: 'home'}) }}">
	<meta name="description" content="{{ include('Seo/Meta/description.html.twig', {code: 'home'}) }}">
	<link rel="canonical" href="https://www.trustandmarket.com/{{app.request.getLocale()}}">
	{# OG CONTENT #}
	<meta property="og:site_name" content="Trust&Market">
	<meta property="og:title" content="{{ include('Seo/Meta/title.html.twig', {code: 'home'}) }}">
	<meta property="og:description" content="{{ include('Seo/Meta/description.html.twig', {code: 'home'}) }}">
	<meta property="og:image" content="{% if bloc10 %}{{bloc10.optionValue}}{% else %}{{absolute_url(asset('assets/img/prestations/cover.jpg'))}}{% endif %}">
	<meta property="og:type" content="website">
	<meta property="og:url" content="{{ absolute_url(path('home')) }}">
	{# END OG CONTENT #}

	{# Twitter CARD #}
	<meta name="twitter:card" content="summary_large_image"> <meta name="twitter:creator" content="Kbr Global">
	<meta name="twitter:site" content="@trustandmarket">
	<meta name="twitter:title" content="{{ include('Seo/Meta/title.html.twig', {code: 'home'}) }}">
	<meta name="twitter:description" content="{{ include('Seo/Meta/description.html.twig', {code: 'home'}) }}">
	<meta name="twitter:image" content="{% if bloc1 %}{{bloc1.optionValue|split('|||')[1]}}{% else %}{{asset('assets/img/prestations/home-prestations-photo.jpg')}}{% endif %}">
	<meta name="twitter:image:alt" content="{{ include('Seo/Meta/title.html.twig', {code: 'home'}) }}">
	{# END Twitter Card #}

	{# LD JSON #}
	<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "Organization",
			"name": "Trust & Market",
			"legalName" : "SAS KBR GLOBAL",
			"url": "{{ absolute_url(path('home')) }}",
			"image":"{% if bloc10 %}{{bloc10.optionValue}}{% else %}{{asset('assets/img/prestations/cover.jpg')}}{% endif %}",
			"telephone": "+33 1 85 42 14 91",
			"email": "contact@kbr-global.com",
			"logo" : "{{ absolute_url(asset('assets/img/favicon/cropped-cropped-logo-trust-and-market-270x270.png')) }}",
			"foundingDate": "2017",
			"founders": [{
				"@type": "Person",
				"name": "Kalide Brassier"
			}],
			"address": {
				"@type": "PostalAddress",
				"addressLocality": "CHELLES",
				"postalCode": "77500",
				"streetAddress": "1 Rue Rejane Ruel",
				"addressCountry": "FR"
			},
			"sameAs": [
				"https://www.facebook.com/trustandmarket",
				"https://twitter.com/trustandmarket",
				"https://www.instagram.com/trustandmarket/",
				"https://www.linkedin.com/company/trustandmarket",
				"https://www.youtube.com/channel/UC-jLvu82KNM6DnFOp2Nvk_A"
			]
		}
	</script>

	{# End LD JSON #}
	<link rel="stylesheet" href="https://code.jquery.com/ui/1.10.2/themes/smoothness/jquery-ui.css"/>
{% endblock %}

{% block title %}
	{{ parent() }}
	|
	{% if meta_page is not null %}
		{{ meta_page.postTitle }}
		{% else %}Trust &amp; Market |
		{{'general.titre'|trans}}
	{% endif %}
{% endblock %}

{% block style %}
	{{ parent() }}

	<!-- Your custom styles (optional) -->
	<link href="{{ absolute_url(asset('assets/css/style.css')) }}" rel="stylesheet">
    <link href="{{ absolute_url(asset('assets/css/footer.css')) }}" rel="stylesheet">
	<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/owl-carousel/1.3.3/owl.carousel.min.css">
	<link href="{{ absolute_url(asset('assets/css/home.min.css')) }}" rel="stylesheet">
	<style>
		.homeLayout header .navbar,
		.homeLayout header .navbar.fixed-top {
			background: #0a0a0a !important;
		}

		.homeLayout header .minify-menu > li:first-child > a[href*="type_prestation=studio-musique"] {
			display: none !important;
		}

		.home-premium {
			--hp-h2-size: 2.8rem;
			--hp-h2-size-mobile: 1.95rem;
			background: linear-gradient(180deg, #f7f5f1 0%, #f3f1ec 100%);
			padding-top: 92px;
			color: #171717;
		}

		.home-premium .hp-section {
			max-width: 1180px;
			margin: 0 auto;
			padding: 28px 20px;
		}

		.home-premium .hp-block {
			background: rgba(255, 255, 255, 0.9);
			border: 1px solid rgba(0, 0, 0, 0.08);
			border-radius: 22px;
			box-shadow: 0 16px 32px rgba(0, 0, 0, 0.06);
			padding: 24px;
		}

		.home-premium .hp-hero {
			display: grid;
			grid-template-columns: 1.05fr .95fr;
			gap: 20px;
			align-items: stretch;
		}

		.home-premium .hp-hero-kicker {
			font-size: 12px;
			letter-spacing: .18em;
			text-transform: uppercase;
			color: #b18249;
			font-family: "Palanquin Dark", sans-serif;
			font-weight: 700;
			margin-bottom: 10px;
		}

		.home-premium .hp-hero h1 {
			font-size: 3rem;
			line-height: 1.05;
			margin-bottom: 14px;
			color: #262626;
			font-family: "Palanquin Dark", sans-serif;
		}

		.home-premium .hp-hero p {
			font-size: 1.02rem;
			line-height: 1.75;
			color: #4d4d4d;
			margin-bottom: 16px;
		}

		.home-premium .hp-hero-cta {
			display: flex;
			flex-wrap: wrap;
			gap: 10px;
		}

		.home-premium .hp-btn {
			border-radius: 10px;
			padding: 11px 18px;
			font-family: "Palanquin Dark", sans-serif;
			font-size: .96rem;
			text-decoration: none;
			display: inline-flex;
			align-items: center;
			gap: 8px;
		}

		.home-premium .hp-btn-primary {
			background: #f17c30;
			border: 1px solid #f17c30;
			color: #fff;
		}

		.home-premium .hp-btn-secondary {
			background: #262626;
			border: 1px solid #262626;
			color: #fff;
		}

		.home-premium .hp-hero-media {
			border-radius: 20px;
			min-height: 420px;
			background-size: cover;
			background-position: center;
			position: relative;
			overflow: hidden;
		}

		.home-premium .hp-hero-media::after {
			content: "";
			position: absolute;
			inset: 0;
			background: linear-gradient(135deg, rgba(0, 0, 0, 0.28) 0%, rgba(0, 0, 0, 0.1) 100%);
		}

		.home-premium .hp-title {
			font-size: var(--hp-h2-size);
			margin: 0 0 16px 0;
			text-align: center;
			color: #262626;
			font-family: "Palanquin Dark", sans-serif;
		}

		.home-premium .hp-how-grid {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 14px;
		}

		.home-premium .hp-how-heading {
			display: flex;
			align-items: center;
			gap: 18px;
			margin: 4px 0 22px;
		}

		.home-premium .hp-how-heading::before,
		.home-premium .hp-how-heading::after {
			content: "";
			height: 1px;
			flex: 1;
			background: #d9d0c4;
		}

		.home-premium .hp-how-heading h2 {
			margin: 0;
			color: #262626;
			font-size: var(--hp-h2-size);
			font-family: "Palanquin Dark", sans-serif;
			font-weight: 500;
			letter-spacing: .01em;
		}

		.home-premium .hp-how-card {
			background: #fff;
			border: 1px solid #ece6dd;
			border-radius: 10px;
			padding: 22px 20px;
			text-align: center;
			box-shadow: 0 10px 22px rgba(14, 14, 14, 0.06);
		}

		.home-premium .hp-how-top {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 12px;
			margin-bottom: 10px;
		}

		.home-premium .hp-how-step {
			font-family: "Palanquin Dark", sans-serif;
			color: #f17c30;
			font-size: 2rem;
			line-height: 1;
		}

		.home-premium .hp-how-icon {
			color: #f17c30;
			font-size: 2rem;
			line-height: 1;
		}


		.home-premium .hp-how-card strong {
			display: block;
			font-family: "Palanquin Dark", sans-serif;
			font-size: 1.7rem;
			margin-bottom: 0;
			color: #202020;
			font-weight: 600;
		}

		.home-premium .hp-how-card p {
			margin: 0;
			color: #2a2a2a;
			font-size: 1.02rem;
			line-height: 1.4;
			font-weight: 400;
		}

		.home-premium .hp-services-wrap {
			padding: 24px;
		}

		.home-premium .hp-services-wrap #news-slider .post-slide {
			padding: 4px;
		}

		.home-premium .hp-audience {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 16px;
		}

		.home-premium .hp-audience-card {
			position: relative;
			overflow: hidden;
			min-height: 220px;
			padding: 24px 28px;
			border-radius: 10px;
			border: 1px solid #ece6dd;
			background: linear-gradient(90deg, rgba(255, 255, 255, 0.96) 0%, rgba(255, 255, 255, 0.93) 58%, rgba(255, 255, 255, 0.78) 100%);
			box-shadow: 0 10px 22px rgba(14, 14, 14, 0.06);
		}

		.home-premium .hp-audience-card::after {
			content: "";
			position: absolute;
			right: 0;
			top: 0;
			bottom: 0;
			width: 48%;
			background-image: url("{{ asset('assets/img/prestations/cover.jpg') }}");
			background-size: cover;
			background-position: center;
			opacity: .17;
			pointer-events: none;
		}

		.home-premium .hp-audience-head {
			display: flex;
			align-items: center;
			gap: 12px;
			margin-bottom: 14px;
			position: relative;
			z-index: 1;
		}

		.home-premium .hp-audience-head i {
			color: #f17c30;
			font-size: 1.35rem;
		}

		.home-premium .hp-audience-card h4 {
			font-size: 1.75rem;
			margin: 0;
			color: #262626;
			font-family: "Palanquin Dark", sans-serif;
		}

		.home-premium .hp-audience-card h4 span {
			color: #f17c30;
		}

		.home-premium .hp-audience-list {
			list-style: none;
			margin: 0;
			padding: 0;
			position: relative;
			z-index: 1;
		}

		.home-premium .hp-audience-list li {
			display: flex;
			align-items: flex-start;
			gap: 10px;
			font-size: 1.02rem;
			line-height: 1.45;
			color: #2f2f2f;
			margin-bottom: 8px;
		}

		.home-premium .hp-audience-list li:last-child {
			margin: 0;
		}

		.home-premium .hp-audience-list i {
			color: #f17c30;
			font-size: 1.4rem;
			line-height: 1.3;
			margin-top: 2px;
		}

		.home-premium .hp-cta-final {
			text-align: center;
		}

		.home-premium .hp-cta-final h2 {
			font-size: var(--hp-h2-size);
			margin-bottom: 16px;
			color: #262626;
			font-family: "Palanquin Dark", sans-serif;
		}

		@media (max-width: 991px) {
			.home-premium {
				padding-top: 84px;
			}

			.home-premium .hp-hero {
				grid-template-columns: 1fr;
			}

			.home-premium .hp-hero-media {
				min-height: 260px;
			}

			.home-premium .hp-how-grid,
			.home-premium .hp-audience {
				grid-template-columns: 1fr;
			}

			.home-premium .hp-how-heading {
				gap: 10px;
				margin-bottom: 14px;
			}

			.home-premium .hp-how-heading h2 {
				font-size: var(--hp-h2-size-mobile);
			}

			.home-premium .hp-title,
			.home-premium .hp-cta-final h2 {
				font-size: var(--hp-h2-size-mobile);
			}

			.home-premium .hp-how-card {
				padding: 18px 14px;
			}

			.home-premium .hp-audience-card {
				min-height: 0;
				padding: 18px 14px;
			}

			.home-premium .hp-audience-card::after {
				width: 45%;
				opacity: .13;
			}

			.home-premium .hp-audience-card h4 {
				font-size: 1.45rem;
			}

			.home-premium .hp-audience-list li {
				font-size: 1.1rem;
			}

			.home-premium .hp-hero h1 {
				font-size: 2.2rem;
			}
		}
	</style>
{% endblock %}

{% block header %}
	{{parent()}}
{% endblock %}

{% block navigation %}
{% endblock %}

{% macro prestation_link(bloc, prestations, fallback) %}
	{% set link = path('annonces_listeAnnonces', {type_prestation: fallback, services_proposes: '', code_postal_ville: ''}) %}
	{% if bloc %}
		{% set parts = bloc.optionValue|split('|||') %}
		{% for item in prestations %}
			{% if item.termTaxonomyId == parts[0] %}
				{% set link = path('annonces_listeAnnonces', {type_prestation: item.slug, services_proposes: '', code_postal_ville: ''}) %}
			{% endif %}
		{% endfor %}
	{% endif %}
	{{- link -}}
{% endmacro %}


{% block body %}
	{% import _self as home_macros %}
	{% set heroImage = bloc12 ? bloc12.optionValue|split('|||')[1] : asset('assets/img/prestations/cover.jpg') %}
	{% set heroLink = home_macros.prestation_link(bloc12, prestations, 'photographe') %}
	{% set encart1 = encart_homepage_1 is defined and encart_homepage_1 ? encart_homepage_1.optionValue|split('|||') : [] %}
	{% set encart2 = encart_homepage_2 is defined and encart_homepage_2 ? encart_homepage_2.optionValue|split('|||') : [] %}
	<main class="home-premium">
		<section class="hp-section">
			<div class="hp-block hp-hero">
				<div>
					<p class="hp-hero-kicker">TRUST &amp; MARKET</p>
					<h1>{{ slogan_homepage and slogan_homepage.getOptionValue ? slogan_homepage.getOptionValue|striptags|raw : "La plateforme des talents musicaux et des artistes ambitieux." }}</h1>
					<p>Une expérience premium pour connecter artistes, studios et professionnels qualifiés autour de vos projets musicaux.</p>
					<div class="hp-hero-cta">
						<a class="hp-btn hp-btn-primary" href="{{ path('annonces_listeAnnonces', {type_prestation: '', services_proposes: '', code_postal_ville: ''}) }}">
							<i class="fa fa-search"></i>
							Trouver un service
						</a>
						<a class="hp-btn hp-btn-secondary" href="{{ path('app_register') }}">
							Créer mon profil gratuitement
						</a>
					</div>
				</div>
				<a class="hp-hero-media" href="{{ heroLink }}" style="background-image:url('{{ heroImage }}')"></a>
			</div>
		</section>

		<section class="hp-section">
			<div class="hp-block">
				<div class="hp-how-heading">
					<h2>Comment ça marche ?</h2>
				</div>
				<div class="hp-how-grid">
					<div class="hp-how-card">
						<div class="hp-how-top">
							<span class="hp-how-step">1.</span>
							<i class="fa fa-user hp-how-icon" aria-hidden="true"></i>
						</div>
						<p>Créez votre profil gratuit</p>
					</div>
					<div class="hp-how-card">
						<div class="hp-how-top">
							<span class="hp-how-step">2.</span>
							<i class="fas fa-guitar hp-how-icon" aria-hidden="true"></i>
						</div>
						<p>Publiez vos services</p>
					</div>
					<div class="hp-how-card">
						<div class="hp-how-top">
							<span class="hp-how-step">3.</span>
							<i class="fa fa-envelope-o hp-how-icon" aria-hidden="true"></i>
						</div>
						<p>Recevez des demandes d’artistes</p>
					</div>
				</div>
			</div>
		</section>

		<section class="hp-section">
			<div class="hp-block hp-services-wrap">
				<div class="hp-how-heading">
					<h2>Explorez nos services</h2>
				</div>
				<div id="news-slider" class="owl-carousel">
					<div class="post-slide">
						<div class="box-prestation box-photograph overlay lazy carroussel_image" data-src="{% if bloc1 %}{{bloc1.optionValue|split('|||')[1]}}{% else %}{{asset('assets/img/prestations/home-prestations-photo.jpg')}}{% endif %}">
							<a href="{{ home_macros.prestation_link(bloc1, prestations, 'photographe') }}" class="prestation-link lazyload">{{'home.bouton.photographe'|trans}}</a>
						</div>
					</div>
					<div class="post-slide">
						<div class="box-prestation box-musicien overlay lazy carroussel_image" data-src="{% if bloc2 %}{{bloc2.optionValue|split('|||')[1]}}{% else %}{{asset('assets/img/prestations/home-prestations-musicien.jpg')}}{% endif %}">
							<a href="{{ home_macros.prestation_link(bloc2, prestations, 'musiciens') }}" class="prestation-link lazyload">{{'home.bouton.musicien'|trans}}</a>
						</div>
					</div>
					<div class="post-slide">
						<div class="box-prestation box-prod-musicale overlay lazy carroussel_image" data-src="{% if bloc3 %}{{bloc3.optionValue|split('|||')[1]}}{% else %}{{asset('assets/img/prestations/home-prestations-production-musicale.jpg')}}{% endif %}">
							<a href="{{ home_macros.prestation_link(bloc3, prestations, 'studio-denregistrement') }}" class="prestation-link lazyload">{{'home.bouton.studio-enregistrement'|trans}}</a>
						</div>
					</div>
					<div class="post-slide">
						<div class="box-prestation box-grp-d-musiq overlay lazy carroussel_image" data-src="{% if bloc4 %}{{bloc4.optionValue|split('|||')[1]}}{% else %}{{asset('assets/img/prestations/home-prestations-group-music.jpg')}}{% endif %}">
							<a href="{{ home_macros.prestation_link(bloc4, prestations, 'groupes-de-musique') }}" class="prestation-link lazyload">{{'home.bouton.groupe-de-musique'|trans}}</a>
						</div>
					</div>
					<div class="post-slide">
						<div class="box-prestation box-chorale overlay lazy carroussel_image" data-src="{% if bloc5 %}{{bloc5.optionValue|split('|||')[1]}}{% else %}{{asset('assets/img/prestations/home-prestations-chorale.jpg')}}{% endif %}">
							<a href="{{ home_macros.prestation_link(bloc5, prestations, 'chorale-gospel') }}" class="prestation-link lazyload">{{'home.bouton.chorale'|trans}}</a>
						</div>
					</div>
					<div class="post-slide">
						<div class="box-prestation box-stud-photo overlay lazy carroussel_image" data-src="{% if bloc6 %}{{bloc6.optionValue|split('|||')[1]}}{% else %}{{asset('assets/img/prestations/home-prestations-stud-photo.jpg')}}{% endif %}">
							<a href="{{ home_macros.prestation_link(bloc6, prestations, 'studio-photo') }}" class="prestation-link lazyload">{{'home.bouton.studio-photo'|trans}}</a>
						</div>
					</div>
					<div class="post-slide">
						<div class="box-prestation box-realisation-vid overlay lazy carroussel_image" data-src="{% if bloc7 %}{{bloc7.optionValue|split('|||')[1]}}{% else %}{{asset('assets/img/prestations/home-prestations-realisation-vid.jpg')}}{% endif %}">
							<a href="{{ home_macros.prestation_link(bloc7, prestations, 'realisation-video') }}" class="prestation-link lazyload">{{'home.bouton.realisation-video'|trans}}</a>
						</div>
					</div>
					<div class="post-slide">
						<div class="box-prestation box-evenementiels overlay lazy carroussel_image" data-src="{% if bloc8 %}{{bloc8.optionValue|split('|||')[1]}}{% else %}{{asset('assets/img/prestations/home-prestations-evenementiels.jpg')}}{% endif %}">
							<a href="{{ home_macros.prestation_link(bloc8, prestations, 'evenementiels') }}" class="prestation-link lazyload">{{'home.bouton.evenementiel'|trans}}</a>
						</div>
					</div>
					<div class="post-slide">
						<div class="box-prestation box-stud-vid overlay lazy carroussel_image" data-src="{% if bloc9 %}{{bloc9.optionValue|split('|||')[1]}}{% else %}{{asset('assets/img/prestations/home-prestations-studio-video.jpg')}}{% endif %}">
							<a href="{{ home_macros.prestation_link(bloc9, prestations, 'studio-video') }}" class="prestation-link lazyload">{{'home.bouton.studio-video'|trans}}</a>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="hp-section">
			<div class="hp-block">
				<div class="hp-how-heading">
					<h2>Pour les artistes et les pros</h2>
				</div>
				<div class="hp-audience">
					<div class="hp-block hp-audience-card">
						<div class="hp-audience-head">
