{% extends 'base.html.twig' %}

{% block head %}
    {{ parent() }}
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="{{ include('Seo/Meta/description.html.twig', {code: 'request'}) }}">
    {% if recaptcha_enabled %}
        {% if recaptcha_mode == 'v2' and recaptcha_v2_site_key %}
            <script src="https://www.google.com/recaptcha/enterprise.js?render=explicit" async defer></script>
        {% elseif recaptcha_site_key %}
            <script src="https://www.google.com/recaptcha/enterprise.js?render={{ recaptcha_site_key|url_encode }}" async defer></script>
        {% endif %}
    {% endif %}
{% endblock %}

{% block title %}Trust &amp; Market | {{ include('Seo/Meta/title.html.twig', {code: 'request'}) }}{% endblock %}

{% block stylesheets %}
    <style>
        html,
        body {
            margin: 0;
            padding: 0;
            width: 100%;
            min-height: 100%;
        }

        body {
            background: #fff !important;
            font-family: "Palanquin", sans-serif;
            color: #212529;
        }

        .tm-reset-request-page,
        .tm-reset-request-wrap,
        .tm-reset-request-visual,
        .tm-reset-request-panel,
        .tm-reset-request-panel-content {
            box-sizing: border-box;
        }

        .tm-reset-request-page {
            height: 100vh;
            height: 100dvh;
            min-height: 100vh;
            min-height: 100dvh;
            width: 100%;
        }

        .tm-reset-request-wrap {
            width: 100%;
            height: 100vh;
            height: 100dvh;
            min-height: 100vh;
            min-height: 100dvh;
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            background: #fff;
            overflow: hidden;
        }

        .tm-reset-request-visual {
            position: relative;
            height: 100vh;
            height: 100dvh;
            min-height: 100vh;
            min-height: 100dvh;
            padding: clamp(24px, 4.2vmin, 64px);
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
            color: #fff;
            background-image:
                linear-gradient(180deg, rgba(14, 10, 8, 0.28) 0%, rgba(14, 10, 8, 0.68) 100%),
                var(--tm-reset-request-visual-image);
            background-size: cover;
            background-position: center;
            isolation: isolate;
        }

        .tm-reset-request-visual::after {
            content: "";
            position: absolute;
            inset: 0;
            background:
                linear-gradient(rgba(255,255,255,0.06) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,0.06) 1px, transparent 1px);
            background-size: 72px 72px;
            opacity: .18;
            pointer-events: none;
            z-index: 0;
        }

        .tm-reset-request-visual > * {
            position: relative;
            z-index: 1;
        }

        .tm-reset-request-visual-copy {
            max-width: clamp(320px, 30vw, 540px);
            text-shadow: 0 1px 16px rgba(0, 0, 0, .34);
        }

        .tm-reset-request-visual-copy strong {
            display: block;
            margin-bottom: clamp(8px, 1.2vh, 16px);
            font-family: "Palanquin Dark", sans-serif;
            font-size: clamp(2rem, 5.2vmin, 3.6rem);
            line-height: .95;
            font-weight: 700;
        }

        .tm-reset-request-visual-copy span {
            display: block;
            max-width: clamp(280px, 26vw, 440px);
            color: rgba(255, 255, 255, .82);
            font-size: clamp(.86rem, 1.05vw, 1.12rem);
            line-height: 1.35;
        }

        .tm-reset-request-panel {
            max-width: none;
            margin: 0;
            height: 100vh;
            height: 100dvh;
            min-height: 100vh;
            min-height: 100dvh;
            padding: clamp(16px, 4vh, 52px) clamp(28px, 5vw, 92px);
            border: 0;
            border-radius: 0;
            background: #fff;
            box-shadow: none;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            overflow-y: auto;
            overscroll-behavior: contain;
            scrollbar-gutter: stable;
        }

        .tm-reset-request-panel-content {
            width: clamp(360px, 31vw, 520px);
            max-width: 100%;
            margin: auto;
        }

        .tm-reset-request-form {
            width: 100%;
            margin: 0;
        }

        .tm-reset-request-header {
            margin-bottom: clamp(12px, 2vh, 22px);
            text-align: left;
        }

        .tm-reset-request-heading {
            margin: 0;
            color: #212529;
            font-size: clamp(1.55rem, 2.25vw, 2.3rem);
            line-height: 1.05;
            font-family: "Palanquin Dark", sans-serif;
            font-weight: 700;
            letter-spacing: 0;
        }

        .tm-reset-request-subheading {
            margin-top: clamp(3px, .7vh, 8px);
            color: #424242;
            font-size: clamp(.86rem, 1vw, 1.06rem);
            line-height: 1.35;
        }

        .tm-reset-request-form .alert {
            margin-bottom: 12px;
            border-radius: 12px;
            font-size: .88rem;
            line-height: 1.35;
        }

        .tm-reset-request-form .form-label-group {
            margin-bottom: clamp(8px, 1.1vh, 12px);
        }

        .tm-reset-request-form .form-label-group > label {
            display: block;
            margin: 0 0 clamp(3px, .5vh, 5px);
            color: #212529;
            font-size: clamp(.82rem, .9vw, .96rem);
            font-weight: 600;
            line-height: 1.25;
            font-family: "Palanquin Dark", sans-serif;
        }

        .tm-reset-request-form .input-custom {
            width: 100%;
            min-height: clamp(34px, 4.55vh, 46px);
            background: #fff;
            color: #212529;
            border: 1px solid #cfc8c1;
            border-radius: 5px;
            box-shadow: none;
            padding: clamp(6px, .9vh, 9px) clamp(9px, 1vw, 12px);
            font-size: clamp(.86rem, .92vw, 1rem);
            font-family: "Palanquin", sans-serif;
        }

        .tm-reset-request-form .input-custom:focus {
            background: #fff;
            color: #212529;
            border-color: #111;
            box-shadow: 0 0 0 3px rgba(241, 124, 48, .14);
        }

        .tm-reset-request-form .input-custom::placeholder {
            color: #8d867f;
            opacity: 1;
        }

        .tm-reset-request-form .invalid-feedback,
        .tm-reset-request-form .valid-feedback {
            margin-top: 4px;
            font-size: .74rem;
        }

        .tm-reset-request-recaptcha {
            margin: clamp(8px, 1.4vh, 16px) 0 clamp(10px, 1.6vh, 18px);
            display: flex;
            justify-content: flex-start;
        }

        #g-recaptcha-response {
            display: block !important;
            position: absolute;
            margin: -78px 0 0 0 !important;
            width: 302px !important;
            height: 55px !important;
            z-index: -999999;
            opacity: 0;
        }

        .tm-reset-request-actions {
            margin-top: clamp(6px, 1vh, 10px);
        }

        .tm-reset-request-btn {
            width: 100%;
            max-width: 100%;
            min-width: 0;
            min-height: clamp(38px, 5vh, 50px);
            border-radius: 14px;
            background: #fff;
            border: 1px solid #111;
            color: #111;
            font-family: "Palanquin Dark", sans-serif;
            font-size: clamp(.82rem, .9vw, .98rem);
            font-weight: 700;
            box-shadow: none;
            padding: clamp(8px, 1vh, 10px) clamp(18px, 2vw, 28px);
            text-transform: none;
        }

        .tm-reset-request-btn:hover,
        .tm-reset-request-btn:focus {
            background: #ff7e10;
            border-color: #ff7e10;
            color: #fff;
        }

        .tm-reset-request-links {
            margin: clamp(10px, 2vh, 18px) 0 0;
            font-size: clamp(.74rem, .8vw, .86rem);
            color: #212529;
            text-align: center;
        }

        .tm-reset-request-links a {
            color: #212529;
            text-decoration: underline;
        }

        .tm-reset-request-links a:hover {
            color: #ff7e10;
        }

        .tm-note-link-prefix {
            text-decoration: none;
            color: #212529;
        }

        @media (min-width: 992px) {
            html,
            body {
                overflow: hidden;
            }
        }

        @media (max-width: 991px) {
            html,
            body,
            .tm-reset-request-page,
            .tm-reset-request-wrap,
            .tm-reset-request-visual,
            .tm-reset-request-panel {
                height: auto;
            }

            html,
            body {
                overflow: auto;
                margin: 0;
                padding: 0;
                overflow-x: hidden;
            }

            .tm-reset-request-wrap {
                grid-template-columns: 1fr;
                max-width: none;
                min-height: 100vh;
                min-height: 100dvh;
                margin: 0;
                overflow: visible;
                align-content: flex-start;
            }

            .tm-reset-request-visual {
                min-height: clamp(220px, 38vh, 380px);
                padding: clamp(20px, 5vw, 30px);
            }

            .tm-reset-request-panel {
                min-height: auto;
                padding: clamp(12px, 2vw, 16px) clamp(16px, 4.5vw, 22px) clamp(24px, 5vw, 32px);
                justify-content: flex-start;
                overflow: visible;
                align-items: stretch;
            }

            .tm-reset-request-panel-content {
                width: 100%;
                max-width: 560px;
                margin: 0 auto;
            }

            .tm-reset-request-form .input-custom {
                font-size: 16px;
            }
        }

        @media (max-width: 520px) {
            .tm-reset-request-visual {
                min-height: 220px;
                padding: 20px 16px;
            }

            .tm-reset-request-visual-copy strong {
                font-size: 1.8rem;
            }

            .tm-reset-request-visual-copy span {
                font-size: .9rem;
            }

            .tm-reset-request-panel {
                padding: 10px 16px 24px;
            }

            .tm-reset-request-heading {
                font-size: 1.55rem;
            }
        }

        @media (max-width: 380px) {
            .tm-reset-request-form .g-recaptcha {
                transform: scale(0.9);
                transform-origin: left top;
            }
        }
    </style>
{% endblock %}

{% block body %}
    {% set resetRequestVisualImage = include('Seo/Meta/security_image.html.twig', {code: 'requete_reinitialiser_mot_de_passe_image'})|trim %}
    {% set resetRequestVisualBackground = resetRequestVisualImage ?: absolute_url(asset('assets/img/john-raptis.png')) %}

    <main class="tm-reset-request-page">
        <div class="tm-reset-request-wrap">
            <section class="tm-reset-request-visual" style="--tm-reset-request-visual-image: url('{{ resetRequestVisualBackground|e('css') }}');" aria-label="Trust &amp; Market">
                <div class="tm-reset-request-visual-copy">
                    <strong>La plateforme de la production musicale.</strong>
                    <span>Studios, musiciens, producteurs : trouvez le bon partenaire pour votre projet.</span>
                </div>
            </section>

            <section class="tm-reset-request-panel">
                <div class="tm-reset-request-panel-content">
                    {{ form_start(requestForm, {'attr': {'class': 'tm-reset-request-form', 'id': 'reset-password-request-form'}}) }}

                    {% for flashMessage in app.session.flashbag.get('success') %}
                        <div class="alert alert-primary alert-dismissible fade show" role="alert">
                            {{ flashMessage }}
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                    {% endfor %}

                    {% for flashMessage in app.session.flashbag.get('error') %}
                        {% if flashMessage == 111 %}
                            <div class="alert alert-primary alert-dismissible fade show" role="alert">
                                {{ 'email-changer-mot-de-passe.email-inexistant'|trans }}
                                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                        {% endif %}
                    {% endfor %}

                    {% for flashMessage in app.session.flashbag.get('reset_recaptcha_error') %}
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            {{ flashMessage }}
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                    {% endfor %}

                    <div class="tm-reset-request-header">
                        <h1 class="tm-reset-request-heading">{{ 'passe-oublier.titre'|trans }}</h1>
                        <p class="tm-reset-request-subheading">{{ 'passe-oublier.description'|trans }}</p>
                    </div>

                    <div class="form-label-group">
                        <label for="{{ requestForm.email_canonical.vars.id }}">{{ 'general.email'|trans }}</label>
                        {{ form_widget(requestForm.email_canonical, {
                            'attr': {
                                'class': 'form-control input-custom',
                                'placeholder': 'vous@domaine.com',
                                'autocomplete': 'email'
                            }
                        }) }}
                        {{ form_errors(requestForm.email_canonical) }}
                    </div>

                    {% if recaptcha_enabled %}
                        <div class="tm-reset-request-recaptcha">
                            <input type="hidden" name="recaptcha_mode" value="{{ recaptcha_mode|default('v3') }}">
                            <input type="hidden" name="recaptcha_force_v2" value="0">
                            <input type="hidden" name="recaptcha_action" value="{{ recaptcha_action }}">
                            {% if recaptcha_mode == 'v2' and recaptcha_v2_site_key %}
                                <div id="tm-reset-recaptcha-v2"></div>
                            {% elseif recaptcha_site_key %}
                                <input type="hidden" name="recaptcha_token" id="tm-reset-recaptcha-token">
                                <div class="alert alert-danger" id="tm-reset-recaptcha-error" style="display:none;">La v&eacute;rification de s&eacute;curit&eacute; est indisponible. Merci de r&eacute;essayer.</div>
                            {% endif %}
                        </div>
                    {% endif %}

                    <div class="tm-reset-request-actions">
                        <button class="btn btn-lg btn-primary btn-md tm-reset-request-btn" type="submit">{{ 'passe-oublier.valider'|trans }}</button>
                        <p class="tm-reset-request-links">
                            <span class="tm-note-link-prefix" aria-hidden="true">&larr; </span><a href="{{ path('home') }}">Accueil</a>
                            &nbsp;|&nbsp;
                            <a href="{{ path('app_login') }}">{{ 'connexion.titre'|trans }}</a>
                        </p>
                    </div>

                    {{ form_end(requestForm) }}
                </div>
            </section>
        </div>
    </main>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        window.addEventListener('load', function () {
            const form = document.querySelector('#reset-password-request-form');
            const tokenField = document.querySelector('#tm-reset-recaptcha-token');
            const errorBox = document.querySelector('#tm-reset-recaptcha-error');
            const modeField = form ? form.querySelector('input[name="recaptcha_mode"]') : null;
            const forceV2Field = form ? form.querySelector('input[name="recaptcha_force_v2"]') : null;
            const recaptchaEnabled = {{ recaptcha_enabled ? 'true' : 'false' }};
            const fallbackAvailable = {{ recaptcha_v2_fallback_available ? 'true' : 'false' }};
            const recaptchaMode = {{ (recaptcha_mode|default('v3'))|json_encode|raw }};
            const siteKey = {{ recaptcha_site_key|json_encode|raw }};
            const v2SiteKey = {{ recaptcha_v2_site_key|json_encode|raw }};
            const actionName = {{ recaptcha_action|json_encode|raw }};
            const v2ContainerId = 'tm-reset-recaptcha-v2';
            let isSubmittingWithToken = false;
            let isSwitchingToV2 = false;

            const switchToV2Fallback = () => {
                if (!form || !fallbackAvailable || !modeField || isSwitchingToV2) {
                    if (errorBox) {
                        errorBox.style.display = 'block';
                    }
                    return;
                }

                isSwitchingToV2 = true;
                isSubmittingWithToken = true;
                modeField.value = 'v2';
                if (forceV2Field) {
                    forceV2Field.value = '1';
                }
                form.submit();
            };

            if (form && recaptchaEnabled && recaptchaMode === 'v2' && v2SiteKey) {
                let renderAttempts = 0;
                const renderV2Widget = () => {
                    const container = document.getElementById(v2ContainerId);
                    if (!container) {
                        return;
                    }

                    if (typeof grecaptcha === 'undefined' || !grecaptcha.enterprise) {
                        renderAttempts += 1;
                        if (renderAttempts < 20) {
                            window.setTimeout(renderV2Widget, 250);
                        }
                        return;
                    }

                    grecaptcha.enterprise.ready(function () {
                        if (container.childElementCount > 0) {
                            return;
                        }

                        grecaptcha.enterprise.render(v2ContainerId, {
                            sitekey: v2SiteKey
                        });
                    });
                };

                renderV2Widget();
                return;
            }

            if (!form || !recaptchaEnabled || recaptchaMode !== 'v3' || !tokenField || !siteKey) {
                return;
            }

            form.addEventListener('submit', function (event) {
                if (isSubmittingWithToken) {
                    return;
                }

                event.preventDefault();
                if (errorBox) {
                    errorBox.style.display = 'none';
                }

                if (typeof grecaptcha === 'undefined' || !grecaptcha.enterprise) {
                    if (fallbackAvailable) {
                        switchToV2Fallback();
                        return;
                    }
                    if (errorBox) {
                        errorBox.style.display = 'block';
                    }
                    return;
                }

                grecaptcha.enterprise.ready(async function () {
                    try {
                        const token = await grecaptcha.enterprise.execute(siteKey, {action: actionName});
                        if (!token) {
                            if (fallbackAvailable) {
                                switchToV2Fallback();
                                return;
                            }
                            if (errorBox) {
                                errorBox.style.display = 'block';
                            }
                            return;
                        }

                        tokenField.value = token;
                        isSubmittingWithToken = true;
                        form.submit();
                    } catch (error) {
                        if (fallbackAvailable) {
                            switchToV2Fallback();
                            return;
                        }
                        if (errorBox) {
                            errorBox.style.display = 'block';
                        }
                    }
                });
            });
        });
    </script>
{% endblock %}
