{% extends 'profileTemplate.html.twig' %}

{% block head %}
    {{ parent() }}

    <link rel="icon" href="{{ preload(asset('assets/img/favicon/cropped-cropped-logo-trust-and-market-32x32.png')) }}"
          sizes="32x32"/>
    <link rel="icon" href="{{ preload(asset('assets/img/favicon/cropped-cropped-logo-trust-and-market-192x192.png')) }}"
          sizes="192x192"/>
    <link rel="apple-touch-icon-precomposed"
          href="{{ preload(asset('assets/img/favicon/cropped-cropped-logo-trust-and-market-180x180.png')) }}"/>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <meta name="msapplication-TileImage"
          content="{{ preload(asset('assets/img/favicon/cropped-cropped-logo-trust-and-market-270x270.png')) }}"/>
    <meta name="robots" content="noindex">


{% endblock %}

{% block title %}
    Trust &amp; Market | {{ 'profil-utilisateur.liens.titre-page'|trans }}{% endblock %}
{% block style %}
    {{ parent() }}
    <link href="{{ preload(asset('assets/css/custome.css')) }}" rel="stylesheet">
    <link href="{{ absolute_url(asset('assets/css/style.css')) }}" rel="stylesheet">
    <link href="{{ preload(asset('assets/css/style-profile.css')) }}" rel="stylesheet">
    <!-- Custom css for input tag -->
    <link rel="stylesheet" href="{{ preload(asset('assets/css/tagsinput/tagify.css')) }}">
    <link rel="stylesheet" href="{{ asset('toastr/toastr.min.css') }}">
    <link rel="stylesheet" href="{{ asset('admin/assets/css/loading-btn.css') }}">
    <link rel="stylesheet" href="{{ asset('admin/assets/css/loading.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/phone/css/intlTelInput.css') }}">
    <link rel="stylesheet" href="{{ asset('admin/assets/sweetalert/sweetalert.css') }}">
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.18/dist/sweetalert2.min.css" rel="stylesheet">
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css"/>
    <!-- Custom css for camroll -->
    <link href="{{ asset('assets/css/camroll/camroll_slider.css') }}" rel="stylesheet" type="text/css">
    <!-- owl carousel css -->
    <link rel="stylesheet" type="text/css"
          href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css">
    <link rel="stylesheet" type="text/css"
          href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.theme.default.min.css">
    <style>
        user-info-text {
            font-size: 14px;
            font-family: 'Source Sans Pro', "Helvetica Neue", Helvetica, Arial, sans-serif;
            word-break: break-word;
            color: black;
        }

        .mimic-label {
            font-family: Roboto, sans-serif;
            font-weight: 300;
            color: #757575;
        }
        .profile-completion-wrapper {
            border: 1px solid #e5e5e5;
            border-radius: 8px;
            padding: 12px 16px;
            background: #fff;
        }

        .profile-completion-label {
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 8px;
            color: #262626;
        }

        .profile-completion-missing {
            margin-top: 12px;
            padding-top: 12px;
            border-top: 1px solid #f0f0f0;
        }

        .profile-completion-missing-title {
            font-size: 13px;
            font-weight: 600;
            color: #262626;
            margin-bottom: 8px;
        }

        .profile-completion-missing-list {
            margin: 0;
            padding-left: 18px;
            color: #555;
            font-size: 13px;
        }

        .profile-completion-missing-list li + li {
            margin-top: 4px;
        }

        .trust-agent-card {
            position: relative;
            overflow: hidden;
            border-radius: 18px;
            padding: 1.5rem;
            margin: 1.25rem 0 1.75rem;
            background: #262626;
            color: #fff;
            box-shadow: 0 20px 40px rgba(15, 23, 42, 0.18);
        }

        .trust-agent-card h3 {
            margin-bottom: 0.5rem;
            font-weight: 700;
        }

        .trust-agent-card p {
            position: relative;
            z-index: 1;
            max-width: 780px;
            margin-bottom: 1rem;
            color: rgba(255, 255, 255, 0.86);
        }

        .trust-agent-actions {
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            gap: 0.85rem;
            flex-wrap: wrap;
        }

        .trust-agent-btn {
            border: 0;
            border-radius: 999px;
            padding: 0.95rem 1.35rem;
            font-weight: 700;
            color: #ffffff;
            background: #ff7e10;
            box-shadow: 0 10px 24px rgba(255, 126, 16, 0.32);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .trust-agent-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 14px 28px rgba(255, 126, 16, 0.38);
        }

        .trust-agent-btn.is-secondary {
            background: #ffffff;
            color: #111111;
            border: 1px solid #ffffff;
            box-shadow: none;
        }

        .trust-agent-btn:disabled {
            opacity: 0.45;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

        .trust-agent-status {
            display: none;
            margin-top: 1rem;
            padding: 0.9rem 1rem;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.08);
            color: #fff;
            position: relative;
            z-index: 1;
        }

        .trust-agent-status.is-visible {
            display: block;
        }

        .tm-ta-review-note {
            margin-bottom: 1rem;
            padding: 0.9rem 1rem;
            border-radius: 12px;
            background: #fff7ed;
            color: #9a3412;
            font-size: 0.95rem;
            text-align: left;
        }

        .tm-ta-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 14px;
            text-align: left;
        }

        .tm-ta-card {
            border: 1px solid #e5e7eb;
            border-radius: 14px;
            padding: 14px;
            background: #fff;
        }

        .tm-ta-card-address {
            grid-column: 1 / -1;
        }

        .tm-ta-head {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 8px;
            margin-bottom: 10px;
        }

        .tm-ta-head label {
            margin: 0;
            font-weight: 700;
            color: #111827;
        }

        .tm-ta-meta {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            color: #475569;
            background: #f8fafc;
            border-radius: 999px;
            padding: 4px 10px;
            white-space: nowrap;
        }

        .tm-ta-card .form-control,
        .tm-ta-card .custom-select {
            border-radius: 10px;
            min-height: 44px;
        }

        .tm-ta-helper {
            font-size: 12px;
            color: #64748b;
            margin-top: 8px;
        }

        .swal2-container {
            zoom: 0.8;
        }

        
        .profile-section-title {
            white-space: nowrap;
            line-height: 1.2;
        }

        .profile-section-title-row {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            flex-wrap: nowrap;
            max-width: 100%;
        }

        .profile-email-status {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 24px;
            height: 24px;
            border-radius: 999px;
            vertical-align: middle;
            flex: 0 0 auto;
            cursor: default;
        }

        .profile-email-status.is-verified {
            background: #21a455;
            box-shadow: 0 6px 16px rgba(33, 164, 85, 0.18);
        }

        .profile-email-status.is-unverified {
            background: #f17c30;
            box-shadow: 0 6px 16px rgba(241, 124, 48, 0.20);
            cursor: pointer;
        }

        .profile-email-status.is-verified::before {
            content: "";
            width: 7px;
            height: 12px;
            border-right: 3px solid #ffffff;
            border-bottom: 3px solid #ffffff;
            transform: rotate(45deg) translate(-1px, -1px);
            transform-origin: center;
        }

        .profile-email-status.is-unverified::before {
            content: "!";
            color: #ffffff;
            font-size: 15px;
            font-weight: 700;
            line-height: 1;
            font-family: Roboto, sans-serif;
        }

        .profile-email-tooltip {
            position: absolute;
            top: calc(100% + 10px);
            left: 50%;
            transform: translateX(-50%);
            min-width: 210px;
            padding: 10px 12px;
            border-radius: 10px;
            background: #262626;
            color: #ffffff;
            font-size: 12px;
            line-height: 1.45;
            box-shadow: 0 14px 32px rgba(0, 0, 0, 0.20);
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transition: opacity .18s ease, visibility .18s ease, transform .18s ease;
            z-index: 20;
        }

        .profile-email-tooltip::before {
            content: "";
            position: absolute;
            top: -6px;
            left: 50%;
            width: 12px;
            height: 12px;
            background: #262626;
            transform: translateX(-50%) rotate(45deg);
        }

        .profile-email-tooltip-text {
            display: block;
        }

        .profile-email-tooltip-link {
            display: inline-block;
            margin-top: 8px;
            color: #ffffff;
            font-weight: 700;
            text-decoration: underline;
            pointer-events: auto;
        }

        .profile-email-status:hover .profile-email-tooltip,
        .profile-email-status:focus-within .profile-email-tooltip {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
            transform: translateX(-50%) translateY(0);
        }

        @media (max-width: 767.98px) {
            .profile-section-title {
                white-space: normal;
            }

            .profile-section-title-row {
                display: inline-flex;
                align-items: center;
                gap: 8px;
            }

            .profile-email-tooltip {
                left: 0;
                transform: translateX(0);
                min-width: 190px;
            }

            .profile-email-tooltip::before {
                left: 18px;
                transform: rotate(45deg);
            }

            .profile-email-status:hover .profile-email-tooltip,
            .profile-email-status:focus-within .profile-email-tooltip {
                transform: translateX(0) translateY(0);
            }

            .swal2-container {
                zoom: 0.67 !important;
            }

            .swal2-title {
                font-size: 1.275em !important;
            }
        }
        .image_area {
            position: relative;
        }

        img {
            display: block;
            max-width: 100%;
        }

        .preview {
            width: 160px;
            height: 160px;
            margin: 10px;
            border: 1px solid red;
            float: right;
        }

        .modal-lg{
            max-width: 1000px !important;
        }

        .overlay {
            position: absolute;
            bottom: 10px;
            left: 0;
            right: 0;
            background-color: rgba(255, 255, 255, 0.5);
            height: 0;
            transition: .5s ease;
            width: 100%;
        }

        .image_area:hover .overlay {
            height: 50%;
            cursor: pointer;
        }

        .text {
            color: #333;
            font-size: 20px;
            position: absolute;
            top: 50%;
            left: 50%;
            -webkit-transform: translate(-50%, -50%);
            -ms-transform: translate(-50%, -50%);
            transform: translate(-50%, -50%);
            text-align: center;
        }

        .modal-title{
            font-family: "Source Sans Pro", "Helvetica Neue", Helvetica, Arial, sans-serif;
            text-align: center;
        }

        .modal-content{
            border-radius: 5px;
        }

        .modal-body{
            width: 95%;
            margin: auto;
        }

        .modal-footer{
            display: block;
        }

        .modal-footer .btn-warning{
            float: left;
            background-color: #262626 !important;
        }

        .modal-footer .btn-primary{
            float: right;
        }
        strong {
             font-weight: bold;
        }
        .cropper-container{
            width: 100%;
        }

        #topBtn {
            /*bottom: 0px !important;*/
        }

        /* Extra small devices (portrait phones, less than 576px) */
        @media (max-width: 575.98px) {
            main, .container {
                margin-top: 70px;
            }

            .preview {
                width: 200px;
                height: 200px;
                border: 1px solid red;
                margin: auto;
                float: none;
            }

            .image-bloc{
                margin-top: 25px;
            }
        }

        /* Small devices (landscape phones, 576px and up) */
        @media (min-width: 576px) and (max-width: 767.98px) {
            main, .container {
                margin-top: 100px;
            }

            .modal-content{
                border-radius: 5px;
            }

            .modal-body{
                width: 95%;
                margin: auto;
            }

            .modal-footer{
                display: block;
            }

            .modal-footer .cancel{
                float: left;
                font-size: large;
            }

            .modal-footer .approve{
                float: right;
                font-size: large;
            }

            .image-bloc{
                margin-top: 25px;
            }

            .preview {
                width: 200px;
                height: 200px;
                border: 1px solid red;
                margin: auto;
                float: none;
            }
        }
    </style>
{% endblock %}
{% block header %}
    {{ parent() }}
{% endblock %}
{% block navigation %}{% endblock %}
{% block body %}
    {% set profileCompletionTotalWeight = 100 %}
    {% set profileCompletionScore = 0 %}
    {% set profileCompletionMissingItems = [] %}

    {# Identite (25) #}
    {% if avatar is defined and avatar %}
        {% set profileCompletionScore = profileCompletionScore + 5 %}
    {% else %}
        {% set profileCompletionMissingItems = profileCompletionMissingItems|merge(['Ajouter une photo de profil']) %}
    {% endif %}
    {% if last_name is defined and last_name|trim != '' %}
        {% set profileCompletionScore = profileCompletionScore + 4 %}
    {% else %}
        {% set profileCompletionMissingItems = profileCompletionMissingItems|merge(['Renseigner votre nom']) %}
    {% endif %}
    {% if first_name is defined and first_name|trim != '' %}
        {% set profileCompletionScore = profileCompletionScore + 4 %}
    {% else %}
        {% set profileCompletionMissingItems = profileCompletionMissingItems|merge(['Renseigner votre prenom']) %}
    {% endif %}
    {% if sexe is defined and sexe|trim != '' %}
        {% set profileCompletionScore = profileCompletionScore + 3 %}
    {% else %}
        {% set profileCompletionMissingItems = profileCompletionMissingItems|merge(['Selectionner votre sexe']) %}
    {% endif %}
    {% if bdaytime is defined and bdaytime|trim != '' %}
        {% set profileCompletionScore = profileCompletionScore + 5 %}
    {% else %}
        {% set profileCompletionMissingItems = profileCompletionMissingItems|merge(['Renseigner votre date de naissance']) %}
    {% endif %}
    {% if birth_place is defined and birth_place|trim != '' %}
        {% set profileCompletionScore = profileCompletionScore + 4 %}
    {% else %}
        {% set profileCompletionMissingItems = profileCompletionMissingItems|merge(['Renseigner votre lieu de naissance']) %}
    {% endif %}

    {# Contact et activite (20) #}
    {% if app.user and app.user.getEmailCanonical %}
        {% set profileCompletionScore = profileCompletionScore + 6 %}
    {% endif %}
    {% if telephone is defined and telephone|trim != '' %}
        {% set profileCompletionScore = profileCompletionScore + 4 %}
    {% else %}
        {% set profileCompletionMissingItems = profileCompletionMissingItems|merge(['Ajouter un numero de telephone']) %}
    {% endif %}
    {% if principal_activity is defined and principal_activity %}
        {% set profileCompletionScore = profileCompletionScore + 3 %}
    {% else %}
        {% set profileCompletionMissingItems = profileCompletionMissingItems|merge(['Choisir une activite principale']) %}
    {% endif %}
    {% if competence is defined and competence|length > 0 %}
        {% set profileCompletionScore = profileCompletionScore + 10 %}
    {% else %}
        {% set profileCompletionMissingItems = profileCompletionMissingItems|merge(['Ajouter au moins une competence']) %}
    {% endif %}
    {% if nom_commercial is defined and nom_commercial|trim != '' %}
        {% set profileCompletionScore = profileCompletionScore + 1 %}
    {% else %}
        {% set profileCompletionMissingItems = profileCompletionMissingItems|merge(['Renseigner un nom commercial']) %}
    {% endif %}
    {% if user.getUserUniqueData and user.getUserUniqueData.getDepartement %}
        {% set profileCompletionScore = profileCompletionScore + 1 %}
    {% else %}
        {% set profileCompletionMissingItems = profileCompletionMissingItems|merge(['Selectionner un departement']) %}
    {% endif %}

    {# Adresse domicile (15) #}
    {% if numeroNomRue_domicile is defined and numeroNomRue_domicile|trim != '' %}
        {% set profileCompletionScore = profileCompletionScore + 5 %}
    {% else %}
        {% set profileCompletionMissingItems = profileCompletionMissingItems|merge(['Renseigner votre adresse de domicile']) %}
    {% endif %}
    {% if codePostal_domicile is defined and codePostal_domicile|trim != '' %}
        {% set profileCompletionScore = profileCompletionScore + 3 %}
    {% else %}
        {% set profileCompletionMissingItems = profileCompletionMissingItems|merge(['Renseigner le code postal du domicile']) %}
    {% endif %}
    {% if ville_domicile is defined and ville_domicile|trim != '' %}
        {% set profileCompletionScore = profileCompletionScore + 3 %}
    {% else %}
        {% set profileCompletionMissingItems = profileCompletionMissingItems|merge(['Renseigner la ville du domicile']) %}
    {% endif %}
    {% if region_domicile is defined and region_domicile|trim != '' %}
        {% set profileCompletionScore = profileCompletionScore + 2 %}
    {% else %}
        {% set profileCompletionMissingItems = profileCompletionMissingItems|merge(['Renseigner la region du domicile']) %}
    {% endif %}
    {% if pays_domicile is defined and pays_domicile|trim != '' %}
        {% set profileCompletionScore = profileCompletionScore + 2 %}
    {% else %}
        {% set profileCompletionMissingItems = profileCompletionMissingItems|merge(['Renseigner le pays du domicile']) %}
    {% endif %}

    {# Contenu de profil (25) #}
    {% if description is defined and description|striptags|trim != '' %}
        {% set profileCompletionScore = profileCompletionScore + 20 %}
    {% else %}
        {% set profileCompletionMissingItems = profileCompletionMissingItems|merge(['Completer la description du profil']) %}
    {% endif %}
    {% if reference is defined and reference|striptags|trim != '' %}
        {% set profileCompletionScore = profileCompletionScore + 5 %}
    {% else %}
        {% set profileCompletionMissingItems = profileCompletionMissingItems|merge(['Ajouter des references']) %}
    {% endif %}

    {# Portfolio (15) #}
    {% if portfolio is defined and portfolio|length > 0 %}
        {% set profileCompletionScore = profileCompletionScore + 15 %}
    {% else %}
        {% set profileCompletionMissingItems = profileCompletionMissingItems|merge(['Ajouter au moins un element au portfolio']) %}
    {% endif %}

    {% set profileCompletionRate = profileCompletionScore %}
    {% if profile_completion_rate is defined and profile_completion_rate is not null %}
        {% set profileCompletionRate = profile_completion_rate %}
    {% endif %}
    {% if profileCompletionRate < 0 %}
        {% set profileCompletionRate = 0 %}
    {% elseif profileCompletionRate > 100 %}
        {% set profileCompletionRate = 100 %}
    {% endif %}

    {% set profileCompletionBarClass = 'bg-success' %}
    {% set profileCompletionBarStyle = '' %}
    {% if profileCompletionRate < 50 %}
        {% set profileCompletionBarClass = 'bg-danger' %}
    {% elseif profileCompletionRate < 80 %}
        {% set profileCompletionBarClass = '' %}
        {% set profileCompletionBarStyle = 'background-color: #fd7e14;' %}
    {% endif %}

    <div class="flex-fill container">
        <main class="">
            <div class="container mt-2 pt-4">
                {% include 'menuProfile.html.twig' %}
                <div class="profile-completion-wrapper mb-3">
                    <div class="profile-completion-label">
                        Taux de remplissage du profil: {{ profileCompletionRate }}%
                    </div>
                    <div class="progress" style="height: 16px;">
                        <div class="progress-bar {{ profileCompletionBarClass }}" role="progressbar"
                             style="{{ profileCompletionBarStyle }} width: {{ profileCompletionRate }}%;"
                             aria-valuenow="{{ profileCompletionRate }}"
                             aria-valuemin="0"
                             aria-valuemax="100">
                            {{ profileCompletionRate }}%
                        </div>
                    </div>
                    {% if profileCompletionRate < 80 %}
                        <small class="text-danger d-block mt-2">
                            Votre taux de remplissage doit être >= 80% pour que votre profil soit publié.
                        </small>
                    {% endif %}
                    {% if profileCompletionMissingItems is not empty %}
                        <div class="profile-completion-missing">
                            <div class="profile-completion-missing-title">
                                Il vous reste à compléter :
                            </div>
                            <ul class="profile-completion-missing-list">
                                {% for missingItem in profileCompletionMissingItems %}
                                    <li>{{ missingItem }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endif %}
                </div>
                {% if app.user and ('ROLE_AUTO_ENTREPRENEUR' in app.user.roles or 'ROLE_SOCIETE' in app.user.roles) %}
                    <div class="trust-agent-card">
                        <h3>Trouver mes informations automatiquement avec TrustAgent</h3>
                        <p>
                            Saisissez le nom de votre studio ou votre site web. TrustAgent collecte les donnees publiques, prepare des suggestions, puis vous validez chaque champ avant application.
                        </p>
                        <div class="trust-agent-actions">
                            <button type="button" id="trustAgentLaunchBtn" class="trust-agent-btn">
                                Lancer TrustAgent
                            </button>
                            <button type="button" id="trustAgentReviewBtn" class="trust-agent-btn is-secondary" disabled>
                                V&eacute;rifier les informations
                            </button>
                        </div>
                        <div id="trustAgentStatus" class="trust-agent-status"></div>
                    </div>
                {% endif %}
                <div class="mb-3">
                    {% for message in app.flashes('noticeErrorDate') %}
                        <div class="col-md-12 alert alert-warning alert-dismissible fade show" role="alert">
                            <span>{{ message }}</span>
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                    {% endfor %}
                    {% for message in app.flashes('notice') %}
                        <div class="col-md-12 alert alert-warning alert-dismissible fade show" role="alert">
                            <span>{{ message }}</span>
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                    {% endfor %}
                </div>
                <div class="mt-3">
                    <!-- Lecture des infos -->
                    <div class="row mt-4">
                        <div class="col-md-3 mb-2">
                            <div class="profile-section-title-row">
                                <h2 class="text-left mb-0 profile-section-title">Identit&eacute;, contact et activit&eacute;</h2>
                                {% if app.user %}
                                    {% if app.user.isVerified %}
                                        <span class="profile-email-status is-verified" aria-label="Email de compte vérifié.">
                                            <span class="profile-email-tooltip">
                                                <span class="profile-email-tooltip-text">Email de compte vérifié.</span>
                                            </span>
                                        </span>
                                    {% else %}
                                        <span class="profile-email-status is-unverified" tabindex="0" aria-label="Email non vérifié.">
                                            <span class="profile-email-tooltip">
                                                <span class="profile-email-tooltip-text">Email non vérifié.</span>
                                                <a class="profile-email-tooltip-link" href="{{ path('app_registration_resend_activation_email') }}">Recevoir email d’activation</a>
                                            </span>
                                        </span>
                                    {% endif %}
                                {% endif %}
                            </div>
                        </div>
                    </div>
                    <div id="lectureInfo" class="row">
                        <div class="col-md-3 mb-2">
                            <img class="img-fluid m-auto preview-avatar" width="100% \9"
                                 src="{% if avatar %}{{ avatar }}{% else %}{{ asset('assets/img/profile/avatar-profile.png') }}{% endif %}" alt="">
                        </div>
                        <div class="col-md-4">
                            <p class="user-info-text">{{ 'profil-utilisateur.formulaire-profil.nom'|trans }}:
                                <span>{{ last_name }}</span>
                            </p>
                            {# Go to next line #}
                            <p class="user-info-text">{{ 'profil-utilisateur.formulaire-profil.prenom'|trans }}:
                                <span>{{ first_name }}</span>
                            </p>
                            <p class="user-info-text">{{ 'profil-utilisateur.formulaire-profil.sexe'|trans }}:
                                <span>{{ sexe|trans }}</span>
                            </p>
                            <p class="user-info-text">{{ 'profil-utilisateur.formulaire-profil.date-de-naissance'|trans }}
                                :
                                <span>{{ bdaytime }}</span>
