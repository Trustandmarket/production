{% set switch_form_prefix = switch_form_prefix|default('professional-switch') %}

<div id="{{ switch_form_prefix }}-wrapper" class="mt-4 d-none">
    <div class="border p-4 bg-white professional-switch-card">
        <div class="mb-3 text-center">
            <h3 class="h5 mb-2">Renseignez les informations de votre entreprise</h3>
            <p class="mb-0" id="{{ switch_form_prefix }}-help">
                Completez ce formulaire pour passer a un profil <strong>professionnel</strong>.
            </p>
        </div>

        <form id="{{ switch_form_prefix }}-form" method="post" action="{{ path('profile_app_switch') }}">
            <input type="hidden" name="user_new_role" id="{{ switch_form_prefix }}-role" value="">

            <div class="form-group">
                <label for="{{ switch_form_prefix }}-adresse">Adresse *</label>
                <input type="text" id="{{ switch_form_prefix }}-adresse" name="adresse" value="{{ numeroNomRue|default('') }}" class="form-control" placeholder="Adresse" required>
            </div>

            <div class="form-group">
                <label for="{{ switch_form_prefix }}-ville">Ville *</label>
                <input type="text" id="{{ switch_form_prefix }}-ville" name="ville" value="{{ ville|default('') }}" class="form-control" placeholder="Ville" required>
            </div>

            <div class="form-group">
                <label for="{{ switch_form_prefix }}-pays">Pays *</label>
                <select id="{{ switch_form_prefix }}-pays" name="pays" class="form-control" required>
                    <option value="">Pays de residence...</option>
                    {% include 'countryProfile.html.twig' %}
                </select>
            </div>

            <div class="form-group">
                <label for="{{ switch_form_prefix }}-postal_code">Code postal *</label>
                <input type="text" id="{{ switch_form_prefix }}-postal_code" name="postal_code" value="{{ codePostal|default('') }}" class="form-control" placeholder="Code postal" required>
            </div>

            <div class="form-group">
                <label for="{{ switch_form_prefix }}-region">Region *</label>
                <input type="text" id="{{ switch_form_prefix }}-region" name="region" value="{{ etatComte|default('') }}" class="form-control" placeholder="Region" required>
            </div>

            <div class="form-group">
                <label for="{{ switch_form_prefix }}-compagny_number">Siret *</label>
                <input type="text" id="{{ switch_form_prefix }}-compagny_number" name="compagny_number" value="{{ siret|default('') }}" class="form-control" placeholder="Siret" required>
            </div>

            <div class="form-group">
                <label for="{{ switch_form_prefix }}-compagny_name">Denomination sociale *</label>
                <input type="text" id="{{ switch_form_prefix }}-compagny_name" name="compagny_name" value="{{ nomEntreprise|default('') }}" class="form-control" placeholder="Denomination sociale" required>
            </div>

            <div class="form-group">
                <label for="{{ switch_form_prefix }}-activite">{{ 'profil-utilisateur.formulaire-profil.activite'|trans }} *</label>
                <select id="{{ switch_form_prefix }}-activite" name="activite" class="form-control" required>
                    <option value="">{{ 'profil-utilisateur.formulaire-profil.activite'|trans }}</option>
                    {% for item in activities|default([]) %}
                        <option value="{{ item.termId }}" {% if current_activity_id is defined and current_activity_id and item.termId == current_activity_id %}selected{% endif %}>
                            {% if app.request.locale == 'en' %}{{ item.content }}{% else %}{{ item.name }}{% endif %}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div id="{{ switch_form_prefix }}-errors" class="alert alert-danger d-none mb-3" role="alert"></div>

            <div class="d-flex justify-content-between align-items-center mt-4 professional-switch-actions">
                <button type="button" class="btn btn-secondary" id="{{ switch_form_prefix }}-cancel">Annuler</button>
                <button type="submit" class="btn btn-bg-primary" id="{{ switch_form_prefix }}-submit">Valider</button>
            </div>
        </form>
    </div>
</div>
