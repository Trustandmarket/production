{% extends 'profileTemplate.html.twig' %}

{% block head %}
    {{ parent() }}

{% endblock %}

{% block title %}
    Trust &amp; Market | Fournisseur de services{% endblock %}

{% block style %}
    {{ parent() }}

    <link href="{{ preload(asset('assets/css/style-fournisseur.css')) }}" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('toastr/toastr.min.css') }}">

    <link href="{{ asset('assets/css/abonner-fournisseur.css') }}" rel="stylesheet">
    <link href="{{ preload(asset('assets/css/customeFournisseur.css')) }}" rel="stylesheet">
    <link href="{{ absolute_url(asset('assets/css/style.css')) }}" rel="stylesheet">

    <link rel="stylesheet" href="{{ asset('assets/css/tagsinput/tagify.css') }}">
    <!-- owl carousel css -->
    <link rel="stylesheet" type="text/css"
          href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css">
    <link rel="stylesheet" type="text/css"
          href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.theme.default.min.css">
{% endblock %}


{% block header %}

    {{ parent() }}
    <style>
        .image_picker_image {
            width: 100px;
            height: 100px
        }

        .tox-statusbar__branding {
            display: none;
        }

        .btn-bg-primary {
            color: #fff;
            background: #f17b30 !important;
        }

        .btn-bg-primary:hover {
            color: #fff;
            background: #f4b279 !important;
        }

        .btn-bg-details-button {
            color: #fff;
            background: #008778 !important;
        }

        .professional-switch-card {
            border-radius: 25px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        }

        .professional-switch-role {
            display: inline-block;
            padding: 0 6px;
            border-radius: 6px;
            background: #f3f3f3;
            color: #262626;
            font-family: Arial, Helvetica, sans-serif !important;
            font-size: 0.98em;
            font-weight: 700 !important;
            letter-spacing: 0.01em;
        }

        @media (max-width: 575.98px) {
            main, .container {
                margin-top: 70px;
            }

            .professional-switch-actions {
                gap: 12px;
                flex-direction: column;
            }
        }

        @media (min-width: 576px) and (max-width: 767.98px) {
            main, .container {
                margin-top: 100px;
            }
        }
    </style>


{% endblock %}

{% block navigation %}{% endblock %}

{% block body %}
    <div class="flex-fill container">
        <main class="">
            <div class="container mt-2 pt-4">
                {% include 'menuProfile.html.twig' %}
                <div class="mt-3">
                    <div class="m-auto" style="max-width: 500px">
                        <p class="border border-dark text-center p-3 fs-18 pre-config-txt"
                           style="width: 100%; border-radius: 25px;">
                            {{ 'profil-utilisateur.fournisseurs-abonne.texte'|trans|raw }}
                            <strong>{{ 'profil-utilisateur.fournisseurs-abonne.auto-entrepreneur'|trans|raw }}</strong>
                            {{ 'profil-utilisateur.fournisseurs-abonne.ou'|trans|raw }}
                            <strong>{{ 'profil-utilisateur.fournisseurs-abonne.societe'|trans|raw }}</strong>
                        </p>
                        <div class="d-flex justify-content-between flex-wrap" style="gap: 12px;">
                            <button
                                id="passer-entrepreneur"
                                type="button"
                                class="btn btn-md fl-uppercase rounded config-btn enregProfile js-open-professional-form"
                                data-role="ROLE_AUTO_ENTREPRENEUR"
                                data-role-label="{{ 'profil-utilisateur.fournisseurs-abonne.auto-entrepreneur'|trans }}"
                            >
                                {{ 'profil-utilisateur.fournisseurs-abonne.passez-auto-entrepreneur'|trans }}
                            </button>
                            <button
                                type="button"
                                id="passer-societe"
                                class="btn btn-md fl-uppercase rounded config-btn enregProfile1 js-open-professional-form"
                                data-role="ROLE_SOCIETE"
                                data-role-label="{{ 'profil-utilisateur.fournisseurs-abonne.societe'|trans }}"
                            >
                                {{ 'profil-utilisateur.fournisseurs-abonne.passez-societe'|trans }}
                            </button>
                        </div>
                        {% include 'profile/_professional_switch_form.html.twig' %}
                    </div>
                </div>
            </div>
            {% include("partials/project.html.twig") %}
            {% include("partials/otherPagesVideoModal.html.twig") %}
        </main>
    </div>
{% endblock %}


{% block footer %}
    {{ parent() }}

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('toastr/toastr.min.js') }}"></script>
    <script>
        $(document).ready(function () {
            var docWidth = document.documentElement.offsetWidth;
            var initialValues = {
                adresse: '{{ numeroNomRue|default('')|e('js') }}',
                ville: '{{ ville|default('')|e('js') }}',
                pays: '{{ pays|default('')|e('js') }}',
                postal_code: '{{ codePostal|default('')|e('js') }}',
                region: '{{ etatComte|default('')|e('js') }}',
                compagny_number: '{{ siret|default('')|e('js') }}',
                compagny_name: '{{ nomEntreprise|default('')|e('js') }}'
            };

            [].forEach.call(document.querySelectorAll('*'), function (el) {
                if (el.offsetWidth > docWidth) {
                    console.log(el);
                }
            });

            var $switchWrapper = $('#professional-switch-form-wrapper');
            var $switchForm = $('#professional-switch-form');
            var $switchErrors = $('#professional-switch-form-errors');
            var $switchRole = $('#professional-switch-role');
            var $switchHelp = $('#professional-switch-form-help');
            var defaultHelpText = 'Completez ce formulaire pour passer a un profil <span class="professional-switch-role">professionnel</span>.';

            function resetProfessionalForm() {
                $('#adresse').val(initialValues.adresse);
                $('#ville').val(initialValues.ville);
                $('#pays').val(initialValues.pays);
                $('#postal_code').val(initialValues.postal_code);
                $('#region').val(initialValues.region);
                $('#compagny_number').val(initialValues.compagny_number);
                $('#compagny_name').val(initialValues.compagny_name);
                $switchRole.val('');
                $switchHelp.html(defaultHelpText);
                $switchErrors.addClass('d-none').empty();
            }

            $('.js-open-professional-form').on('click', function () {
                var role = $(this).data('role');
                var roleLabel = $(this).data('role-label');

                $switchRole.val(role);
                $switchHelp.html('Completez ce formulaire pour passer au profil <span class="professional-switch-role">' + roleLabel + '</span>.');
                $switchErrors.addClass('d-none').empty();
                $switchWrapper.removeClass('d-none');

                $('html, body').animate({
                    scrollTop: $switchWrapper.offset().top - 40
                }, 300);
            });

            $('#professional-switch-cancel').on('click', function () {
                resetProfessionalForm();
                $switchWrapper.addClass('d-none');
            });

            $switchForm.on('submit', function (e) {
                e.preventDefault();

                var payload = {
                    adresse: $('#adresse').val().trim(),
                    ville: $('#ville').val().trim(),
                    pays: $('#pays').val(),
                    postal_code: $('#postal_code').val().trim(),
                    region: $('#region').val().trim(),
                    compagny_number: $('#compagny_number').val().trim(),
                    compagny_name: $('#compagny_name').val().trim(),
                    user_new_role: $switchRole.val()
                };

                if (!payload.user_new_role) {
                    $switchErrors.removeClass('d-none').text('Veuillez d abord choisir le profil souhaite.');
                    return;
                }

                if (!payload.adresse || !payload.ville || !payload.pays || !payload.postal_code || !payload.region || !payload.compagny_number || !payload.compagny_name) {
                    $switchErrors.removeClass('d-none').text('Veuillez remplir les champs du formulaire.');
                    return;
                }

                $switchErrors.addClass('d-none').empty();

                $.ajax({
                    url: "{{ path('profile_app_switch') }}",
                    type: 'POST',
                    processData: false,
                    dataType: 'json',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function (response) {
                        if (response.status == 200) {
                            toastr.success('Mise a jour du profil effectuee avec succes.');
                            window.location = '{{ path('profile_profile' ) }}';
                        } else {
                            $switchErrors.removeClass('d-none').text(response.error || 'Un probleme est survenu.');
                        }
                    },
                    error: function (xhr) {
                        var message = 'Un probleme est survenu.';

                        if (xhr.responseJSON && xhr.responseJSON.error) {
                            message = xhr.responseJSON.error;
                        } else if (xhr.responseText) {
                            message = xhr.responseText;
                        }

                        $switchErrors.removeClass('d-none').text(message);
                    }
                });
            });

            toastr.options = {
                "closeButton": true,
                "debug": false,
                "newestOnTop": false,
                "progressBar": true,
                "positionClass": "toast-top-center",
                "preventDuplicates": false,
                "onclick": null,
                "showDuration": "300",
                "hideDuration": "1000",
                "timeOut": "12000",
                "extendedTimeOut": "1000",
                "showEasing": "swing",
                "hideEasing": "linear",
                "showMethod": "fadeIn",
                "hideMethod": "fadeOut"
            };
        });
    </script>
{% endblock %}
