{% extends 'profileTemplate.html.twig' %}

{% block head %}
    {{ parent() }}

{% endblock %}

{% block title %}
    Trust &amp; Market | Fournisseur de services{% endblock %}

{% block style %}
    {{ parent() }}
    <link href="{{ preload(asset('assets/css/style-fournisseur.css')) }}" rel="stylesheet">
    <link href="{{ preload(asset('assets/css/customeFournisseur.css')) }}" rel="stylesheet">
    <link href="{{ absolute_url(asset('assets/css/style.css')) }}" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('toastr/toastr.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/phone/css/intlTelInput.css') }}">
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.18/dist/sweetalert2.min.css" rel="stylesheet">
{% endblock %}

{% block header %}
    {{ parent() }}
    <style>
        .image_picker_image {
            width: 100px;
            height: 100px
        }

        .tox-statusbar__branding {
            display: none;
        }

        .btn-bg-primary {
            color: #fff;
            background: #f17b30 !important;
        }

        .btn-bg-primary:hover {
            color: #fff;
            background: #f4b279 !important;
        }

        .swal2-icon {
            color: #FF7E10 !important;
            border-color: #FF7E10 !important;
        }

        .swal2-cancel {
            background-color: #262626 !important;
        }

        .swal2-confirm {
            background-color: #FF7E10 !important;
        }

        .swal2-container {
            zoom: 0.7;
        }

        .phone-field-label {
            position: static !important;
            display: block !important;
            margin-bottom: 0.5rem !important;
            transform: none !important;
            color: #757575 !important;
            pointer-events: auto !important;
        }

        .trust-agent-card {
            position: relative;
            overflow: hidden;
            border-radius: 18px;
            padding: 1.5rem;
            margin: 1.25rem 0 1.75rem;
            background:
                radial-gradient(circle at top right, rgba(255, 194, 120, 0.35), transparent 36%),
                linear-gradient(135deg, #1f2937 0%, #111827 55%, #0f172a 100%);
            color: #fff;
            box-shadow: 0 20px 40px rgba(15, 23, 42, 0.18);
        }

        .trust-agent-card::after {
            content: "";
            position: absolute;
            inset: auto -60px -60px auto;
            width: 180px;
            height: 180px;
            border-radius: 999px;
            background: rgba(255, 126, 16, 0.16);
            filter: blur(2px);
        }

        .trust-agent-card h3 {
            margin-bottom: 0.5rem;
            font-weight: 700;
        }

        .trust-agent-card p {
            position: relative;
            z-index: 1;
            max-width: 780px;
            margin-bottom: 1rem;
            color: rgba(255, 255, 255, 0.86);
        }

        .trust-agent-actions {
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            gap: 0.85rem;
            flex-wrap: wrap;
        }

        .trust-agent-btn {
            border: 0;
            border-radius: 999px;
            padding: 0.95rem 1.35rem;
            font-weight: 700;
            color: #111827;
            background: linear-gradient(135deg, #ffd79c 0%, #ff7e10 100%);
            box-shadow: 0 10px 24px rgba(255, 126, 16, 0.32);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .trust-agent-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 14px 28px rgba(255, 126, 16, 0.38);
        }

        .trust-agent-status {
            display: none;
            margin-top: 1rem;
            padding: 0.9rem 1rem;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.08);
            color: #fff;
            position: relative;
            z-index: 1;
        }

        .trust-agent-status.is-visible {
            display: block;
        }

        .tm-ta-review-note {
            margin-bottom: 1rem;
            padding: 0.9rem 1rem;
            border-radius: 12px;
            background: #fff7ed;
            color: #9a3412;
            font-size: 0.95rem;
            text-align: left;
        }

        .tm-ta-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 14px;
            text-align: left;
        }

        .tm-ta-card {
            border: 1px solid #e5e7eb;
            border-radius: 14px;
            padding: 14px;
            background: #fff;
        }

        .tm-ta-card-address {
            grid-column: 1 / -1;
        }

        .tm-ta-head {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 8px;
            margin-bottom: 10px;
        }

        .tm-ta-head label {
            margin: 0;
            font-weight: 700;
            color: #111827;
        }

        .tm-ta-meta {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            color: #475569;
            background: #f8fafc;
            border-radius: 999px;
            padding: 4px 10px;
            white-space: nowrap;
        }

        .tm-ta-card .form-control,
        .tm-ta-card .custom-select {
            border-radius: 10px;
            min-height: 44px;
        }

        .tm-ta-address-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
            gap: 10px;
        }

        .tm-ta-helper {
            font-size: 12px;
            color: #64748b;
            margin-top: 8px;
        }


        @media (max-width: 575.98px) {
            main, .container {
                margin-top: 70px;
            }

            .swal2-container {
                zoom: 0.67 !important;
            }

            .swal2-title {
                font-size: 1.275em !important;
            }
        }

        @media (min-width: 576px) and (max-width: 767.98px) {
            main, .container {
                margin-top: 100px;
            }

            .swal2-container {
                zoom: 0.65 !important;
            }

            .swal2-title {
                font-size: 1.475em !important;
            }
        }
    </style>


{% endblock %}

{% block navigation %}{% endblock %}

{% block body %}
    <div class="flex-fill container">
        <main class="">
            <div class="container mt-2 pt-4">
                {% include 'menuProfile.html.twig' %}
                <div class="my-2">
                    <p>
                        {{ 'profil-utilisateur.fournisseurs.description'|trans }}
                    </p>
                </div>
                <div class="trust-agent-card">
                    <h3>TrustAgent peut pre-remplir vos informations fournisseur</h3>
                    <p>
                        Saisissez le nom de votre studio ou votre site web. TrustAgent analyse les donnees publiques,
                        vous propose des corrections, puis vous gardez la main avant application.
                    </p>
                    <div class="trust-agent-actions">
                        <button type="button" id="trustAgentLaunchBtn" class="trust-agent-btn">
                            Trouver mes informations automatiquement avec TrustAgent
                        </button>
                        <span>La modale affiche toutes les suggestions du profil avant validation.</span>
                    </div>
                    <div id="trustAgentStatus" class="trust-agent-status"></div>
                </div>
                <div class="mt-2">
                    <!-- Modif des infos -->
                    <div id="modifInfo">
                        <div class="row">
                            {% for message in app.flashes('notice') %}
                                <div class="col-md-12 alert alert-warning alert-dismissible fade show" role="alert">
                                    <strong>{{ message }}</strong>
                                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                </div>
                            {% endfor %}
                            <form class="col-md-12"
                                  action="{{ path('profile_updateBillingProfileData') }}" id="updateBillingProfileData"
                                  method="post">
                                <div class="row">
                                    <h3 class="col-md-12">{{ 'profil-utilisateur.fournisseurs.formulaire-details-facture-titre'|trans }}</h3>
                                    <div class="col-md-6">
                                        <div class="md-form">
                                            <input type="text" id="siret" name="siret" class="form-control" required
                                                   value="{{ siret }}">
                                            <label for="siret">SIRET</label>
                                        </div>
                                        <div class="md-form">
                                            <input type="text" id="tva" name="tva" class="form-control"
                                                   value="{{ tva }}">
                                            <label for="tva">TVA</label>
                                        </div>
                                        <div class="md-form">
                                            <input type="text" id="nomEntreprise" name="nomEntreprise"
                                                   class="form-control" value="{{ nomEntreprise }}">
                                            <label for="nomEntreprise">{{ 'profil-utilisateur.fournisseurs.formulaire-details-facture-nom-entreprise'|trans }}</label>
                                        </div>
                                        <div class="md-form">
                                            <strong>{{ 'profil-utilisateur.fournisseurs.formulaire-details-facture-pays'|trans }}
                                                *</strong>
                                            <select id="pays" name="pays" class="browser-default custom-select"
                                                    required>
                                                {% include 'countryProfile.html.twig' %}
                                            </select>
                                        </div>
                                        <div class="md-form">
                                            <input type="text" id="numeroNomRue" name="numeroNomRue"
                                                   class="form-control" required value="{{ numeroNomRue }}">
                                            <label for="numeroNomRue">{{ 'profil-utilisateur.fournisseurs.formulaire-details-facture-numero-rue'|trans }}
                                                *</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="md-form">
                                            <input type="text" id="etatComte" name="etatComte" class="form-control"
                                                   required {% if etatComte is not null %} value="{{ etatComte }}" {% endif %}>
                                            <label for="etatComte">{{ 'profil-utilisateur.fournisseurs.formulaire-details-facture-etat-comte'|trans }}
                                                *</label>
                                        </div>
                                        <div class="md-form">
                                            <label for="telephone" class="phone-field-label active">{{ 'profil-utilisateur.formulaire-profil.telephone'|trans }}</label>
                                            <input type="text" id="telephone" name="telephone" class="form-control"
                                                   value="{{ telephone }}">
                                        </div>
                                        <div class="md-form">
                                            <input type="email" id="email" name="email" class="form-control" required
                                                   value="{{ email }}">
                                            <label for="email">{{ 'profil-utilisateur.fournisseurs.formulaire-details-facture-email'|trans }}
                                                *</label>
                                        </div>
                                        <div class="md-form mt-5">
                                            <input type="text" id="codePostal" name="codePostal" class="form-control"
                                                   required value="{{ codePostal }}">
                                            <label for="codePostal">{{ 'profil-utilisateur.fournisseurs.formulaire-details-facture-code-postal'|trans }}
                                                *</label>
                                        </div>
                                        <div class="md-form mt-4">
                                            <input type="text" id="ville" name="ville" class="form-control" required
                                                   value="{{ ville }}">
                                            <label for="ville">{{ 'profil-utilisateur.fournisseurs.formulaire-details-facture-ville'|trans }}
                                                *</label>
                                        </div>
                                        <div class="text-right" style="margin-top: 0.15rem;">
                                            <button id="enregProfile2" class="btn btn-md btn-success p-3"
                                                    type="submit">
                                                {{ 'profil-utilisateur.fournisseurs.formulaire-details-facture-bouton-confirmer'|trans }}
                                            </button>
                                        </div>
                                </div>
                                </div>
                            </form>
                            {% if app.user.roles.0 == "ROLE_AUTO_ENTREPRENEUR" %}
                                <div style="margin-top: 0.15rem; border-top: 2px solid #000;"></div>
                                <div class="mt-3">
                                    <div class="border p-4 bg-white professional-switch-card">
                                        <div class="mb-3">
                                            <h3 class="h5 mb-2">Passage vers un profil societe</h3>
                                            <p class="mb-3">
                                                Votre profil actuel est <span class="professional-switch-role">auto-entrepreneur</span>.
                                                Si votre activite evolue, vous pouvez demander le passage au profil
                                                <span class="professional-switch-role">societe</span> avec un formulaire dedie.
                                            </p>
                                            <button id="societe"
                                                    type="button"
                                                    class="btn btn-md p-3 js-open-company-switch-form"
                                                    data-role="ROLE_SOCIETE"
                                                    data-role-label="{{ 'profil-utilisateur.fournisseurs-abonne.societe'|trans }}">
                                                {{ 'profil-utilisateur.fournisseurs-abonne.passez-societe'|trans }}
                                            </button>
                                        </div>
                                        {% include 'profile/_professional_switch_form.html.twig' with { switch_form_prefix: 'company-switch' } %}
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                    <!-- Fin des modifs -->
                </div>
            </div>
            {% include("partials/project.html.twig") %}
            {% include("partials/otherPagesVideoModal.html.twig") %}
        </main>
    </div>
{% endblock %}
	{% block footer %}
        {{ parent() }}
    {% endblock %}

    {% block javascripts %}
        {{ parent() }}
        <script src="{{ asset('toastr/toastr.min.js') }}"></script>
        <script src="{{ asset('assets/phone/js/intlTelInput.min.js') }}"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.18/dist/sweetalert2.all.min.js"></script>

        <script>
            $(document).ready(function () {
                var docWidth = document.documentElement.offsetWidth;
                var companySwitchInitialValues = {
                    adresse: '{{ numeroNomRue|default('')|e('js') }}',
                    ville: '{{ ville|default('')|e('js') }}',
                    pays: '{{ pays|default('')|e('js') }}',
                    postal_code: '{{ codePostal|default('')|e('js') }}',
                    region: '{{ etatComte|default('')|e('js') }}',
                    compagny_number: '{{ siret|default('')|e('js') }}',
                    compagny_name: '{{ nomEntreprise|default('')|e('js') }}',
                    activite: '{{ current_activity_id|default('')|e('js') }}'
                };
                [].forEach.call(document.querySelectorAll('*'), function (el) {
                    if (el.offsetWidth > docWidth) {
                        console.log(el);
                    }
                });

// Hamburger menu icon
                $('.animated-button-icon').on('click', function () {
                    $('.animated-icon2').toggleClass('open');
                });
// first thing turn Hide Menu Search bar
                $("#searchMenu").hide();
// toggle menu search bar on/off
                $("#searchMenuShowHide").click(function () {
                    $("#searchMenu").toggle("slide");
                });

// Validation for phone number
                function validatePhoneNumber(phone) {
                    let re = /^(\+|00)[0-9]{1,3}[0-9 ]{4,20}(?:x.+)?$/;
                    return re.test(phone);
                }

                function validateEmail(email) {
                    let re = /^(([^<>()[\]\\.,;:\s@\"]+(\.[^<>()[\]\\.,;:\s@\"]+)*)|(\".+\"))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;
                    return re.test(email);
                }

                var trustAgentStatus = document.getElementById('trustAgentStatus');
                var trustAgentLaunchBtn = document.getElementById('trustAgentLaunchBtn');
                var TRUST_AGENT_FIELD_LABELS = {
                    business_name: 'Nom de l entreprise',
                    phone: 'Telephone',
                    addresses: 'Adresse',
                    main_activity: 'Activite principale',
                    skills: 'Competences',
                    experiences_text: 'Experiences',
                    project_references_text: 'References projets',
                    photos: 'Photos',
                    videos: 'Videos',
                    avatar_url: 'Avatar profil',
                    siret: 'SIRET',
                    tva_number: 'Numero TVA',
                    tva: 'Numero TVA'
                };

                function escapeHtml(value) {
                    return String(value === null || value === undefined ? '' : value)
                        .replace(/&/g, '&amp;')
                        .replace(/</g, '&lt;')
                        .replace(/>/g, '&gt;')
                        .replace(/"/g, '&quot;')
                        .replace(/'/g, '&#039;');
                }

                function setTrustAgentStatus(message, type) {
                    if (!trustAgentStatus) {
                        return;
                    }

                    trustAgentStatus.classList.add('is-visible');
                    trustAgentStatus.style.background = type === 'error'
                        ? 'rgba(153, 27, 27, 0.28)'
                        : (type === 'success' ? 'rgba(22, 101, 52, 0.26)' : 'rgba(255, 255, 255, 0.08)');
                    trustAgentStatus.innerHTML = message;
                }

                function clearTrustAgentStatus() {
                    if (!trustAgentStatus) {
                        return;
                    }

                    trustAgentStatus.classList.remove('is-visible');
                    trustAgentStatus.innerHTML = '';
                }

                function formatConfidence(value) {
                    if (typeof value !== 'number' || isNaN(value)) {
                        return '-';
                    }

                    return Math.round(value * 100) + '%';
                }

                function isLikelyWebsite(value) {
                    var trimmed = String(value || '').trim();
                    if (trimmed === '') {
                        return false;
                    }

                    return /^https?:\/\//i.test(trimmed) || /^[^\s]+\.[^\s]{2,}$/i.test(trimmed);
                }

                function getSuggestionWorkingValue(suggestion) {
                    if (String(suggestion.status || '') === 'edited' && suggestion.final_value !== null && suggestion.final_value !== undefined) {
                        return suggestion.final_value;
                    }

                    return suggestion.suggested_value;
                }

                function detectValueKind(value) {
                    if (Array.isArray(value)) {
                        return 'array';
                    }

                    if (value !== null && typeof value === 'object') {
                        return 'object';
                    }

                    return 'text';
                }

                function valueToEditorText(kind, value) {
                    if (kind === 'array' || kind === 'object') {
                        return JSON.stringify(value, null, 2);
                    }

                    return String(value === null || value === undefined ? '' : value);
                }

                function normalizeForCompare(value) {
                    if (Array.isArray(value)) {
                        return value.map(normalizeForCompare);
                    }

                    if (value !== null && typeof value === 'object') {
                        var sortedKeys = Object.keys(value).sort();
                        var normalized = {};
                        sortedKeys.forEach(function (key) {
                            normalized[key] = normalizeForCompare(value[key]);
                        });
                        return normalized;
                    }

                    return value;
                }

                function deepEqualValues(left, right) {
                    return JSON.stringify(normalizeForCompare(left)) === JSON.stringify(normalizeForCompare(right));
                }

                function parseEditorValue(entry, rawValue) {
                    if (entry.kind === 'array' || entry.kind === 'object') {
                        try {
                            var parsed = JSON.parse(rawValue);
                            if (entry.kind === 'array' && !Array.isArray(parsed)) {
                                throw new Error('Ce champ attend une liste JSON.');
                            }
                            if (entry.kind === 'object' && (parsed === null || Array.isArray(parsed) || typeof parsed !== 'object')) {
                                throw new Error('Ce champ attend un objet JSON.');
                            }
                            return parsed;
                        } catch (error) {
                            throw new Error('JSON invalide pour "' + entry.label + '".');
                        }
                    }

                    return String(rawValue || '').trim();
                }

                function getFieldLabel(fieldName) {
                    return TRUST_AGENT_FIELD_LABELS[fieldName] || fieldName;
                }

                function openTrustAgentEntryModal() {
                    var defaultInput = ($('#nomEntreprise').val() || '').trim();

                    return Swal.fire({
                        title: 'Trouver mes informations automatiquement avec TrustAgent',
                        width: 720,
                        focusConfirm: false,
                        showCancelButton: true,
                        confirmButtonText: 'Trouver mes informations',
                        cancelButtonText: 'Annuler',
                        html: `
                            <div class="text-left">
                                <p class="tm-ta-review-note">
                                    Renseignez soit le nom de votre studio, soit votre site web.
                                </p>
                                <div class="form-group text-left">
                                    <label class="d-block mb-2 font-weight-bold">Source a analyser</label>
                                    <div class="custom-control custom-radio mb-2">
                                        <input class="custom-control-input" type="radio" name="trustAgentInputType" id="trustAgentInputStudio" value="studio_name" checked>
                                        <label class="custom-control-label" for="trustAgentInputStudio">Nom du studio</label>
                                    </div>
                                    <div class="custom-control custom-radio">
                                        <input class="custom-control-input" type="radio" name="trustAgentInputType" id="trustAgentInputWebsite" value="website">
                                        <label class="custom-control-label" for="trustAgentInputWebsite">Site web</label>
                                    </div>
                                </div>
                                <div class="form-group text-left mb-0">
                                    <label for="trustAgentInputValue" class="font-weight-bold">Valeur a rechercher</label>
                                    <input type="text" id="trustAgentInputValue" class="form-control" value="${escapeHtml(defaultInput)}" placeholder="Ex : Studio Rivoli">
                                </div>
                            </div>
                        `,
                        didOpen: function () {
                            var input = document.getElementById('trustAgentInputValue');
                            var studioRadio = document.getElementById('trustAgentInputStudio');
                            var websiteRadio = document.getElementById('trustAgentInputWebsite');

                            function refreshPlaceholder() {
                                if (!input || !studioRadio || !websiteRadio) {
                                    return;
                                }

                                input.placeholder = studioRadio.checked ? 'Ex : Studio Rivoli' : 'Ex : https://www.monsite.fr';
                                if (websiteRadio.checked && input.value.trim() === defaultInput) {
                                    input.value = '';
                                }
                            }

                            if (studioRadio) {
                                studioRadio.addEventListener('change', refreshPlaceholder);
                            }
                            if (websiteRadio) {
                                websiteRadio.addEventListener('change', refreshPlaceholder);
                            }
                            refreshPlaceholder();
                        },
                        preConfirm: function () {
                            var selected = document.querySelector('input[name="trustAgentInputType"]:checked');
                            var input = document.getElementById('trustAgentInputValue');
                            var inputType = selected ? selected.value : '';
                            var inputValue = input ? input.value.trim() : '';

                            if (!inputType) {
                                Swal.showValidationMessage('Choisissez une source.');
                                return false;
                            }

                            if (inputValue === '') {
                                Swal.showValidationMessage('Renseignez une valeur.');
                                return false;
                            }

                            if (inputType === 'website' && !isLikelyWebsite(inputValue)) {
                                Swal.showValidationMessage('Le site web semble invalide.');
                                return false;
                            }

                            return {
                                input_type: inputType,
                                input_value: inputValue
                            };
                        }
                    });
                }

                async function createOrReuseEnrichmentJob(payload) {
                    var response = await fetch('/enrichment-jobs', {
                        method: 'POST',
                        credentials: 'include',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(payload)
                    });

                    var data = await response.json().catch(function () {
                        return { ok: false, error: 'Reponse JSON invalide.' };
                    });

                    if (response.ok && data.ok) {
                        return data.job;
                    }

                    if (response.status === 409 && data.job && data.job.id) {
                        return data.job;
                    }

                    throw new Error(data.error || 'Impossible de creer le job d enrichissement.');
                }

                async function fetchEnrichmentJob(jobId) {
                    var response = await fetch('/enrichment-jobs/' + jobId, {
                        method: 'GET',
                        credentials: 'include'
                    });

                    var data = await response.json().catch(function () {
                        return { ok: false, error: 'Reponse JSON invalide.' };
                    });

                    if (!response.ok || !data.ok) {
                        throw new Error(data.error || 'Impossible de charger le job.');
                    }

                    return data;
                }

                async function pollJobUntilReview(jobId, timeoutMs, intervalMs) {
                    var startedAt = Date.now();

                    while ((Date.now() - startedAt) < timeoutMs) {
                        var payload = await fetchEnrichmentJob(jobId);
                        var job = payload.job || {};
                        var status = String(job.status || '');

                        setTrustAgentStatus(
                            'Job #' + jobId + ' en cours : <strong>' + escapeHtml(status || 'pending') + '</strong>',
                            'info'
                        );

                        if (status === 'awaiting_user') {
                            return payload;
                        }

                        if (status === 'failed') {
                            throw new Error(job.last_error || 'Le traitement a echoue.');
                        }

                        if (status === 'success') {
                            throw new Error('Ce job a deja ete applique.');
                        }

                        await new Promise(function (resolve) {
                            window.setTimeout(resolve, intervalMs);
                        });
                    }

                    throw new Error('La recherche prend plus de temps que prevu. Le job continue en arriere-plan.');
                }

                function buildTrustAgentReviewModel(payload) {
                    var suggestions = Array.isArray(payload.suggestions) ? payload.suggestions : [];
                    var model = {
                        jobId: payload.job && payload.job.id ? payload.job.id : null,
                        entries: []
                    };

                    suggestions.forEach(function (suggestion) {
                        var fieldName = String(suggestion.field_name || '').trim();
                        var suggestionId = Number(suggestion.id || 0);
                        if (!fieldName || suggestionId <= 0) {
                            return;
                        }

                        var workingValue = getSuggestionWorkingValue(suggestion);
                        var kind = detectValueKind(workingValue);
                        var selected = String(suggestion.status || 'suggested') !== 'rejected';

                        model.entries.push({
                            key: fieldName,
                            kind: kind,
                            suggestionId: suggestionId,
                            label: getFieldLabel(fieldName),
                            sourceType: suggestion.source_type || 'merged',
                            confidence: suggestion.confidence_score,
                            originalValue: workingValue,
                            editorValue: valueToEditorText(kind, workingValue),
                            selected: selected
                        });
                    });

                    return model;
                }

                function buildTrustAgentReviewHtml(model) {
                    var cards = model.entries.map(function (entry) {
                        var meta = escapeHtml(entry.sourceType) + ' - ' + escapeHtml(formatConfidence(entry.confidence));
                        var checkedAttr = entry.selected ? ' checked' : '';
                        var checkboxId = 'ta-use-' + entry.suggestionId;
                        var valueId = 'ta-value-' + entry.suggestionId;
                        var helper = '';
                        var editor;
                        var cardClass = entry.kind === 'text' ? 'tm-ta-card' : 'tm-ta-card tm-ta-card-address';

                        if (entry.kind === 'array') {
                            helper = '<div class="tm-ta-helper">Format attendu : liste JSON.</div>';
                            editor = '<textarea id="' + valueId + '" class="form-control" rows="6">' + escapeHtml(entry.editorValue) + '</textarea>';
                        } else if (entry.kind === 'object') {
                            helper = '<div class="tm-ta-helper">Format attendu : objet JSON.</div>';
                            editor = '<textarea id="' + valueId + '" class="form-control" rows="6">' + escapeHtml(entry.editorValue) + '</textarea>';
                        } else {
                            editor = '<input type="text" id="' + valueId + '" class="form-control" value="' + escapeHtml(entry.editorValue) + '">';
                        }

                        return `
                            <div class="${cardClass}">
                                <div class="tm-ta-head">
                                    <label><input type="checkbox" id="${checkboxId}"${checkedAttr}> ${escapeHtml(entry.label)}</label>
                                    <span class="tm-ta-meta">${meta}</span>
                                </div>
                                ${editor}
                                ${helper}
                            </div>
                        `;
                    }).join('');

                    return `
                        <div class="tm-ta-review-note">
                            Verifiez toutes les suggestions puis confirmez. Les champs non coches seront rejetes pour ce job.
                        </div>
                        <div class="tm-ta-grid">${cards}</div>
                    `;
                }

                function buildDecisionsFromTrustAgentReview(model) {
                    var decisions = [];

                    model.entries.forEach(function (entry) {
                        var useCheckbox = document.getElementById('ta-use-' + entry.suggestionId);
                        var shouldUse = useCheckbox ? useCheckbox.checked : false;

                        if (!shouldUse) {
                            decisions.push({
                                suggestion_id: entry.suggestionId,
                                status: 'rejected'
                            });
                            return;
                        }

                        var input = document.getElementById('ta-value-' + entry.suggestionId);
                        var rawValue = input ? String(input.value || '') : '';
                        if (rawValue.trim() === '') {
                            decisions.push({
                                suggestion_id: entry.suggestionId,
                                status: 'rejected'
                            });
                            return;
                        }

                        var parsedValue = parseEditorValue(entry, rawValue);
                        var isUnchanged = deepEqualValues(parsedValue, entry.originalValue);

                        if (isUnchanged) {
                            decisions.push({
                                suggestion_id: entry.suggestionId,
                                status: 'accepted'
                            });
                        } else {
                            decisions.push({
                                suggestion_id: entry.suggestionId,
                                status: 'edited',
                                final_value: parsedValue
                            });
                        }
                    });

                    return decisions;
                }

                async function saveJobDecisions(jobId, decisions) {
                    var response = await fetch('/enrichment-jobs/' + jobId + '/decisions', {
                        method: 'POST',
                        credentials: 'include',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ decisions: decisions })
                    });

                    var data = await response.json().catch(function () {
                        return { ok: false, error: 'Reponse JSON invalide.' };
                    });

                    if (!response.ok || !data.ok) {
                        throw new Error(data.error || 'Impossible d enregistrer vos decisions.');
                    }

                    return data;
                }

                async function applyJobDecisions(jobId) {
                    var response = await fetch('/enrichment-jobs/' + jobId + '/apply', {
                        method: 'POST',
                        credentials: 'include'
                    });

                    var data = await response.json().catch(function () {
                        return { ok: false, error: 'Reponse JSON invalide.' };
                    });

                    if (!response.ok || !data.ok) {
                        throw new Error(data.error || 'Impossible d appliquer les suggestions.');
                    }

                    return data;
                }

                async function openTrustAgentReviewModal(payload) {
                    var model = buildTrustAgentReviewModel(payload);

                    if (!model.entries.length) {
                        throw new Error('Aucune suggestion exploitable n a ete trouvee pour ce job.');
                    }

                    var result = await Swal.fire({
                        title: 'Verifier toutes les suggestions TrustAgent',
                        width: 960,
                        showCancelButton: true,
                        confirmButtonText: 'Appliquer les suggestions',
                        cancelButtonText: 'Fermer',
                        focusConfirm: false,
                        allowOutsideClick: function () {
                            return !Swal.isLoading();
                        },
                        html: buildTrustAgentReviewHtml(model),
                        preConfirm: async function () {
                            try {
                                var decisions = buildDecisionsFromTrustAgentReview(model);
                                await saveJobDecisions(model.jobId, decisions);
                                return await applyJobDecisions(model.jobId);
                            } catch (error) {
                                Swal.showValidationMessage(error.message || 'Une erreur est survenue.');
                                return false;
                            }
                        }
                    });

                    return result;
                }

                async function runTrustAgentWorkflow() {
                    clearTrustAgentStatus();

                    var entryModal = await openTrustAgentEntryModal();
                    if (!entryModal.isConfirmed || !entryModal.value) {
                        return;
                    }

                    var entryPayload = entryModal.value;

                    Swal.fire({
                        title: 'TrustAgent recherche vos informations',
                        html: 'Creation du job en cours...',
                        allowOutsideClick: false,
                        showConfirmButton: false,
                        didOpen: function () {
                            Swal.showLoading();
                        }
                    });

                    try {
                        var job = await createOrReuseEnrichmentJob(entryPayload);
                        var jobId = Number(job.id || 0);
                        var jobStatus = String(job.status || 'pending');

                        setTrustAgentStatus('Job #' + jobId + ' cree. Analyse en cours...', 'info');
                        Swal.update({
                            html: 'Job #' + jobId + ' cree. Recherche des donnees publiques en cours...'
                        });

                        var payload;
                        if (jobStatus === 'awaiting_user') {
                            payload = await fetchEnrichmentJob(jobId);
                        } else if (jobStatus === 'pending' || jobStatus === 'processing') {
                            payload = await pollJobUntilReview(jobId, 45000, 2500);
                        } else if (jobStatus === 'applying') {
                            throw new Error('Un traitement est deja en cours sur ce profil. Merci de patienter.');
                        } else {
                            payload = await fetchEnrichmentJob(jobId);
                        }

                        Swal.close();

                        var reviewResult = await openTrustAgentReviewModal(payload);
                        if (reviewResult.isConfirmed) {
                            setTrustAgentStatus('Les informations ont ete appliquees avec succes.', 'success');
                            toastr.success('Les suggestions TrustAgent ont ete appliquees.');
                            window.location.reload();
                        }
                    } catch (error) {
                        Swal.close();
                        setTrustAgentStatus(escapeHtml(error.message || 'Une erreur est survenue.'), 'error');
                        toastr.error(error.message || 'Une erreur est survenue.');
                    }
                }

