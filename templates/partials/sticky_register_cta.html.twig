{% if app.user is null %}
	<style>
		.tm-sticky-register-cta {
			position: fixed;
			top: 96px;
			right: 18px;
			z-index: 1040;
			pointer-events: none;
		}

		.tm-sticky-register-cta__shell {
			pointer-events: auto;
			display: flex;
			flex-direction: column;
			align-items: stretch;
			gap: 8px;
			background: rgba(255, 255, 255, 0.95);
			border: 1px solid rgba(38, 38, 38, 0.12);
			border-radius: 14px;
			padding: 10px;
			box-shadow: 0 12px 24px rgba(0, 0, 0, 0.12);
			backdrop-filter: blur(4px);
		}

		.tm-sticky-register-cta__label {
			font-family: "Palanquin Dark", sans-serif;
			font-size: 0.85rem;
			color: #262626;
			white-space: normal;
			line-height: 1.3;
			text-align: center;
			padding: 0 4px;
		}

		.tm-sticky-register-cta__button {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			background: #f17c30;
			border: 1px solid #f17c30;
			color: #ffffff;
			font-family: "Palanquin Dark", sans-serif;
			font-size: 0.9rem;
			text-decoration: none;
			border-radius: 10px;
			padding: 8px 14px;
			line-height: 1.2;
			transition: transform 0.15s ease, box-shadow 0.15s ease;
			width: 100%;
		}

		.tm-sticky-register-cta__button:hover,
		.tm-sticky-register-cta__button:focus {
			color: #ffffff;
			text-decoration: none;
			box-shadow: 0 8px 16px rgba(241, 124, 48, 0.35);
			transform: translateY(-1px);
		}

		@media (max-width: 768px) {
			body {
				padding-bottom: 84px;
			}

			.tm-sticky-register-cta {
				top: auto;
				right: 0;
				left: 0;
				bottom: 0;
				padding: 8px 12px calc(8px + env(safe-area-inset-bottom));
			}

			.tm-sticky-register-cta__shell {
				flex-direction: row;
				justify-content: center;
				background: #262626;
				border: 1px solid #262626;
				border-radius: 12px;
				padding: 8px;
				box-shadow: 0 -10px 24px rgba(0, 0, 0, 0.2);
			}

			.tm-sticky-register-cta__label {
				display: none;
			}

			.tm-sticky-register-cta__button {
				width: 100%;
				max-width: 340px;
				font-size: 0.95rem;
				padding: 10px 14px;
			}
		}
	</style>

	<div class="tm-sticky-register-cta" aria-label="Créer un profil gratuit">
		<div class="tm-sticky-register-cta__shell">
			<span class="tm-sticky-register-cta__label">Prêt à commencer ?</span>
			<a class="tm-sticky-register-cta__button" href="{{ path('app_register') }}">
				Créer un profil gratuit
			</a>
		</div>
	</div>
{% endif %}
