    <style>
        .experience_create_content {
            position: relative;
        }

        .experience_intro_shell {
            margin-bottom: 2.5rem;
            padding: 2.2rem;
            border-radius: 32px;
            background:
                radial-gradient(circle at top left, rgba(241, 124, 48, 0.18), transparent 24%),
                linear-gradient(135deg, #fff9f4 0%, #ffffff 48%, #f5f7fa 100%);
            border: 1px solid rgba(241, 124, 48, 0.16);
            box-shadow: 0 24px 60px rgba(16, 16, 16, 0.10);
        }

        .experience_intro_kicker {
            margin: 0 0 .4rem 0;
            font-size: .8rem;
            font-family: "Palanquin Dark", sans-serif;
            font-weight: 700;
            letter-spacing: .22em;
            text-transform: uppercase;
            color: #f17c30;
        }

        .experience_intro_shell h1 {
            margin-bottom: .75rem;
            font-size: 3rem;
            line-height: 1.05;
            color: #121212;
        }

        .experience_intro_subtitle {
            max-width: 760px;
            margin: 0;
            color: #474747;
            font-size: 1.03rem;
            line-height: 1.75;
            font-family: "Palanquin", sans-serif;
        }

        .step1 .list_option .experience_intro_subtitle {
            font-family: "Palanquin", sans-serif !important;
            font-weight: 300 !important;
            font-size: .98rem !important;
            line-height: 1.8 !important;
            color: #676767 !important;
        }

        .step2 .list_option p {
            font-family: "Palanquin", sans-serif !important;
            font-weight: 300 !important;
            font-size: .98rem !important;
            line-height: 1.8 !important;
            color: #676767 !important;
        }

        .experience_intro_meta {
            margin-top: 1.2rem;
            display: flex;
            flex-wrap: wrap;
            gap: .75rem;
        }

        .experience_intro_badge {
            display: inline-flex;
            align-items: center;
            gap: .55rem;
            padding: .72rem 1rem;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.86);
            border: 1px solid rgba(17, 17, 17, 0.08);
            box-shadow: 0 8px 20px rgba(17, 17, 17, 0.05);
            color: #1f1f1f;
            font-family: "Palanquin", sans-serif;
            font-size: .95rem;
        }

        .experience_intro_badge i {
            color: #f17c30;
        }

        .experience_stepper {
            margin-bottom: 2rem;
            padding: 1.25rem 1.4rem;
            border-radius: 24px;
            background: rgba(255, 255, 255, 0.9);
            border: 1px solid rgba(17, 17, 17, 0.08);
            box-shadow: 0 16px 36px rgba(17, 17, 17, 0.06);
        }

        .experience_stepper_header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            margin-bottom: .9rem;
        }

        .experience_stepper_eyebrow {
            margin: 0;
            font-size: .78rem;
            font-family: "Palanquin Dark", sans-serif;
            letter-spacing: .18em;
            text-transform: uppercase;
            color: #f17c30;
        }

        .experience_stepper_count {
            margin: 0;
            color: #1e1e1e;
            font-family: "Palanquin Dark", sans-serif;
            font-size: .95rem;
        }

        .experience_stepper_track {
            width: 100%;
            height: 6px;
            border-radius: 999px;
            background: rgba(17, 17, 17, 0.08);
            overflow: hidden;
        }

        .experience_stepper_progress {
            width: 25%;
            height: 100%;
            border-radius: inherit;
            background: linear-gradient(90deg, #f17c30 0%, #ffb787 100%);
            transition: width .3s ease;
        }

        .experience_stepper_labels {
            margin-top: 1rem;
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: .75rem;
        }

        .experience_stepper_label {
            display: flex;
            flex-direction: column;
            gap: .25rem;
            color: #858585;
            transition: color .2s ease;
        }

        .experience_stepper_label strong {
            font-size: .78rem;
            font-family: "Palanquin Dark", sans-serif;
            letter-spacing: .14em;
            text-transform: uppercase;
        }

        .experience_stepper_label span {
            font-family: "Palanquin", sans-serif;
            font-size: .92rem;
            line-height: 1.4;
        }

        .experience_stepper_label.is-active,
        .experience_stepper_label.is-complete {
            color: #151515;
        }

        .experience_stage_panel {
            padding: 1.8rem;
            border-radius: 28px;
            background: linear-gradient(180deg, rgba(255,255,255,0.98) 0%, rgba(255,255,255,0.93) 100%);
            border: 1px solid rgba(17, 17, 17, 0.08);
            box-shadow: 0 20px 44px rgba(17, 17, 17, 0.08);
        }

        .experience_stage_header {
            margin-bottom: 1.2rem;
        }

        .experience_stage_header p {
            margin: 0 0 .35rem 0;
            color: #f17c30;
            font-family: "Palanquin Dark", sans-serif;
            font-size: .78rem;
            letter-spacing: .18em;
            text-transform: uppercase;
        }

        .experience_stage_header h2 {
            margin: 0;
            color: #121212;
            font-size: 2rem;
            line-height: 1.15;
        }

        .experience_stage_header span {
            display: block;
            margin-top: .75rem;
            color: #555;
            font-family: "Palanquin", sans-serif;
            line-height: 1.7;
        }

        .experience_stage_panel .list_option,
        .step3 .list_field,
        .step4 .recap_choix {
            border: 1px solid rgba(17, 17, 17, 0.08);
            border-radius: 24px;
            background: linear-gradient(180deg, rgba(255,255,255,0.98) 0%, rgba(255,255,255,0.93) 100%);
            box-shadow: 0 18px 38px rgba(17, 17, 17, 0.06);
        }

        .experience_stage_panel .list_option {
            padding: 1.6rem 1.5rem;
        }

        .step3 .list_field,
        .step4 .recap_choix {
            padding: 1.5rem;
            margin-bottom: 1.4rem;
        }

        .step3 .list_field label h2,
        .step4 .recap_choix h2 {
            margin-bottom: .7rem;
            color: #121212;
        }

        .experience_checklist {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: .9rem 1.1rem;
        }

        .experience_check_item {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: .75rem;
            min-width: 0;
            padding: .15rem 0;
            cursor: pointer;
            -webkit-tap-highlight-color: transparent;
        }

        .experience_check_item span {
            min-width: 0;
            font-family: "Palanquin", sans-serif;
            color: #222;
            line-height: 1.35;
            white-space: normal;
            overflow-wrap: break-word;
        }

        .step3 .radios .experience_check_item .radio_custom {
            appearance: none;
            flex: 0 0 auto;
            display: inline-grid;
            place-content: center;
            width: 1.35rem !important;
            min-width: 1.35rem !important;
            max-width: 1.35rem !important;
            height: 1.35rem !important;
            padding: 0 !important;
            margin: .1rem 0 0 0 !important;
            border: 0.14rem solid currentColor;
            border-radius: 50%;
            background: #fff;
            transform: none;
            box-sizing: border-box;
            cursor: pointer;
            pointer-events: auto;
        }

        .step3 .radios .experience_check_item .radio_custom::before {
            content: "";
            width: .7rem;
            height: .7rem;
            border-radius: 50%;
            transform: scale(0);
            transition: 120ms transform ease-in-out;
            box-shadow: inset 1em 1em #111;
        }

        .step3 .radios .experience_check_item .radio_custom:checked::before {
            transform: scale(1);
        }

        .experience_card_option {
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(241, 124, 48, 0.22) !important;
            border-radius: 26px !important;
            padding: 1.6rem 1.5rem !important;
            background: linear-gradient(135deg, #fffaf6 0%, #ffffff 100%);
            box-shadow: 0 18px 38px rgba(17, 17, 17, 0.06);
        }

        .experience_card_option::before {
            content: "";
            position: absolute;
            inset: 0 auto auto 0;
            width: 140px;
            height: 140px;
            background: radial-gradient(circle, rgba(255,255,255,0.9) 0%, rgba(255,255,255,0) 70%);
            pointer-events: none;
        }

        .experience_card_option_icon {
            width: 60px;
            height: 60px;
            border-radius: 20px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1rem;
            background: linear-gradient(145deg, #101010 0%, #363636 100%);
            color: #fff;
            font-size: 1.2rem;
            box-shadow: 0 12px 26px rgba(0, 0, 0, 0.16);
        }

        .experience_card_option_tag {
            display: inline-flex;
            padding: .32rem .65rem;
            border-radius: 999px;
            background: rgba(241, 124, 48, 0.10);
            color: #f17c30;
            font-family: "Palanquin Dark", sans-serif;
            font-size: .76rem;
            letter-spacing: .18em;
            text-transform: uppercase;
            margin-bottom: .8rem;
        }

        .experience_card_option .list_option p {
            font-family: "Palanquin", sans-serif;
            color: #505050;
            line-height: 1.7;
        }

        .experience_card_option.active {
            background: linear-gradient(135deg, #fff4ea 0%, #ffffff 100%);
            box-shadow: 0 24px 48px rgba(241, 124, 48, 0.13);
            transform: translateY(-2px);
        }

        .experience_field_grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 1.2rem;
        }

        .experience_field_panel {
            padding: 1.4rem;
            border-radius: 22px;
            background: #fff;
            border: 1px solid rgba(17, 17, 17, 0.08);
            box-shadow: 0 14px 28px rgba(17, 17, 17, 0.05);
        }

        .experience_field_panel h3 {
            margin: 0 0 .4rem 0;
            font-family: "Palanquin Dark", sans-serif;
            font-size: 1.15rem;
            color: #121212;
        }

        .experience_field_panel p {
            margin: 0 0 1rem 0;
            color: #616161;
            font-family: "Palanquin", sans-serif;
            line-height: 1.6;
        }

        .input_rounded {
            height: 54px;
            border-radius: 16px;
            border: 1px solid rgba(17, 17, 17, 0.12);
            box-shadow: none;
        }

        .input_rounded:focus,
        .field_precisions:focus,
        .field_precisions_2:focus {
            border-color: rgba(241, 124, 48, 0.7);
            box-shadow: 0 0 0 4px rgba(241, 124, 48, 0.10);
        }

        .universe-autocomplete {
            position: relative;
        }

        .universe-suggestions {
            position: absolute;
            top: calc(100% + 6px);
            left: 0;
            right: 0;
            z-index: 1200;
            max-height: 230px;
            overflow-y: auto;
            background: #fff;
            border: 1px solid rgba(17, 17, 17, 0.12);
            border-radius: 12px;
            box-shadow: 0 12px 24px rgba(17, 17, 17, 0.12);
            display: none;
        }

        .universe-suggestion-item {
            width: 100%;
            padding: 10px 12px;
            text-align: left;
            border: 0;
            background: #fff;
            color: #202020;
            font-family: "Palanquin", sans-serif;
            cursor: pointer;
        }

        .universe-suggestion-item:hover,
        .universe-suggestion-item:focus {
            background: #fff6ef;
            outline: none;
        }

        .experience_choice_grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: .95rem;
        }

        .experience_choice_chip {
            position: relative;
            display: flex;
            align-items: center;
            gap: .75rem;
            padding: .95rem 1rem;
            border-radius: 18px;
            border: 1px solid rgba(17, 17, 17, 0.10);
            background: #fff;
            cursor: pointer;
            transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;
        }

        .experience_choice_chip:hover {
            transform: translateY(-1px);
            box-shadow: 0 10px 22px rgba(17, 17, 17, 0.06);
        }

        .experience_choice_chip .radio_custom {
            margin-left: 0 !important;
            flex: 0 0 auto;
            width: 18px !important;
            height: 18px !important;
            border-width: 2px !important;
        }

        .experience_choice_chip .radio_custom::before {
            width: 18px !important;
            height: 18px !important;
        }

        .experience_choice_chip span {
            color: #202020;
            font-family: "Palanquin", sans-serif;
            line-height: 1.45;
        }

        .experience_choice_chip:has(.radio_custom:checked) {
            border-color: rgba(241, 124, 48, 0.55);
            box-shadow: 0 14px 26px rgba(241, 124, 48, 0.12);
            background: #fff8f2;
        }

        .experience_section_title {
            margin: 0 0 1rem 0;
            font-size: 1.15rem;
            font-family: "Palanquin Dark", sans-serif;
            color: #111;
        }

        .field_precisions,
        .field_precisions_2 {
            min-height: 150px;
            border-radius: 18px;
            border: 1px solid rgba(17, 17, 17, 0.12);
            padding: 1rem 1.1rem;
        }

        .experience_summary_block {
            padding: 1.5rem;
            border-radius: 24px;
            background: linear-gradient(135deg, #fff9f4 0%, #ffffff 100%);
            border: 1px solid rgba(241, 124, 48, 0.16);
            box-shadow: 0 18px 40px rgba(17, 17, 17, 0.06);
        }

        .inline_choix {
            margin-bottom: .85rem;
            align-items: flex-start;
        }

        .inline_choix h2 {
            min-width: 160px;
            color: #111;
        }

        .prefooter_action {
            padding: 14px 18px;
            border-top: 1px solid rgba(17, 17, 17, 0.08);
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(10px);
            box-shadow: 0 -8px 24px rgba(17, 17, 17, 0.05);
        }

        .action_prev,
        .action_next {
            padding: 11px 24px;
            border-radius: 14px;
            text-decoration: none;
        }

        .action_prev {
            border-color: rgba(17, 17, 17, 0.12);
            background: #fff;
            color: #151515;
        }

        .action_next {
            border-color: transparent;
            background: rgba(17, 17, 17, 0.18);
            color: #fff;
        }

        .action_next.active {
            background: linear-gradient(135deg, #f17c30 0%, #ff9f60 100%);
        }

        .saveAndClose--footer {
            display: none !important;
        }

        @media (min-width: 1400px) {
            .experience_checklist {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }
        }

        @media (max-width: 992px) {
            .experience_intro_shell {
                padding: 1.5rem;
                border-radius: 24px;
            }

            .experience_intro_shell h1 {
                font-size: 2rem;
                line-height: 1.1;
            }

            .experience_stepper_labels,
            .experience_field_grid,
            .experience_choice_grid {
                grid-template-columns: 1fr;
            }

            .experience_stage_panel {
                padding: 1.2rem;
                border-radius: 22px;
            }

            .inline_choix {
                flex-direction: column;
                gap: .2rem;
            }

            .inline_choix h2 {
                min-width: 0;
            }

            .step3 .radios {
                overflow: hidden;
                width: 100%;
            }

            .experience_checklist {
                grid-template-columns: 1fr;
                gap: .7rem;
                width: 100%;
            }

            .step3 .radios .experience_check_item {
                align-items: center;
                width: 100%;
                padding: .85rem 1rem;
                border: 1px solid rgba(17, 17, 17, 0.08);
                border-radius: 16px;
                background: linear-gradient(180deg, rgba(255,255,255,0.98) 0%, rgba(255,248,242,0.92) 100%);
                box-shadow: 0 10px 22px rgba(17, 17, 17, 0.05);
            }

            .step3 .radios .experience_check_item span {
                font-size: .98rem;
                line-height: 1.4;
            }

            .step3 .radios .experience_check_item .radio_custom {
                margin-top: 0 !important;
            }

            .prefooter_action {
                display: grid;
                grid-template-columns: 1fr auto 1fr;
                align-items: center;
                gap: 10px;
            }

            .saveAndClose--top {
                display: none !important;
            }

            .saveAndClose--footer {
                display: inline-flex !important;
                justify-content: center;
                align-items: center;
                min-width: 112px;
                text-align: center;
                padding: 11px 16px;
                border-radius: 14px;
                background: #fff;
                border: 1px solid rgba(17, 17, 17, 0.12);
                box-shadow: 0 10px 22px rgba(17, 17, 17, 0.08);
                color: #151515;
                white-space: nowrap;
                font-family: "Palanquin", sans-serif;
                font-size: .95rem;
                line-height: 1;
                text-decoration: none;
                position: static;
                top: auto;
                left: auto;
                transform: none;
                margin: 0 auto;
                z-index: auto;
                visibility: hidden;
                opacity: 0;
                pointer-events: none;
                transition: opacity .2s ease;
            }

            .action_prev,
            .action_next {
                min-width: 112px;
                text-align: center;
                padding: 11px 16px;
                border-radius: 14px;
                font-family: "Palanquin", sans-serif;
                font-size: .95rem;
                line-height: 1;
                box-shadow: none;
            }

            .action_prev {
                justify-self: start;
            }

            .action_next {
                justify-self: end;
            }

            .prefooter_action .action_prev:hover,
            .prefooter_action .action_prev:focus,
            .prefooter_action .action_prev:active,
            .prefooter_action .action_prev:visited {
                background: #fff !important;
                border: 1px solid rgba(17, 17, 17, 0.12) !important;
                color: #151515 !important;
                text-decoration: none;
                outline: none;
            }

            .prefooter_action.has-save-action .saveAndClose--footer {
                visibility: visible;
                opacity: 1;
                pointer-events: auto;
            }

            .saveAndClose--footer.is-visible {
                visibility: visible;
                opacity: 1;
                pointer-events: auto;
            }
        }
    </style>
{% endblock %}

{% block header %}
    {{ parent() }}
{% endblock %}

{% block navigation %}
{% endblock %}

{% block body %}
    <p class="saveAndClose saveAndClose--top">Enregistrer</p>
    <div id="trustBody" style="min-height: 67vh; margin-top: 54.4766px;" class="container">
        <!--Main layout-->
        <main class="mt-2 pt-2">
            <div class="container experience_create_content">
                <h1>Créez votre projet sur mesure</h1>
                <div class="experience_intro_shell">
                    <p class="experience_intro_kicker">Exp&eacute;rience sur mesure</p>
                    <p class="experience_intro_subtitle">En quelques &eacute;tapes, nous pr&eacute;parons une demande claire &agrave; transmettre aux studios les plus adapt&eacute;s &agrave; votre besoin.</p>
                    <div class="experience_intro_meta">
                        <div class="experience_intro_badge"><i class="fas fa-shield-alt"></i><span>Gratuit, sans engagement</span></div>
                        <div class="experience_intro_badge"><i class="fas fa-credit-card"></i><span>Aucune carte bancaire requise</span></div>
                    </div>
                </div>
