{% block body %}
    <div class="flex-fill container">
        <main class="">
            <div class="container mt-2 pt-4">
                {% include 'menuProfile.html.twig' %}
                <div class="list_experiences">
                    {% set experiencesPerPage = 5 %}
                    {% set routeName = app.request.attributes.get('_route') %}
                    {% set routeParams = app.request.attributes.get('_route_params') %}
                    {% set currentQuery = app.request.query.all %}

                    {% set draftTotal = experiences_draft|length %}
                    {% set draftTotalPages = draftTotal > 0 ? experiences_draft|batch(experiencesPerPage)|length : 1 %}
                    {% set draftRequestedPage = app.request.query.getInt('draftPage', 1) %}
                    {% set draftCurrentPage = draftRequestedPage < 1 ? 1 : draftRequestedPage %}
                    {% set draftCurrentPage = draftCurrentPage > draftTotalPages ? draftTotalPages : draftCurrentPage %}
                    {% set draftOffset = (draftCurrentPage - 1) * experiencesPerPage %}

                    {% set publishTotal = experiences_publish|length %}
                    {% set publishTotalPages = publishTotal > 0 ? experiences_publish|batch(experiencesPerPage)|length : 1 %}
                    {% set publishRequestedPage = app.request.query.getInt('publishPage', 1) %}
                    {% set publishCurrentPage = publishRequestedPage < 1 ? 1 : publishRequestedPage %}
                    {% set publishCurrentPage = publishCurrentPage > publishTotalPages ? publishTotalPages : publishCurrentPage %}
                    {% set publishOffset = (publishCurrentPage - 1) * experiencesPerPage %}

                    {% set assignedTotal = experiences_assigned|length %}
                    {% set assignedTotalPages = assignedTotal > 0 ? experiences_assigned|batch(experiencesPerPage)|length : 1 %}
                    {% set assignedRequestedPage = app.request.query.getInt('assignedPage', 1) %}
                    {% set assignedCurrentPage = assignedRequestedPage < 1 ? 1 : assignedRequestedPage %}
                    {% set assignedCurrentPage = assignedCurrentPage > assignedTotalPages ? assignedTotalPages : assignedCurrentPage %}
                    {% set assignedOffset = (assignedCurrentPage - 1) * experiencesPerPage %}

                    {% set receivedTotal = experiences_received|length %}
                    {% set receivedTotalPages = receivedTotal > 0 ? experiences_received|batch(experiencesPerPage)|length : 1 %}
                    {% set receivedRequestedPage = app.request.query.getInt('receivedPage', 1) %}
                    {% set receivedCurrentPage = receivedRequestedPage < 1 ? 1 : receivedRequestedPage %}
                    {% set receivedCurrentPage = receivedCurrentPage > receivedTotalPages ? receivedTotalPages : receivedCurrentPage %}
                    {% set receivedOffset = (receivedCurrentPage - 1) * experiencesPerPage %}

                    <div class="creerExperienceDiv col-12 my-2">
                        <a href="{{ path('experiences_index') }}" class="webDisplayCreateBtn">Créer une expérience</a>
                    </div>
                    <h2 class="font-weight-bold" id="experiences-draft">Expérience(s) en brouillon</h2>
                    {% for item in experiences_draft|slice(draftOffset, experiencesPerPage) %}
                        <div class="experience_div">
                            <h2>Projet : {% if item.exp_type_experience == "Production musicale" %}
                                    {{ item.exp_type_experience }} - {{ item.exp_ville }} - {{ item.exp_univers }}
                                {% else %}
                                    {{ item.exp_type_experience }} - {{ item.exp_lieu_evt }} - {{ item.exp_nom_evt }}
                                {% endif %}</h2>
                            <p>Plus que quelques étapes pour finaliser votre projet</p>
                            <div class="footer_link">
                                <div class="left_link">
                                    <a href="{{ path('experiences_edit_experience', {'id' : item.id}) }}"
                                       style="margin-right: 1rem;">Continuer</a>
                                    <a class="delete"
                                       href="{{ path('experiences_post_delete_get', {'id' : item.id}) }}">Supprimer</a>
                                </div>
                                <div class="right_link">
                                    <a href="" class="apercuExp" attr-id="{{ item.id }}">Aperçu</a>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                    {% include 'partials/pagination.html.twig' with {
                        currentPage: draftCurrentPage,
                        totalPages: draftTotalPages,
                        routeName: routeName,
                        routeParams: routeParams,
                        query: currentQuery,
                        pageParameter: 'draftPage',
                        anchor: '#experiences-draft',
                        ariaLabel: 'Pagination des expériences en brouillon'
                    } only %}

                    <h2 class="font-weight-bold" id="experiences-publish">Expérience(s) publiée(s)</h2>
                    {% for item in experiences_publish|slice(publishOffset, experiencesPerPage) %}
                        <div class="experience_div">
                            <h2>Projet : {% if item.exp_type_experience == "Production musicale" %}
                                    {{ item.exp_type_experience }} - {{ item.exp_ville }} - {{ item.exp_univers }}
                                {% else %}
                                    {{ item.exp_type_experience }} - {{ item.exp_lieu_evt }} - {{ item.exp_nom_evt }}
                                {% endif %}</h2>
                            {# <p>Plus que quelques étapes pour finaliser votre projet</p> #}
                            <div class="footer_link">
                                <div class="left_link">
                                    <a class="delete"
                                       href="{{ path('experiences_post_delete_get', {'id' : item.id}) }}">Supprimer</a>
                                    <a class="assign" style="margin-left: 1rem;"
                                       href="{{ path('experiences_assign_get', {'id' : item.id}) }}">Attribuer</a>
                                </div>
                                <div class="right_link">
                                    <a href="" class="apercuExp" attr-id="{{ item.id }}">Aperçu</a>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                    {% include 'partials/pagination.html.twig' with {
                        currentPage: publishCurrentPage,
                        totalPages: publishTotalPages,
                        routeName: routeName,
                        routeParams: routeParams,
                        query: currentQuery,
                        pageParameter: 'publishPage',
                        anchor: '#experiences-publish',
                        ariaLabel: 'Pagination des expériences publiées'
                    } only %}

                    <h2 class="font-weight-bold" id="experiences-assigned">Expérience(s) attribuée(s)</h2>
                    {% for item in experiences_assigned|slice(assignedOffset, experiencesPerPage) %}
                        <div class="experience_div">
                            <h2>Projet : {% if item.exp_type_experience == "Production musicale" %}
                                    {{ item.exp_type_experience }} - {{ item.exp_ville }} - {{ item.exp_univers }}
                                {% else %}
                                    {{ item.exp_type_experience }} - {{ item.exp_lieu_evt }} - {{ item.exp_nom_evt }}
                                {% endif %}</h2>
                            <div class="footer_link">
                                <div class="left_link"></div>
                                <div class="right_link">
                                    <a href="" class="apercuExp" attr-id="{{ item.id }}">Aperçu</a>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                    {% include 'partials/pagination.html.twig' with {
                        currentPage: assignedCurrentPage,
                        totalPages: assignedTotalPages,
                        routeName: routeName,
                        routeParams: routeParams,
                        query: currentQuery,
                        pageParameter: 'assignedPage',
                        anchor: '#experiences-assigned',
                        ariaLabel: 'Pagination des expériences attribuées'
                    } only %}

                    {% if 'ROLE_AUTO_ENTREPRENEUR' in app.user.roles or 'ROLE_SOCIETE' in app.user.roles %}
                        <h2 class="font-weight-bold" id="experiences-received">Expérience(s) reçue(s)</h2>
                        {% for item in experiences_received|slice(receivedOffset, experiencesPerPage) %}
                            <div class="experience_div">
                                <h2>Projet : {% if item.exp_type_experience == "Production musicale" %}
                                        {{ item.exp_type_experience }} - {{ item.exp_ville }} - {{ item.exp_univers }}
                                    {% else %}
                                        {{ item.exp_type_experience }} - {{ item.exp_lieu_evt }} - {{ item.exp_nom_evt }}
                                    {% endif %}</h2>
                                <div class="footer_link">
                                    <div class="left_link"></div>
                                    <div class="right_link">
                                        <a href="" class="apercuExp" attr-id="{{ item.id }}">Aperçu</a>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                        {% include 'partials/pagination.html.twig' with {
                            currentPage: receivedCurrentPage,
                            totalPages: receivedTotalPages,
                            routeName: routeName,
                            routeParams: routeParams,
                            query: currentQuery,
                            pageParameter: 'receivedPage',
                            anchor: '#experiences-received',
                            ariaLabel: 'Pagination des expériences reçues'
                        } only %}
                    {% endif %}

                    <a href="{{ path('experiences_index') }}" class="mobileDisplayCreateBtn">Créer une expérience</a>
                </div>
            </div>
        </main>
        <!--Main layout-->
    </div>
    <!-- Modal -->
    <div class="modal fade exp-preview-modal" id="apercuModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel"
         aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Projet: <span class="apercuTitre"></span></h5>
                    <button type="button" class="close fermerModalApercu" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="exp-preview-card">
                        <div class="exp-preview-grid">
                            <div class="exp-preview-item">
                                <strong>Type de projet</strong>
                                <span class="previewTypeValue"></span>
                            </div>
                            <div class="exp-preview-item">
                                <strong>Ville recherchee</strong>
                                <span class="villeValue"></span>
                            </div>
                            <div class="exp-preview-item">
                                <strong>Univers musical</strong>
                                <span class="universValue"></span>
                            </div>
                            <div class="exp-preview-item previewEvtWrap" style="display:none;">
