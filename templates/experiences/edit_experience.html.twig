{% block title %}Trust &amp; Market | Expériences | Créer une expérience{% endblock %}

{% block style %}
    {{ parent() }}
    <!-- Gijgo datepicker css -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/gijgo/1.9.13/combined/css/gijgo.min.css"
          integrity="sha512-oCuecFHHGu/Y4zKF8IoSoj5hQq1dLNIiUCwN08ChNW1VoMcjIIirAJT2JmKlYde6DeLN6JRSgntz6EDYDdFhCg=="
          crossorigin="anonymous"/>
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css"/>
    <!-- Your custom styles (optional) -->
    <link href="{{ absolute_url(asset('assets/css/style.css')) }}" rel="stylesheet"/>
    <link href="{{ asset('assets/css/result.css') }}" rel="stylesheet"/>
    <link href="{{ asset('assets/css/custome.css') }} " rel="stylesheet"/>

    <link href="https://www.jqueryscript.net/css/jquerysctipttop.css" rel="stylesheet" type="text/css"/>
    <link rel="stylesheet" href="{{ asset('assets/css/lc_lightbox.css') }}"/>
    <link href="{{ asset('assets/css/experiences/edit_exp.css') }} " rel="stylesheet"/>
    <link href="{{ asset('assets/css/style-aide.css') }} " rel="stylesheet"/>
    <style>
        .experience_create_content {
            position: relative;
        }

        .experience_create_content > h1 {
            display: none;
        }

        .experience_intro_shell {
            margin-bottom: 2.5rem;
            padding: 2.2rem;
            border-radius: 32px;
            background:
                radial-gradient(circle at top left, rgba(241, 124, 48, 0.18), transparent 24%),
                linear-gradient(135deg, #fff9f4 0%, #ffffff 48%, #f5f7fa 100%);
            border: 1px solid rgba(241, 124, 48, 0.16);
            box-shadow: 0 24px 60px rgba(16, 16, 16, 0.10);
        }

        .experience_intro_kicker,
        .experience_stepper_eyebrow {
            margin: 0 0 .4rem 0;
            font-size: .8rem;
            font-family: "Palanquin Dark", sans-serif;
            font-weight: 700;
            letter-spacing: .22em;
            text-transform: uppercase;
            color: #f17c30;
        }

        .experience_intro_shell h1 {
            margin-bottom: .75rem;
            font-size: 3rem;
            line-height: 1.05;
            color: #121212;
        }

        .experience_intro_subtitle {
            max-width: 760px;
            margin: 0;
            color: #474747;
            font-size: 1.03rem;
            line-height: 1.75;
            font-family: "Palanquin", sans-serif;
            font-weight: 300;
        }

        .experience_intro_meta {
            margin-top: 1.2rem;
            display: flex;
            flex-wrap: wrap;
            gap: .75rem;
        }

        .experience_intro_badge {
            display: inline-flex;
            align-items: center;
            gap: .55rem;
            padding: .72rem 1rem;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.86);
            border: 1px solid rgba(17, 17, 17, 0.08);
            box-shadow: 0 8px 20px rgba(17, 17, 17, 0.05);
            color: #1f1f1f;
            font-family: "Palanquin", sans-serif;
            font-size: .95rem;
        }

        .experience_intro_badge i {
            color: #f17c30;
        }

        .experience_stepper {
            margin-bottom: 2rem;
            padding: 1.25rem 1.4rem;
            border-radius: 24px;
            background: rgba(255, 255, 255, 0.9);
            border: 1px solid rgba(17, 17, 17, 0.08);
            box-shadow: 0 16px 36px rgba(17, 17, 17, 0.06);
        }

        .experience_stepper_header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            margin-bottom: .9rem;
        }

        .experience_stepper_count {
            margin: 0;
            color: #1e1e1e;
            font-family: "Palanquin Dark", sans-serif;
            font-size: .95rem;
        }

        .experience_stepper_track {
            width: 100%;
            height: 6px;
            border-radius: 999px;
            background: rgba(17, 17, 17, 0.08);
            overflow: hidden;
        }

        .experience_stepper_progress {
            width: 25%;
            height: 100%;
            border-radius: inherit;
            background: linear-gradient(90deg, #f17c30 0%, #ffb787 100%);
            transition: width .3s ease;
        }

        .experience_stepper_labels {
            margin-top: 1rem;
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: .75rem;
        }

        .experience_stepper_label {
            display: flex;
            flex-direction: column;
            gap: .25rem;
            color: #858585;
            transition: color .2s ease;
        }

        .experience_stepper_label strong {
            font-size: .78rem;
            font-family: "Palanquin Dark", sans-serif;
            letter-spacing: .14em;
            text-transform: uppercase;
        }

        .experience_stepper_label span {
            font-family: "Palanquin", sans-serif;
            font-size: .92rem;
            line-height: 1.4;
        }

        .experience_stepper_label.is-active,
        .experience_stepper_label.is-complete {
            color: #151515;
        }

        .options > .steps,
        .step4 .recap_choix {
            padding: 1.8rem;
            border-radius: 28px;
            background: linear-gradient(180deg, rgba(255,255,255,0.98) 0%, rgba(255,255,255,0.93) 100%);
            border: 1px solid rgba(17, 17, 17, 0.08);
            box-shadow: 0 20px 44px rgba(17, 17, 17, 0.08);
        }

        .step1 .list_option p,
        .step2 .list_option p {
            font-family: "Palanquin", sans-serif !important;
            font-weight: 300 !important;
            font-size: .98rem !important;
            line-height: 1.8 !important;
            color: #676767 !important;
        }

        .step2 .list_option {
            margin-bottom: 0;
            border-radius: 30px;
            border: 1px solid rgba(241, 124, 48, 0.25);
            background: linear-gradient(180deg, rgba(255,255,255,0.95) 0%, rgba(248,244,240,0.95) 100%);
            box-shadow: 0 18px 40px rgba(16, 16, 16, 0.08);
        }

        .experience_checklist {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: .9rem 1.1rem;
            width: 100%;
        }

        .experience_check_item {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: .75rem;
            min-width: 0;
            width: 100%;
            padding: .15rem 0;
            cursor: pointer;
            -webkit-tap-highlight-color: transparent;
        }

        .experience_check_item span {
            min-width: 0;
            font-family: "Palanquin", sans-serif;
            color: #222;
            line-height: 1.35;
            white-space: normal;
            overflow-wrap: break-word;
        }

        .step3 .radios .experience_check_item .radio_custom {
            appearance: none;
            flex: 0 0 auto;
            display: inline-grid;
            place-content: center;
            width: 1.35rem !important;
            min-width: 1.35rem !important;
            max-width: 1.35rem !important;
            height: 1.35rem !important;
            padding: 0 !important;
            margin: .1rem 0 0 0 !important;
            border: 0.14rem solid currentColor;
            border-radius: 50%;
            background: #fff;
            transform: none;
            box-sizing: border-box;
            cursor: pointer;
            pointer-events: auto;
        }

        .step3 .radios .experience_check_item .radio_custom::before {
            content: "";
            width: .7rem;
            height: .7rem;
            border-radius: 50%;
            transform: scale(0);
            transition: 120ms transform ease-in-out;
            box-shadow: inset 1em 1em #111;
        }

        .step3 .radios .experience_check_item .radio_custom:checked::before {
            transform: scale(1);
        }

        @media (min-width: 1400px) {
            .experience_checklist {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }
        }

        .prefooter_action {
            padding: 14px 18px;
            border-top: 1px solid rgba(17, 17, 17, 0.08);
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(10px);
            box-shadow: 0 -8px 24px rgba(17, 17, 17, 0.05);
            z-index: 1040;
        }

        .action_prev,
        .action_next {
            padding: 11px 24px;
            border-radius: 14px;
            text-decoration: none;
        }

        .action_prev {
            border-color: rgba(17, 17, 17, 0.12);
            background: #fff;
            color: #151515;
        }

        .action_next {
            border-color: transparent;
            background: rgba(17, 17, 17, 0.18);
            color: #fff;
        }

        .action_next.active {
            background: linear-gradient(135deg, #f17c30 0%, #ff9f60 100%);
        }

        @media (max-width: 991px) {
            .experience_intro_shell h1 {
                font-size: 2.4rem;
            }

            .experience_stepper_labels {
                grid-template-columns: 1fr;
            }

            .step3 .radios {
                overflow: hidden;
                width: 100%;
            }

            .experience_checklist {
                grid-template-columns: 1fr;
                gap: .7rem;
            }

            .step3 .radios .experience_check_item {
                align-items: center;
                width: 100%;
                padding: .85rem 1rem;
                border: 1px solid rgba(17, 17, 17, 0.08);
                border-radius: 16px;
                background: linear-gradient(180deg, rgba(255,255,255,0.98) 0%, rgba(255,248,242,0.92) 100%);
                box-shadow: 0 10px 22px rgba(17, 17, 17, 0.05);
            }

            .step3 .radios .experience_check_item span {
                font-size: .98rem;
                line-height: 1.4;
            }

            .step3 .radios .experience_check_item .radio_custom {
                margin-top: 0 !important;
            }

            .prefooter_action {
                justify-content: space-between;
                align-items: center;
                position: fixed;
                left: 0;
                right: 0;
                bottom: 50px;
                padding: 10px 14px;
                gap: 10px;
            }

            .saveAndClose {
                position: fixed;
                left: 50%;
                right: auto;
                top: auto;
                bottom: 58px;
                transform: translateX(-50%);
                z-index: 1055;
                margin: 0;
                min-width: 112px;
                text-align: center;
                padding: 11px 16px;
                border-radius: 14px;
                background: #fff;
                border: 1px solid rgba(17, 17, 17, 0.12);
                box-shadow: 0 10px 22px rgba(17, 17, 17, 0.08);
                color: #151515;
                white-space: nowrap;
                font-family: "Palanquin", sans-serif;
                font-size: .95rem;
                line-height: 1;
            }

            .action_prev,
            .action_next {
                min-width: 112px;
                text-align: center;
                padding: 11px 16px;
                border-radius: 14px;
                font-family: "Palanquin", sans-serif;
                font-size: .95rem;
                line-height: 1;
                box-shadow: none;
            }

            .action_prev {
                background: #fff;
                border: 1px solid rgba(17, 17, 17, 0.12);
                color: #151515;
            }

            .action_next {
                background: rgba(17, 17, 17, 0.16);
            }
        }
    </style>
{% endblock %}

{% block header %}
    {{ parent() }}
{% endblock %}

{% block navigation %}
{% endblock %}

{% block body %}
    <p class="saveAndClose">Enregistrer</p>
    <div id="trustBody" style="min-height: 67vh; margin-top: 54.4766px;" class="container">
        <!--Main layout-->
        <main class="mt-2 pt-2">
            <div class="container experience_create_content">
                <h1>Créez votre expérience unique avec Trust & Market</h1>
                <div class="experience_intro_shell">
                    <p class="experience_intro_kicker">Modification en cours</p>
                    <h1>Affinez votre projet musical</h1>
                    <p class="experience_intro_subtitle">Mettez a jour votre demande en quelques instants pour nous permettre d'affiner la transmission aux studios les plus pertinents.</p>
                    <div class="experience_intro_meta">
                        <span class="experience_intro_badge"><i class="fa fa-shield"></i> Gratuit, sans engagement</span>
                        <span class="experience_intro_badge"><i class="fa fa-pencil"></i> Vos informations restent modifiables</span>
                    </div>
                </div>
                <div class="experience_stepper">
                    <div class="experience_stepper_header">
                        <p class="experience_stepper_eyebrow">Parcours guide</p>
                        <p class="experience_stepper_count">Etape 1 sur 4</p>
                    </div>
                    <div class="experience_stepper_track">
                        <div class="experience_stepper_progress"></div>
                    </div>
                    <div class="experience_stepper_labels">
                        <div class="experience_stepper_label is-active"><strong>01</strong><span>Lancez-vous</span></div>
                        <div class="experience_stepper_label"><strong>02</strong><span>Production musicale</span></div>
                        <div class="experience_stepper_label"><strong>03</strong><span>Details du projet</span></div>
                        <div class="experience_stepper_label"><strong>04</strong><span>Recapitulatif</span></div>
                    </div>
                </div>
                <div class="options">
                    <div class="step1 steps" attr-step="1"
                         attr-title="Affiner votre projet musical">
                        <div class="list_option">
                            <h2>Lancez - vous !</h2>
                            <p>Personnalisez votre expérience et faites-vous accompagner quelque soit votre besoin.</p>
                        </div>
                    </div>
                    <div class="step2 steps" style="display: none;" attr-step="2"
                         attr-title="">
                        <div class="list_option {{ experience.exp_type_experience == 'Production musicale' ? 'active' : '' }}">
                            <h2>Production musicale</h2>
                            <p>Vous avez un besoin de studio d'enregistrement, de mixage audio, de mastering audio,
                            de musiciens, de batteur ou percussionniste, de choristes ou autres besoins pour un projet de production musicale.</p>
                        </div>
                    </div>
                    <div class="step3 steps" style="display: none;" attr-step="3" attr-title="Projet : Production musicale">
                        <div class="form-group list_field musique_choose">
                            <label for=""><h2>Dans quelle ville recherchez-vous* ?</h2></label>
                            <input type="text" class="form-control input_rounded field_ville" name="ville"
                                   value="{{ experience.exp_ville }}">
                        </div>
                        <div class="form-group list_field musique_choose">
                            <label for=""><h2>Votre univers musical* ?</h2></label>
                            <input type="text" class="form-control input_rounded field_univers" name="univers"
                                   value="{{ experience.exp_univers }}">
                        </div>
                        <div class="form-group list_field" style="margin-top: 2rem;">
                            <label for=""><h2>Choisissez vos besoins</h2></label>
                            <div class="radios besoins">
                                <div class="experience_checklist musique_choose">
                                    <label class="experience_check_item">
                                        <span>Enregistrement studio</span>
                                        <input type="checkbox" {% for item in experience.exp_besoins %}{% if item.metaValue == 'Enregistrement studio' %}checked{% endif %}{% endfor %} name="besoins[]" value="Enregistrement studio" class="form-control radio_custom field_besoins"/>
                                    </label>
                                    <label class="experience_check_item">
                                        <span>Mixage audio</span>
                                        <input type="checkbox" {% for item in experience.exp_besoins %}{% if item.metaValue == 'Mixage audio' %}checked{% endif %}{% endfor %} name="besoins[]" value="Mixage audio" class="form-control radio_custom field_besoins"/>
                                    </label>
                                    <label class="experience_check_item">
                                        <span>Mastering audio</span>
                                        <input type="checkbox" {% for item in experience.exp_besoins %}{% if item.metaValue == 'Mastering audio' %}checked{% endif %}{% endfor %} name="besoins[]" value="Mastering audio" class="form-control radio_custom field_besoins"/>
                                    </label>
                                    <label class="experience_check_item">
                                        <span>Percussionniste</span>
                                        <input type="checkbox" {% for item in experience.exp_besoins %}{% if item.metaValue == 'Percussionniste' %}checked{% endif %}{% endfor %} name="besoins[]" value="Percussionniste" class="form-control radio_custom field_besoins"/>
                                    </label>
                                    <label class="experience_check_item">
                                        <span>Batteur</span>
                                        <input type="checkbox" {% for item in experience.exp_besoins %}{% if item.metaValue == 'Batteur' %}checked{% endif %}{% endfor %} name="besoins[]" value="Batteur" class="form-control radio_custom field_besoins"/>
                                    </label>
                                    <label class="experience_check_item">
                                        <span>Bassiste</span>
                                        <input type="checkbox" {% for item in experience.exp_besoins %}{% if item.metaValue == 'Bassiste' %}checked{% endif %}{% endfor %} name="besoins[]" value="Bassiste" class="form-control radio_custom field_besoins"/>
                                    </label>
                                    <label class="experience_check_item">
                                        <span>Guitariste</span>
                                        <input type="checkbox" {% for item in experience.exp_besoins %}{% if item.metaValue == 'Guitariste' %}checked{% endif %}{% endfor %} name="besoins[]" value="Guitariste" class="form-control radio_custom field_besoins"/>
                                    </label>
                                    <label class="experience_check_item">
                                        <span>Pianiste</span>
                                        <input type="checkbox" {% for item in experience.exp_besoins %}{% if item.metaValue == 'Pianiste' %}checked{% endif %}{% endfor %} name="besoins[]" value="Pianiste" class="form-control radio_custom field_besoins"/>
                                    </label>
                                    <label class="experience_check_item">
                                        <span>Cuivres</span>
                                        <input type="checkbox" {% for item in experience.exp_besoins %}{% if item.metaValue == 'Cuivres' %}checked{% endif %}{% endfor %} name="besoins[]" value="Cuivres" class="form-control radio_custom field_besoins"/>
                                    </label>
                                    <label class="experience_check_item">
                                        <span>Choeurs gospel</span>
                                        <input type="checkbox" {% for item in experience.exp_besoins %}{% if item.metaValue == 'Chœurs gospel' or item.metaValue == 'Choeurs gospel' %}checked{% endif %}{% endfor %} name="besoins[]" value="Choeurs gospel" class="form-control radio_custom field_besoins"/>
                                    </label>
                                    <label class="experience_check_item">
                                        <span>Choristes</span>
                                        <input type="checkbox" {% for item in experience.exp_besoins %}{% if item.metaValue == 'Choristes' %}checked{% endif %}{% endfor %} name="besoins[]" value="Choristes" class="form-control radio_custom field_besoins"/>
                                    </label>
                                </div>
                                <div class="musique_choose" style="margin-top: 2rem;">
                                    <h2>Ajoutez vos options</h2>
                                </div>
                                <div class="experience_checklist musique_choose">
                                    <label class="experience_check_item">
                                        <span>Captation video</span>
                                        <input type="checkbox" {% for item in experience.exp_options %}{% if item.metaValue == 'Captation vidéo' or item.metaValue == 'Captation video' %}checked{% endif %}{% endfor %} name="options[]" value="Captation video" class="form-control radio_custom field_options"/>
                                    </label>
                                    <label class="experience_check_item">
                                        <span>Photographie</span>
                                        <input type="checkbox" {% for item in experience.exp_options %}{% if item.metaValue == 'Photographie' %}checked{% endif %}{% endfor %} name="options[]" value="Photographie" class="form-control radio_custom field_options"/>
                                    </label>
                                    <label class="experience_check_item">
                                        <span>Clip video</span>
                                        <input type="checkbox" {% for item in experience.exp_options %}{% if item.metaValue == 'Clip vidéo' or item.metaValue == 'Clip video' %}checked{% endif %}{% endfor %} name="options[]" value="Clip video" class="form-control radio_custom field_options"/>
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="form-group list_field">
                            <label for=""><h2>Précisions complémentaires</h2></label>
                            <textarea name="precisions" id="precisions" class="field_precisions form-control" cols="30"
                                      rows="5"
                                      placeholder="Donnez-nous des détails pour nous permettre de personnaliser votre offre.">{{ experience.exp_precisions }}</textarea>
                        </div>
                    </div>
                    <div class="step4 steps" style="display: none;" attr-step="4" attr-title="Projet : Production musicale">
                        <div class="recap_choix">
                            <div class="inline_choix musique_choose">
                                <h2>Ville:</h2>
                                <p style="font-weight: 300;" class="villeValue">Paris 15ème</p>
                            </div>
                            <div class="inline_choix musique_choose">
                                <h2>Style musical:</h2>
                                <p style="font-weight: 300;" class="universValue">Paris 15ème</p>
                            </div>
                            </div>
                            <div style="margin-top: 3rem;">
                                <h2>Liste de vos besoins:</h2>
                                <div class="besoinValue" style="margin-top: 1.7rem;">
                                    <p style="font-weight: 300;margin-bottom: 1rem;">Pop / Folk</p>
                                </div>
                            </div>
                            <div style="margin-top: 3rem;" class="musique_choose">
                                <h2>Les options retenues:</h2>
                                <div class="optionValue" style="margin-top: 1.7rem;">
                                    <p style="font-weight: 300;margin-bottom: 1rem;">Pop / Folk</p>
                                </div>
                            </div>
                            <div style="margin-top: 3rem;">
                                <h2>Vos précisions pour une offre sur mesure:</h2>
                                <textarea class="precisionValue field_precisions_2 form-control" name="precisions_2"
                                          id="precisions_2" class="form-control" cols="30" rows="5"
                                          placeholder="Donnez-nous des détails pour nous permettre de personnaliser votre offre.">{{ experience.exp_precisions }}</textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="container experience_success_content" style="display: none;">
                <div class="success_icon">
                    <span class="fa fa-check"></span>
                </div>
                <p>
                    Votre demande d'expérience a été créée et validée. Nos équipes prennent le relais et reviennent vers
                    vous dans les plus brefs délais avec une offre adaptée. Dès que notre proposition est disponible,
                    vous recevrez une notification et elle sera consultable depuis votre compte utilisateur.
                </p>
                <p>
                    Merci d'avoir choisi <strong style="font-family: 'Palanquin Dark', sans-serif;color: black;">TRUST &
                        MARKET</strong>.
                </p>
                <div class="experience_success_content_links">
                    <a href="{{ path('experiences_liste_experience') }}" class="dark_link">MON TABLEAU DE BORD</a>
                    <a href="{{ path('experiences_index') }}" class="orange_link">UNIVERS TRUST</a>
                </div>
            </div>
        </main>
        <!--Main layout-->
    </div>
{% endblock %}


{% block footer %}
    <div class="prefooter_action">
        <a href="#" class="action_prev hidden">Précédent</a>
        <a href="#" class="action_next disabled">Suivant</a>
    </div>
    {{ parent() }}

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('toastr/toastr.min.js') }}"></script>
    <!-- Full background slider jQuery plugin -->
    <script type="text/javascript" src="{{ asset('assets/js/fullclip.min.js') }}"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-timeago/1.6.7/jquery.timeago.js"></script>
    <script src="{{ asset('assets/js/lc_lightbox.js') }}" type="text/javascript"></script>
    <!-- SKINS -->
    <link rel="stylesheet" href="{{ asset('assets/css/lc_lightbox_skins_dark.css') }}"/>
    <!-- ASSETS -->
    <script src="{{ asset('assets/js/alloy_finger.min.js') }}" type="text/javascript"></script>
    {# <script type="text/javascript"
            src="https://raw.githubusercontent.com/jquery/jquery-ui/master/ui/i18n/datepicker-fr.js">
    </script>#}
    <script src = "https://unpkg.com/sweetalert/dist/sweetalert.min.js" ></script>
    <script>
        var actualStep = 1;
        var checkedCheck = 0;
        var typeExperience = "Production musicale";
        var checkboxValues = [];
        var optionsValues = [];

        function removeDuplicates(array) {
            return array.filter((a, b) => array.indexOf(a) === b)
        }

        function updateStepper(step) {
            var progressWidth = (step / 4) * 100;
            $('.experience_stepper_count').text('Etape ' + step + ' sur 4');
            $('.experience_stepper_progress').css('width', progressWidth + '%');
            $('.experience_stepper_label').removeClass('is-active is-complete');
            $('.experience_stepper_label').each(function (index) {
                if ((index + 1) < step) {
                    $(this).addClass('is-complete');
                } else if ((index + 1) === step) {
                    $(this).addClass('is-active');
                }
            });
        }

        $('.step1 .list_option').addClass('active')
        $('.action_next').addClass('active');
        $('.action_next').removeClass('disabled');
        updateStepper(1);
        // actualStep = 2;

        $(document).on('click', '.list_option', function () {
            $(this).parent().find('.list_option').removeClass('active');
            $(this).addClass('active');
            $('.action_next').addClass('active');
            $('.action_next').removeClass('disabled');
            actualStep = $(this).parent().attr('attr-step');
            if (actualStep == 2) {
                var choixTitle = $(this).find('h2').text();
                typeExperience = choixTitle;
                $('.step3').attr("attr-title", "Projet : " + choixTitle)
            }
        })
        $(document).on('change', '.besoins .radio_custom', function () {
            checkedCheck = 0;
            $('.besoins .radio_custom').each(function () {
                if ($(this).is(":checked")) {
                    checkedCheck++
                    if ($("input[name='ville']").val() != "" && $("input[name='univers']").val() != "") {
                        $('.action_next').addClass('active');
                        $('.action_next').removeClass('disabled');
                        actualStep = $(this).closest('.steps').attr('attr-step');
                    }
                }
            });
            console.log("checkedCheck value::: ", checkedCheck);
            if (checkedCheck == 0) {
                $('.action_next').removeClass('active');
                $('.action_next').addClass('disabled');
            }
        })
        $(document).on('keyup', '.input_rounded', function () {
            if ($("input[name='ville']").val() != "" && $("input[name='univers']").val() != "" && checkedCheck > 0) {
                $('.action_next').addClass('active');
                $('.action_next').removeClass('disabled');
                actualStep = $(this).parent().parent().attr('attr-step');
            } else {
                $('.action_next').removeClass('active');
                $('.action_next').addClass('disabled');
            }
        })
        $(document).on('click', '.action_next', function (e) {
            e.preventDefault();
            actualStep = parseInt(actualStep) + 1;
            if (actualStep < 5) {
                $('.steps').css('display', 'none')
                $('.step' + actualStep).css('display', '')
                var titreExp = $('.step' + actualStep).attr('attr-title');
                $('.experience_create_content h1').text(titreExp == undefined ? "{{ experience.exp_type_experience }}" : titreExp)
                updateStepper(actualStep);
                $('.action_prev').removeClass('hidden');
                if (actualStep > 2) {
                    $('.saveAndClose').fadeIn();
                } else {
                    $('.saveAndClose').fadeOut(300);
                }
                if ($('.step' + actualStep).find('.list_option.active').length == 0 && actualStep != 4) {
                    $(this).removeClass('active');
                    $(this).addClass('disabled');
                }
                if (actualStep == 2) {
                    $(this).addClass('active');
                    $(this).removeClass('disabled');
                }

                if (actualStep == 4) {
                    $(this).text('Valider')
                    $('.action_next').addClass('active');
                    $('.action_next').removeClass('disabled');
                    $('.experience_create_content h1').text(typeExperience == undefined ? "Projet : {{ experience.exp_type_experience }}" : "Projet : " + typeExperience)
                    $('.villeValue').text($(".field_ville").val());
                    $('.universValue').text($(".field_univers").val());
                    $('.precisionValue').val($(".field_precisions").val());
                    checkboxValues = [];
                    optionsValues = [];
                    $('input[name="besoins[]"]:checked').each(function () {
                        checkboxValues[checkboxValues.length] = (this.checked ? $(this).val() : "");
                    });
                    $('input[name="options[]"]:checked').each(function () {
                        optionsValues[optionsValues.length] = (this.checked ? $(this).val() : "");
                    });
                    $('.besoinValue').empty();
                    removeDuplicates(checkboxValues).forEach((element) => {
                        $('.besoinValue').append('<p style="font-weight: 300;margin-bottom: 1rem;">' + element + '</p>');
                    })
                    $('.optionValue').empty();
                    removeDuplicates(optionsValues).forEach((element) => {
                        $('.optionValue').append('<p style="font-weight: 300;margin-bottom: 1rem;">' + element + '</p>');
                    })
                } else {
                    $(this).text('Suivant')
                }
                if (actualStep > 3) {
                    $("html, body").animate({scrollTop: 0}, "slow");
                } else if (actualStep == 3) {
                    $('.experience_create_content h1').text(typeExperience == undefined ? "Projet : {{ experience.exp_type_experience }}" : "Projet : " + typeExperience)
                    checkedCheck = 0;
                    $('.besoins .radio_custom').each(function () {
                        if ($(this).is(":checked")) {
                            checkedCheck++
                        }
                    });
                    if ($("input[name='ville']").val() != "" && $("input[name='univers']").val() != "" && checkedCheck > 0) {
                        $(this).addClass('active');
                        $(this).removeClass('disabled');
                    }
                }
            } else {
                $(this).append('<span class="spinner-grow"></span>');
                submitData('publish');
            }
        })
        $(document).on('click', '.action_prev', function () {
            actualStep = parseInt(actualStep) - 1;
            if (actualStep == 1) {
                $(this).addClass('hidden');
            }
            if (actualStep > 2) {
                $('.saveAndClose').fadeIn();
            } else {
                $('.saveAndClose').fadeOut(300);
            }
            $('.steps').css('display', 'none')
            if (actualStep > 3) {
                $("html, body").animate({scrollTop: 0}, "slow");
            }
            $('.step' + actualStep).css('display', '')
            $('.experience_create_content h1').text($('.step' + actualStep).attr('attr-title'))
            updateStepper(actualStep);
            $('.action_next').addClass('active');
            $('.action_next').removeClass('disabled');
            if (actualStep == 4) {
                // $(this).text('Valider')
                $('.action_next').addClass('active');
                $('.action_next').removeClass('disabled');
            } else {
                $(this).text('Précédent')
                $('.action_next').text('Suivant')
            }
        })

        $(document).on('click', '.saveAndClose', function (e) {
            e.preventDefault();
            $(this).append('<span class="spinner-grow" style="position: relative;top:-4.5px;"></span>');
            submitData('draft');
        })

        function submitData(status) {
            var data = new FormData();
            data.append('ville', $(".field_ville").val());
            data.append('univers', $(".field_univers").val());
            $('input[name="besoins[]"]:checked').each(function () {
                data.append('besoins[]', this.checked ? $(this).val() : "");
            });
            $('input[name="options[]"]:checked').each(function () {
                data.append('options[]', this.checked ? $(this).val() : "");
            });
            data.append('precisions', $(".field_precisions_2").val());
            data.append('type_experience', typeExperience);
            data.append('status', status);
            data.append('postId', "{{ experience.id }}");

            console.log(data);
            $.ajax({
                url: "{{ path('experiences_update_experience') }}",
                type: 'POST',
                processData: false,
                contentType: false,
                data: data,
                success: function (data) {
                    if (data.response == "error") {
                        $('.spinner-grow').remove();
                        swal("Oups!", data.message, "error");
                    } else if (data.response == "success") {
                        $('.spinner-grow').remove();
                        /* $('.prefooter_action').remove()
                        $('.experience_create_content').remove()
                        $('.saveAndClose').remove()
                        $('.experience_success_content').fadeIn(500) */
                        window.location = "{{ path('experiences_liste_experience') }}";
                    } else {
                        $('.spinner-grow').remove();
                        /* $('.prefooter_action').remove()
                        $('.experience_create_content').remove()
                        $('.saveAndClose').remove()
                        $('.experience_success_content').fadeIn(500) */
                        window.location = "{{ path('experiences_liste_experience') }}";
                        // $('.spinner-grow').remove();
                        // swal("Oups!", "Une erreur est survenue. Veuillez reesayer plutard.", "error");
                    }
                },
                error: function (error) {
                    $('.spinner-grow').remove();
                    swal("Oups!", "Une erreur est survenue. Veuillez reesayer plutard.", "error");
                }
            });
        }

        $(document).ready(function (e) {

            // live handler
            lc_lightbox('.carousel-card', {
                wrap_class: 'lcl_fade_oc',
                gallery: true,
                thumb_attr: 'data-lcl-thumb',
                skin: 'dark',
                radius: 0,
                padding: 0,
                border_w: 0,
                src_attr: 'attr-src',
                max_width: '93%',
                max_height: '93%',
                show_author: false,
                show_title: true,
                show_descr: true,
                thumbs_nav: true,
                tn_hidden: 0,
                txt_hidden: 0,
            });

            main();


            $('.date_input').datepicker({
                dateFormat: 'dd-M-yy',
                minDate: 1,
                closeText: 'Fermer',
                prevText: 'Précédent',
                nextText: 'Suivant',
                currentText: 'Aujourd\'hui',
                monthNames: ['Janvier', 'Février', 'Mars', 'Avril', 'Mai', 'Juin', 'Juillet', 'Août', 'Septembre', 'Octobre', 'Novembre', 'Décembre'],
                monthNamesShort: ['Janv.', 'Févr.', 'Mars', 'Avril', 'Mai', 'Juin', 'Juil.', 'Août', 'Sept.', 'Oct.', 'Nov.', 'Déc.'],
                dayNames: ['Dimanche', 'Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi'],
                dayNamesShort: ['Dim.', 'Lun.', 'Mar.', 'Mer.', 'Jeu.', 'Ven.', 'Sam.'],
                dayNamesMin: ['D', 'L', 'M', 'M', 'J', 'V', 'S'],
                weekHeader: 'Sem.'
            },);

            $('.date_icon').on('click', function () {
                $('.date_input').focus();
            })

            $("#numero_telephone").keyup(function () {
                let phone = $("#numero_telephone").val().replace(/\s|[a-zA-Z]/g, "");
                $("#numero_telephone").val(phone);
            });
        });
        var slideSpeed = 10000;

        var main = function () {
            //Carousel
            setInterval(function () {
                timedDelay()
            }, slideSpeed);
            //arrow-next
            $('.arrow-next').click(function (e) {
                e.preventDefault();

                var currentSlide = $('.active-slide');
                var nextSlide = currentSlide.next();

                var currentDot = $('.active-dot');
                var nextDot = currentDot.next();

                if (nextSlide.length === 0) {
                    nextSlide = $('.slide').first();
                    nextDot = $('.dot').first();
                }

                currentSlide.fadeOut(600, function () {
                    $(this).removeClass('active-slide');
                    nextSlide.fadeIn(600).addClass('active-slide');

                    currentDot.removeClass('active-dot');
                    nextDot.addClass('active-dot');
                });
            });
            //arrow-prev
            $('.arrow-prev').click(function (e) {
                e.preventDefault();

                var currentSlide = $('.active-slide');
                var prevSlide = currentSlide.prev();

                var currentDot = $('.active-dot');
                var prevDot = currentDot.prev();

                if (prevSlide.length === 0) {
                    prevSlide = $('.slide').last();
                    prevDot = $('.dot').last();
                }

                currentSlide.fadeOut(600, function () {
                    $(this).removeClass('active-slide');
                    prevSlide.fadeIn(600).addClass('active-slide');

                    currentDot.removeClass('active-dot');
                    prevDot.addClass('active-dot');
                });
            });
        };

        //timedDelay function
        function timedDelay() {
            var currentSlide = $('.active-slide');
            var nextTimedSlide = currentSlide.next();
            var currentDot = $('.active-dot');
            var nextDot = currentDot.next();
            if (nextTimedSlide.length === 0) {
                nextTimedSlide = $('.slide').first();
                nextDot = $('.dot').first();
            }
            currentSlide.fadeOut(600, function () {
                $(this).removeClass('active-slide');
                nextTimedSlide.fadeIn(600).addClass('active-slide');

                currentDot.removeClass('active-dot');
                nextDot.addClass('active-dot');
            });
        }

        $('#submitForm').on('submit', function (e) {
            e.preventDefault();
            if ($('.numero_telephone').val().match(/^(?:(?:\+|00)33|0)\s*[1-9](?:[\s.-]*\d{2}){4}$/gmi)) {
                toastr.info('{{ 'systeme.requetes.requete-en-cours'|trans }}');
                var $form = $(this);
                var formdata = (window.FormData) ? new FormData($form[0]) : null;
                formdata.append('status', 'publish');
                var data = (formdata !== null) ? formdata : $form.serialize();

                $.ajax({
                    url: $form.attr('action'),
                    type: $form.attr('method'),
                    contentType: false,
                    processData: false,
                    data: data,
                    success: function (reponse) {
                        window.location = "";
                        if (reponse != 0) {
                            toastr.clear();
                            toastr.success('{{ 'systeme.requetes.succes'|trans }}');
                        } else if (reponse == 0) {
                            toastr.clear();
                            toastr.error('{{ 'systeme.requetes.erreur'|trans }}');
                        }

                    },
                    error: function (reponse) {
                        toastr.clear();
                        toastr.error('{{ 'systeme.requetes.erreur'|trans }}');
                    }
                });
            } else {
                toastr.warning('Entrez un numéro de téléphone valide');
            }
            return false;
        });
    </script>

{% endblock %}
