{% set status = field.value %}
{% set colors = {
    'pending': '#6c757d',
    'processing': '#0d6efd',
    'approved': '#198754',
    'manual_review': '#fd7e14',
    'failed': '#dc3545',
    'cancelled': '#343a40'
} %}
{% set label = status ?: '-' %}
{% set color = colors[status]|default('#6c757d') %}

<span style="display:inline-block; padding:4px 8px; border-radius:999px; background:{{ color }}; color:#fff; font-size:12px; font-weight:600;">
    {{ label }}
</span>
