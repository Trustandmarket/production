{% set job = entity.instance %}
{% set announcement = job.announcement %}

<div style="display:flex; flex-direction:column; gap:4px; min-width:240px;">
    <strong>{{ job.announcementLabel }}</strong>
    <span style="font-size:12px; color:#6c757d;">ID: {{ announcement ? announcement.id : '-' }}</span>
    <div style="display:flex; gap:8px; flex-wrap:wrap;">
        {% if announcement %}
            {% set editUrl = ea_url()
                .setController('App\\Controller\\Admin\\Annonces\\Annonces\\WpPostsCrudController')
                .setAction('edit')
                .setEntityId(announcement.id)
            %}
            <a href="{{ editUrl }}">Edit BO</a>
            {% if announcement.postName %}
                <a href="{{ path('annonces_detailsAnnonce', {'id': announcement.postName}) }}" target="_blank" rel="noopener noreferrer">Voir front</a>
            {% endif %}
        {% else %}
            <span style="color:#6c757d;">Annonce supprimee</span>
        {% endif %}
    </div>
</div>
