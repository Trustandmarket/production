{% set job = entity.instance %}

<div style="display:flex; flex-direction:column; gap:4px;">
    <span>{{ job.checksSummaryLabel }}</span>
    <span style="font-size:12px; color:#6c757d;">
        Hard rules: {{ job.hardRulesPass is null ? '-' : (job.hardRulesPass ? 'OK' : 'KO') }}
        |
        IA: {{ job.aiPass is null ? '-' : (job.aiPass ? 'OK' : 'KO') }}
    </span>
</div>
