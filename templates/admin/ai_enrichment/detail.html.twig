{% extends '@!EasyAdmin/layout.html.twig' %}

{% block page_title %}
    Trust Agentique IA - Job #{{ job_id }}
{% endblock %}

{% block main %}
    <style>
        .tm-ai-head { display: flex; justify-content: space-between; gap: 10px; align-items: center; flex-wrap: wrap; margin-bottom: 14px; }
        .tm-ai-head a { color: #1d4ed8; text-decoration: none; font-weight: 600; }
        .tm-ai-grid { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); margin-bottom: 12px; }
        .tm-ai-card { border: 1px solid #e2e8f0; border-radius: 10px; background: #fff; padding: 12px; }
        .tm-ai-label { font-size: 12px; color: #64748b; text-transform: uppercase; }
        .tm-ai-value { margin-top: 6px; font-size: 14px; color: #0f172a; word-break: break-word; }
        .tm-ai-tag { display: inline-block; border-radius: 999px; padding: 3px 8px; font-size: 11px; font-weight: 700; text-transform: uppercase; }
        .tm-ai-tag-pending { background: #fff7ed; color: #c2410c; }
        .tm-ai-tag-processing { background: #eff6ff; color: #1d4ed8; }
        .tm-ai-tag-awaiting_user { background: #ecfeff; color: #0f766e; }
        .tm-ai-tag-applying { background: #ede9fe; color: #6d28d9; }
        .tm-ai-tag-success { background: #ecfdf5; color: #166534; }
        .tm-ai-tag-failed { background: #fef2f2; color: #b91c1c; }
        .tm-ai-muted { color: #64748b; }
        .tm-ai-table-wrap { overflow: auto; border: 1px solid #e2e8f0; border-radius: 10px; background: #fff; }
        .tm-ai-table { width: 100%; border-collapse: collapse; min-width: 1100px; }
        .tm-ai-table th, .tm-ai-table td { padding: 10px; border-bottom: 1px solid #e2e8f0; text-align: left; vertical-align: top; font-size: 13px; }
        .tm-ai-table th { background: #f8fafc; color: #334155; }
        .tm-ai-error { margin: 10px 0; color: #b91c1c; font-weight: 600; }
        pre.tm-ai-json { white-space: pre-wrap; margin: 0; font-size: 12px; color: #1f2937; }
    </style>

    <div class="tm-ai-head">
        <h2 style="margin:0;">Trust Agentique IA - Job #{{ job_id }}</h2>
        <a href="{{ jobs_url }}">Retour liste jobs</a>
    </div>

    <div id="jobError" class="tm-ai-error" style="display:none;"></div>

    <div id="jobMeta" class="tm-ai-grid"></div>

    <div class="tm-ai-card" style="margin-bottom:12px;">
        <div class="tm-ai-label">Decisions summary</div>
        <div id="jobSummary" class="tm-ai-value">-</div>
    </div>

    <div class="tm-ai-table-wrap">
        <table class="tm-ai-table">
            <thead>
            <tr>
                <th>ID</th>
                <th>Field</th>
                <th>Status</th>
                <th>Confidence</th>
                <th>Source</th>
                <th>Suggested value</th>
                <th>Final value</th>
                <th>Updated</th>
            </tr>
            </thead>
            <tbody id="suggestionsTbody">
            <tr><td colspan="8" class="tm-ai-muted">Chargement...</td></tr>
            </tbody>
        </table>
    </div>

    <script>
        (() => {
            const jobId = {{ job_id }};
            const errorBox = document.getElementById('jobError');
            const metaBox = document.getElementById('jobMeta');
            const summaryBox = document.getElementById('jobSummary');
            const tbody = document.getElementById('suggestionsTbody');

            const showError = (message) => {
                errorBox.style.display = 'block';
                errorBox.textContent = message;
            };

            const clearError = () => {
                errorBox.style.display = 'none';
                errorBox.textContent = '';
            };

            const statusTag = (status) => {
                const safe = String(status || '').replace(/[^a-z_]/g, '');
                return `<span class="tm-ai-tag tm-ai-tag-${safe}">${status}</span>`;
            };

            const toJson = (value) => {
                if (value === null || value === undefined) return '-';
                if (typeof value === 'string') return value;
                try {
                    return JSON.stringify(value, null, 2);
                } catch (e) {
                    return String(value);
                }
            };

            const renderMeta = (job) => {
                const profile = job.profile || {};
                const profileLabel = profile.display_name
                    ? `#${job.profile_id} - ${profile.display_name}`
                    : `#${job.profile_id}`;
                const profileUrl = profile.admin_detail_url || '#';

                const blocks = [
                    ['Status', statusTag(job.status || '-')],
                    ['Profile', `<a href="${profileUrl}" target="_blank" rel="noopener">${profileLabel}</a>`],
                    ['Input type', job.input_type || '-'],
                    ['Input value', job.input_value || '-'],
                    ['Confidence global', job.confidence_global ?? '-'],
                    ['Attempts', job.attempt_count ?? 0],
                    ['Prompt version', job.prompt_version || '-'],
                    ['Created at', job.created_at || '-'],
                    ['Updated at', job.updated_at || '-'],
                    ['Last error', job.last_error || '-']
                ];

                metaBox.innerHTML = blocks.map(([label, value]) => `
                    <div class="tm-ai-card">
                        <div class="tm-ai-label">${label}</div>
                        <div class="tm-ai-value">${value}</div>
                    </div>
                `).join('');
            };

            const renderSummary = (summary) => {
                const s = summary || {};
                summaryBox.textContent = `suggested: ${s.suggested || 0} | accepted: ${s.accepted || 0} | edited: ${s.edited || 0} | rejected: ${s.rejected || 0}`;
            };

            const renderSuggestions = (suggestions) => {
                tbody.innerHTML = '';
                if (!Array.isArray(suggestions) || suggestions.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="8" class="tm-ai-muted">Aucune suggestion.</td></tr>';
                    return;
                }

                suggestions.forEach((row) => {
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td>#${row.id}</td>
                        <td>${row.field_name || '-'}</td>
                        <td>${statusTag(row.status || '-')}</td>
                        <td>${row.confidence_score ?? '-'}</td>
                        <td>${row.source_type || '-'}</td>
                        <td><pre class="tm-ai-json">${toJson(row.suggested_value)}</pre></td>
                        <td><pre class="tm-ai-json">${toJson(row.final_value)}</pre></td>
                        <td>${row.updated_at || '-'}</td>
                    `;
                    tbody.appendChild(tr);
                });
            };

            const load = async () => {
                clearError();
                try {
                    const response = await fetch(`/bo/enrichment-jobs/${jobId}`, {
                        method: 'GET',
                        credentials: 'include'
                    });
                    const payload = await response.json();
                    if (!response.ok || !payload.ok) {
                        throw new Error(payload.error || 'Erreur chargement detail job');
                    }

                    renderMeta(payload.job || {});
                    renderSummary(payload.suggestions_summary || {});
                    renderSuggestions(payload.suggestions || []);
                } catch (error) {
                    showError(error.message || 'Erreur inconnue');
                    tbody.innerHTML = '<tr><td colspan="8" class="tm-ai-muted">Echec de chargement.</td></tr>';
                }
            };

            load();
        })();
    </script>
{% endblock %}
