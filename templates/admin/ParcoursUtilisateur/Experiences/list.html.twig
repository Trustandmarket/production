{% extends '@!EasyAdmin/layout.html.twig' %}
{% block page_title %}
    Parcours utilisateur - Experiences
{% endblock %}

{% block main %}
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.0.0-alpha.4/css/bootstrap.min.css"
          integrity="sha512-FOS5ANNUsuvefA5Fm6hZBLsxqfF105LIysEgV8VNz29jZLVYIhI+MOLKPBmMXgkHhARFHf5pE7KbXOLE6TXW0A=="
          crossorigin="anonymous" referrerpolicy="no-referrer"/>
    <link rel="stylesheet" href="{{ asset('toastr/toastr.min.css') }}">
    <link rel="stylesheet" href="{{ asset('admin/assets/sweetalert/sweetalert.css') }}">
    <link rel="stylesheet" href="{{ asset('admin/assets/css/loading-btn.css') }}">
    <link rel="stylesheet" href="{{ asset('admin/assets/css/loading.css') }}">
    <style>
        #main-menu { font-size: 14px; }
        .bo-filters {
            padding: 14px 16px;
            background: #fafafa;
            border-bottom: 1px solid #ececec;
        }
        .bo-filters .form-control { min-height: 38px; }
        .bo-table-meta {
            padding: 10px 16px;
            font-size: 13px;
            color: #666;
            border-bottom: 1px solid #f0f0f0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
        }
        .bulk-actions {
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .bulk-count { color: #495057; }
        .sortable-link {
            color: #2f466b;
            text-decoration: none;
            white-space: nowrap;
        }
        .sortable-link:hover { text-decoration: underline; }
        .table td, .table th { vertical-align: middle; }
        .row-actions { position: relative; display: inline-block; }
        .row-actions-toggle {
            border: 1px solid #d7dce2;
            background: #fff;
            color: #2f466b;
            min-width: 34px;
            height: 30px;
            border-radius: 6px;
            font-weight: 700;
            line-height: 1;
            cursor: pointer;
        }
        .row-actions-menu {
            display: none;
            position: absolute;
            right: 0;
            top: calc(100% + 6px);
            min-width: 150px;
            z-index: 1200;
            background: #fff;
            border: 1px solid #d7dce2;
            border-radius: 8px;
            box-shadow: 0 10px 24px rgba(0,0,0,.14);
            padding: 6px;
        }
        .row-actions-menu.open { display: block; }
        .row-actions-item {
            display: block;
            width: 100%;
            padding: 7px 9px;
            color: #2f2f2f;
            text-decoration: none;
            border-radius: 6px;
            font-size: 13px;
        }
        .row-actions-item:hover {
            background: #f4f7fb;
            text-decoration: none;
        }
        .type-filter-dropdown { position: relative; }
        .type-filter-toggle {
            width: 100%;
            min-height: 38px;
            border: 1px solid #ced4da;
            border-radius: .25rem;
            background: #fff;
            text-align: left;
            padding: .375rem .75rem;
            color: #495057;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
        }
        .type-filter-toggle .type-filter-label {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .type-filter-toggle .type-filter-caret {
            font-size: 11px;
            color: #7a7f86;
            flex: 0 0 auto;
        }
        .type-filter-menu {
            display: none;
            position: absolute;
            top: calc(100% + 4px);
            left: 0;
            right: 0;
            z-index: 1200;
            background: #fff;
            border: 1px solid #ced4da;
            border-radius: .25rem;
            box-shadow: 0 8px 20px rgba(0,0,0,.12);
            max-height: 230px;
            overflow-y: auto;
            padding: 8px 10px;
        }
        .type-filter-menu.open { display: block; }
        .type-filter-actions {
            display: flex;
            justify-content: space-between;
            gap: 8px;
            margin-bottom: 8px;
            padding-bottom: 8px;
            border-bottom: 1px solid #edf0f3;
        }
        .type-filter-actions button {
            background: none;
            border: 0;
            padding: 0;
            color: #2f466b;
            font-size: 13px;
            cursor: pointer;
        }
        .type-filter-option {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 6px;
            font-size: 14px;
            color: #2f2f2f;
        }
        .type-filter-option:last-child { margin-bottom: 0; }
        .email-filter-dropdown { position: relative; }
        .email-filter-input {
            width: 100%;
            min-height: 38px;
            border: 1px solid #ced4da;
            border-radius: .25rem;
            background: #fff;
            padding: .375rem .75rem;
            color: #495057;
        }
        .email-filter-menu {
            display: none;
            position: absolute;
            top: calc(100% + 4px);
            left: 0;
            right: 0;
            z-index: 1200;
            background: #fff;
            border: 1px solid #ced4da;
            border-radius: .25rem;
            box-shadow: 0 8px 20px rgba(0,0,0,.12);
            max-height: 230px;
            overflow-y: auto;
            padding: 6px;
        }
        .email-filter-menu.open { display: block; }
        .email-filter-option {
            width: 100%;
            border: 0;
            background: transparent;
            text-align: left;
            padding: 6px 8px;
            border-radius: 4px;
            color: #2f2f2f;
            font-size: 14px;
            cursor: pointer;
        }
        .email-filter-option:hover {
            background: #f4f7fb;
        }
        .email-filter-empty {
            padding: 6px 8px;
            color: #8a9097;
            font-size: 13px;
        }
        .exp-preview-modal .modal-dialog {
            max-width: 920px;
            width: calc(100% - 24px);
            margin: 18px auto;
        }
        .exp-preview-modal .modal-content {
            border-radius: 12px;
            overflow: hidden;
            max-height: calc(100vh - 36px);
            display: flex;
            flex-direction: column;
        }
        .exp-preview-modal .modal-header {
            border-bottom: 1px solid #eceff3;
            background: #fff;
            flex: 0 0 auto;
        }
        .exp-preview-modal .modal-body {
            overflow-y: auto;
            padding: 16px;
            background: #fafbfc;
            flex: 1 1 auto;
        }
        .exp-preview-modal .modal-footer {
            border-top: 1px solid #eceff3;
            background: #fff;
            flex: 0 0 auto;
        }
        .exp-preview-card {
            background: #fff;
            border: 1px solid #e8ebf0;
            border-radius: 12px;
            padding: 14px;
            margin-bottom: 12px;
        }
        .exp-preview-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px 14px;
        }
        .exp-preview-item strong {
            display: block;
            color: #2f466b;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: .03em;
            margin-bottom: 3px;
        }
        .exp-preview-item span {
            color: #1e2a35;
            font-size: 14px;
            word-break: break-word;
        }
        .exp-preview-chips {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }
        .exp-preview-chip {
            display: inline-flex;
            align-items: center;
            padding: 5px 10px;
            border-radius: 999px;
            font-size: 13px;
            background: #f2f6fb;
            border: 1px solid #dde7f2;
            color: #2f466b;
        }
        .exp-preview-text {
            margin: 0;
            white-space: pre-wrap;
            font-size: 14px;
            color: #1e2a35;
        }
        .exp-preview-empty {
            color: #8a9097;
            font-size: 13px;
            margin: 0;
        }
        @media (max-width: 768px) {
            .exp-preview-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
    <div class="content">
        <div class="animated fadeIn">
            <div class="clearfix"></div>
            <div class="row">
                <div class="col-lg-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="box-title">Parcours utilisateur - Experiences</h4>
                        </div>
                        <div class="card-body--">
                            {% set query = app.request.query.all %}
                            {% set baseQuery = query|merge({'_locale': lang}) %}

                            <div class="bo-filters">
                                <form method="get" action="{{ path('admin', baseQuery) }}" class="row">
                                    {% for key, val in query %}
                                        {% if key not in ['q', 'status', 'type', 'email', 'page', 'sort_by', 'sort_dir', 'per_page'] %}
                                            {% if val is iterable %}
                                                {% for subVal in val %}
                                                    <input type="hidden" name="{{ key }}[]" value="{{ subVal }}">
                                                {% endfor %}
                                            {% else %}
                                                <input type="hidden" name="{{ key }}" value="{{ val }}">
                                            {% endif %}
                                        {% endif %}
                                    {% endfor %}
                                    <div class="col-md-3 mb-2">
                                        <input class="form-control" type="text" name="q" value="{{ filters.q }}" placeholder="Recherche globale (id, email, ville, univers)">
                                    </div>
                                    <div class="col-md-2 mb-2">
                                        <select class="form-control" name="status">
                                            <option value="">Tous statuts</option>
                                            <option value="draft" {{ filters.status == 'draft' ? 'selected' : '' }}>Brouillon</option>
                                            <option value="publish" {{ filters.status == 'publish' ? 'selected' : '' }}>Publie</option>
                                            <option value="pending" {{ filters.status == 'pending' ? 'selected' : '' }}>En moderation</option>
                                        </select>
                                    </div>
                                    <div class="col-md-2 mb-2">
                                        <div class="type-filter-dropdown">
                                            <button type="button" class="type-filter-toggle js-type-filter-toggle">
                                                <span class="type-filter-label js-type-filter-label">
                                                    {% if filters.type is defined and filters.type|length > 0 %}
                                                        {{ filters.type|join(', ') }}
                                                    {% else %}
                                                        Type projet
                                                    {% endif %}
                                                </span>
                                                <span class="type-filter-caret">&#9662;</span>
                                            </button>
                                            <div class="type-filter-menu js-type-filter-menu">
                                                <div class="type-filter-actions">
                                                    <button type="button" class="js-type-select-all">Tout cocher</button>
                                                    <button type="button" class="js-type-clear-all">Tout vider</button>
                                                </div>
                                                {% if type_options|length > 0 %}
                                                    {% for t in type_options %}
                                                        <label class="type-filter-option">
                                                            <input type="checkbox" name="type[]" value="{{ t }}" {{ t in filters.type ? 'checked' : '' }}>
                                                            <span>{{ t }}</span>
                                                        </label>
                                                    {% endfor %}
                                                {% else %}
                                                    <div class="text-muted" style="font-size: 13px;">Aucun type disponible</div>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-2 mb-2">
                                        <div class="email-filter-dropdown">
                                            <input class="email-filter-input js-email-filter-input"
                                                   type="text"
                                                   name="email"
                                                   value="{{ filters.email }}"
                                                   placeholder="Email client"
                                                   autocomplete="off">
                                            <div class="email-filter-menu js-email-filter-menu">
                                                {% if email_options|length > 0 %}
                                                    {% for e in email_options %}
                                                        <button type="button" class="email-filter-option js-email-option" data-value="{{ e }}">{{ e }}</button>
                                                    {% endfor %}
                                                {% else %}
                                                    <div class="email-filter-empty">Aucun email disponible</div>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-1 mb-2">
                                        <select class="form-control" name="per_page">
                                            {% for size in [10, 25, 50, 100] %}
                                                <option value="{{ size }}" {{ filters.per_page == size ? 'selected' : '' }}>{{ size }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                    <div class="col-md-2 mb-2">
                                        <button class="btn btn-primary" type="submit">Filtrer</button>
                                        <a class="btn btn-light" href="{{ path('admin', baseQuery|merge({'q': null, 'status': null, 'type': [], 'email': null, 'page': 1})) }}">Reset</a>
                                    </div>
                                </form>
                            </div>

                            <div class="bo-table-meta">
                                <span>{{ pagination.total }} projet{{ pagination.total > 1 ? 's' : '' }} - page {{ pagination.page }} / {{ pagination.total_pages }}</span>
                                <div class="bulk-actions">
                                    <span class="bulk-count js-bulk-count">0 selectionne</span>
                                    <button type="button" class="btn btn-danger btn-sm js-bulk-delete-btn" disabled>Supprimer la selection</button>
                                </div>
                            </div>
                            <div id="bulk-delete-config"
                                 data-url="{{ path('admin_parcours_experiences_bulk_delete') }}"
                                 data-token="{{ csrf_token('bulk_delete_experiences') }}"></div>

                            <div class="table-stats order-table ov-h">
                                <table class="table">
                                    <thead>
                                    <tr>
                                        {% set qId = query|merge({'sort_by': 'id', 'sort_dir': filters.sort_by == 'id' and filters.sort_dir == 'asc' ? 'desc' : 'asc', 'page': 1, '_locale': lang}) %}
                                        {% set qType = query|merge({'sort_by': 'type', 'sort_dir': filters.sort_by == 'type' and filters.sort_dir == 'asc' ? 'desc' : 'asc', 'page': 1, '_locale': lang}) %}
                                        {% set qVille = query|merge({'sort_by': 'ville', 'sort_dir': filters.sort_by == 'ville' and filters.sort_dir == 'asc' ? 'desc' : 'asc', 'page': 1, '_locale': lang}) %}
                                        {% set qEmail = query|merge({'sort_by': 'email', 'sort_dir': filters.sort_by == 'email' and filters.sort_dir == 'asc' ? 'desc' : 'asc', 'page': 1, '_locale': lang}) %}
                                        {% set qStatus = query|merge({'sort_by': 'status', 'sort_dir': filters.sort_by == 'status' and filters.sort_dir == 'asc' ? 'desc' : 'asc', 'page': 1, '_locale': lang}) %}
                                        {% set qDate = query|merge({'sort_by': 'date', 'sort_dir': filters.sort_by == 'date' and filters.sort_dir == 'asc' ? 'desc' : 'asc', 'page': 1, '_locale': lang}) %}
                                        <th style="width: 36px;">
                                            <input type="checkbox" class="js-select-all-rows" title="Tout selectionner">
                                        </th>
                                        <th><a class="sortable-link" href="{{ path('admin', qId) }}">ID</a></th>
                                        <th><a class="sortable-link" href="{{ path('admin', qType) }}">Type</a></th>
                                        <th><a class="sortable-link" href="{{ path('admin', qVille) }}">Ville</a></th>
                                        <th>Univers musical</th>
                                        <th><a class="sortable-link" href="{{ path('admin', qEmail) }}">Email</a></th>
                                        <th><a class="sortable-link" href="{{ path('admin', qStatus) }}">Statut</a></th>
                                        <th><a class="sortable-link" href="{{ path('admin', qDate) }}">Date</a></th>
                                        <th style="width: 56px;">...</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {% for m in experiences %}
                                        <tr style="background-color: #F7F7F7;font-weight: bold;">
                                            <td><input type="checkbox" class="js-row-select" value="{{ m.id }}" aria-label="Selectionner le projet {{ m.id }}"></td>
                                            <td>{{ m.id }}</td>
                                            <td>{{ m.exp_type_experience }}</td>
                                            <td>{{ m.exp_ville_display }}</td>
                                            <td>{{ m.exp_univers }}</td>
                                            <td>{{ m.user }}</td>
                                            <td>
                                                {% if m.status|lower == 'draft' %}
                                                    <button class="btn btn-round btn-warning">En Brouillon</button>
                                                {% elseif m.status|lower == 'pending' %}
                                                    <button class="btn btn-round btn-info">En moderation</button>
                                                {% else %}
                                                    <button class="btn btn-round btn-success">Publiee</button>
                                                {% endif %}
                                            </td>
                                            <td>{{ m.created_at }}</td>
                                            <td>
                                                <div class="row-actions">
                                                    <button type="button" class="row-actions-toggle js-row-actions-toggle">...</button>
                                                    <div class="row-actions-menu js-row-actions-menu">
                                                        <a class="row-actions-item apercuExp" attr-id="{{ m.id }}" href="" title="Details du post">Apercu</a>
                                                        {% set url = ea_url().setController('App\\Controller\\Admin\\ParcoursUtilisateur\\Experiences\\WpPostsCrudController').setAction('edit').setEntityId(m.id) %}
                                                        <a class="row-actions-item update" href="{{ url }}" title="Modifier le post">Modifier</a>
                                                        <a class="row-actions-item red delete" href="{{ path('post_delete_get', {id : m.id}) }}" title="Supprimer l'experience">Supprimer</a>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="9" class="text-center text-muted">Aucun projet trouve avec ces filtres.</td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>

                            {% if pagination.total_pages > 1 %}
                                <div class="p-3">
                                    <nav>
                                        <ul class="pagination mb-0">
                                            {% set prevPage = pagination.page - 1 %}
                                            {% set nextPage = pagination.page + 1 %}
                                            <li class="page-item {{ pagination.page <= 1 ? 'disabled' : '' }}">
                                                <a class="page-link" href="{{ path('admin', query|merge({'page': prevPage, '_locale': lang})) }}">Precedent</a>
                                            </li>
                                            {% for p in 1..pagination.total_pages %}
                                                {% if p == 1 or p == pagination.total_pages or (p >= pagination.page - 2 and p <= pagination.page + 2) %}
                                                    <li class="page-item {{ p == pagination.page ? 'active' : '' }}">
                                                        <a class="page-link" href="{{ path('admin', query|merge({'page': p, '_locale': lang})) }}">{{ p }}</a>
                                                    </li>
                                                {% endif %}
                                            {% endfor %}
                                            <li class="page-item {{ pagination.page >= pagination.total_pages ? 'disabled' : '' }}">
                                                <a class="page-link" href="{{ path('admin', query|merge({'page': nextPage, '_locale': lang})) }}">Suivant</a>
                                            </li>
                                        </ul>
                                    </nav>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade exp-preview-modal" id="apercuModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Projet: <span class="apercuTitre"></span></h5>
                    <button type="button" class="close fermerModalApercu" data-dismiss="modal" aria-label="Fermer">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="exp-preview-card">
                        <div class="exp-preview-grid">
                            <div class="exp-preview-item">
                                <strong>Type de projet</strong>
                                <span class="previewTypeValue"></span>
                            </div>
                            <div class="exp-preview-item">
                                <strong>Ville recherchee</strong>
                                <span class="villeValue"></span>
                            </div>
                            <div class="exp-preview-item">
                                <strong>Univers musical</strong>
                                <span class="universValue"></span>
                            </div>
                            <div class="exp-preview-item previewEvtWrap" style="display:none;">
                                <strong>Evenement</strong>
                                <span class="nomEvtValue"></span>
                            </div>
                            <div class="exp-preview-item previewLieuWrap" style="display:none;">
                                <strong>Lieu</strong>
                                <span class="lieuValue"></span>
                            </div>
                            <div class="exp-preview-item previewParticipantsWrap" style="display:none;">
                                <strong>Participants</strong>
                                <span class="participantValue"></span>
                            </div>
                        </div>
                    </div>
                    <div class="exp-preview-card">
                        <h5>Choisissez vos besoins</h5>
                        <div class="besoinValue exp-preview-chips"></div>
                    </div>
                    <div class="exp-preview-card">
                        <h5>Ajoutez vos options</h5>
                        <div class="optionValue exp-preview-chips"></div>
                    </div>
                    <div class="exp-preview-card">
                        <h5>Precisions</h5>
                        <p class="precisionValue exp-preview-text"></p>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary fermerModalApercu" data-dismiss="modal">Fermer</button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block body_javascript %}
    <script src="https://code.jquery.com/jquery-3.6.1.min.js"
            integrity="sha256-o88AwQnZB+VDvE9tvIXrMQaPlFFSUTR+nldQm1LuPXQ=" crossorigin="anonymous"></script>
    <script src="https://npmcdn.com/tether@1.2.4/dist/js/tether.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.0.0-alpha.4/js/bootstrap.min.js"
            integrity="sha512-Cy3gSrKCS8aJ7AIaammc0wLXyKRmTa8ntgHvU01Tuz4EdsqVgk/lKzFm/b/8RxOWBaoHI2uGLLU6rXMbqKcGHA=="
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="{{ asset('toastr/toastr.min.js') }}"></script>
    <script src="{{ asset('admin/assets/sweetalert/sweetalert.min.js') }}"></script>
    <script type="text/javascript">
        (function () {
            const $dropdown = $('.type-filter-dropdown');
            const $toggle = $('.js-type-filter-toggle');
            const $menu = $('.js-type-filter-menu');
            const $label = $('.js-type-filter-label');
            const $checkboxes = $menu.find('input[name="type[]"]');
            const $selectAll = $('.js-type-select-all');
            const $clearAll = $('.js-type-clear-all');

            function updateTypeLabel() {
                const selected = $checkboxes.filter(':checked').map(function () {
                    return $(this).val();
                }).get();
                if (!selected.length) {
                    $label.text('Type projet');
                    return;
                }
                if (selected.length <= 2) {
                    $label.text(selected.join(', '));
                    return;
                }
                $label.text(selected.length + ' types selectionnes');
            }

            $toggle.on('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                $menu.toggleClass('open');
            });

            $(document).on('click', function (e) {
                if ($(e.target).closest('.type-filter-dropdown').length === 0) {
                    $menu.removeClass('open');
                }
            });

            $menu.on('change', 'input[name="type[]"]', function () {
                updateTypeLabel();
            });

            $selectAll.on('click', function (e) {
                e.preventDefault();
                $checkboxes.prop('checked', true).trigger('change');
            });

            $clearAll.on('click', function (e) {
                e.preventDefault();
                $checkboxes.prop('checked', false).trigger('change');
            });

            $dropdown.on('keydown', function (e) {
                if (e.key === 'Escape') {
                    $menu.removeClass('open');
                    $toggle.trigger('focus');
                }
            });

            updateTypeLabel();
        })();

        (function () {
            const $emailWrap = $('.email-filter-dropdown');
            const $emailInput = $('.js-email-filter-input');
            const $emailMenu = $('.js-email-filter-menu');
            const $emailOptions = $('.js-email-option');

            function openEmailMenu() {
                $emailMenu.addClass('open');
            }

            function closeEmailMenu() {
                $emailMenu.removeClass('open');
            }

            function normalize(v) {
                return String(v || '').toLowerCase().trim();
            }

            function filterEmailOptions() {
                const query = normalize($emailInput.val());
                let visibleCount = 0;
                $emailOptions.each(function () {
                    const $opt = $(this);
                    const value = normalize($opt.data('value'));
                    const isVisible = query === '' || value.indexOf(query) !== -1;
                    $opt.toggle(isVisible);
                    if (isVisible) {
                        visibleCount++;
                    }
                });

                let $empty = $emailMenu.find('.email-filter-empty.dynamic-empty');
                if (visibleCount === 0) {
                    if ($empty.length === 0) {
                        $empty = $('<div class="email-filter-empty dynamic-empty">Aucun resultat</div>');
                        $emailMenu.append($empty);
                    }
                } else {
                    $empty.remove();
                }
            }

            $emailInput.on('focus click', function (e) {
                e.stopPropagation();
                openEmailMenu();
                filterEmailOptions();
            });

            $emailInput.on('input', function () {
                openEmailMenu();
                filterEmailOptions();
            });

            $emailMenu.on('click', '.js-email-option', function (e) {
                e.preventDefault();
                const value = $(this).data('value');
                $emailInput.val(value);
                closeEmailMenu();
            });

            $(document).on('click', function (e) {
                if ($(e.target).closest('.email-filter-dropdown').length === 0) {
                    closeEmailMenu();
                }
            });

            $emailWrap.on('keydown', function (e) {
                if (e.key === 'Escape') {
                    closeEmailMenu();
                    $emailInput.trigger('focus');
                }
            });
        })();

        (function () {
            const $rows = $('.js-row-select');
            const $selectAll = $('.js-select-all-rows');
            const $bulkBtn = $('.js-bulk-delete-btn');
            const $bulkCount = $('.js-bulk-count');
            const $bulkCfg = $('#bulk-delete-config');
            const bulkUrl = $bulkCfg.data('url');
            const bulkToken = $bulkCfg.data('token');

            function getSelectedIds() {
                return $rows.filter(':checked').map(function () {
                    return parseInt($(this).val(), 10);
                }).get().filter(function (v) { return !Number.isNaN(v) && v > 0; });
            }

            function updateBulkUi() {
                const count = getSelectedIds().length;
                $bulkBtn.prop('disabled', count === 0);
                $bulkCount.text(count + ' selectionne' + (count > 1 ? 's' : ''));
                const totalRows = $rows.length;
                $selectAll.prop('checked', totalRows > 0 && count === totalRows);
            }

            $selectAll.on('change', function () {
                $rows.prop('checked', $(this).is(':checked'));
                updateBulkUi();
            });

            $rows.on('change', function () {
                updateBulkUi();
            });

            $bulkBtn.on('click', function () {
                const selectedIds = getSelectedIds();
                if (!selectedIds.length) {
                    return;
                }

                swal({
                    title: 'Suppression de masse',
                    text: 'Confirmez-vous la suppression de ' + selectedIds.length + ' projet(s) ?',
                    type: 'warning',
                    showCancelButton: true,
                    confirmButtonClass: 'btn-danger',
                    confirmButtonText: 'Supprimer',
                    cancelButtonText: 'Annuler',
                    closeOnConfirm: false,
                    closeOnCancel: true,
                    showLoaderOnConfirm: true
                }, function (isConfirm) {
                    if (!isConfirm) {
                        return;
                    }

                    $.ajax({
                        url: bulkUrl,
                        type: 'POST',
                        dataType: 'json',
                        headers: {
                            'X-CSRF-TOKEN': bulkToken
                        },
                        data: {
                            ids: selectedIds,
                            _token: bulkToken
                        },
                        success: function (response) {
                            if (response && response.deleted_count > 0) {
                                swal('Suppression terminee', response.deleted_count + ' projet(s) supprime(s).', 'success');
                                window.location.reload();
                            } else {
                                const msg = response && response.message ? response.message : 'Aucun projet supprime.';
                                swal('Information', msg, 'info');
                            }
                        },
                        error: function (xhr) {
                            let msg = 'Erreur lors de la suppression.';
                            if (xhr && xhr.responseJSON && xhr.responseJSON.message) {
                                msg = xhr.responseJSON.message;
                            }
                            swal('Erreur', msg, 'error');
                        }
                    });
                });
            });

            updateBulkUi();
        })();

        (function () {
            const $toggles = $('.js-row-actions-toggle');

            $toggles.on('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                const $menu = $(this).siblings('.js-row-actions-menu');
                $('.js-row-actions-menu').not($menu).removeClass('open');
                $menu.toggleClass('open');
            });

            $(document).on('click', function () {
                $('.js-row-actions-menu').removeClass('open');
            });
        })();

        $(document).on('click', '.delete', function (e) {
            e.preventDefault();
            var t = $(this);
            var urlPath = $(this).attr('href');
            swal({
                title: "Suppression de l'experience",
                text: "Attention l'experience sera supprimee et n'apparaitra plus sur votre site",
                type: "info",
                showCancelButton: true,
                confirmButtonClass: "btn-danger",
                confirmButtonText: "Supprimer",
                cancelButtonText: "Annuler",
                closeOnConfirm: false,
                closeOnCancel: false,
                showLoaderOnConfirm: true
            }, function (isConfirm) {
                if (isConfirm) {
                    $.ajax({
                        url: urlPath,
                        type: 'GET',
                        success: function (reponse) {
                            if (reponse == 1) {
                                swal("Suppression terminee", "", "success");
                                t.parents('tr').hide();
                            } else {
                                swal("Erreur de suppression", "", "error");
                            }
                        },
                        error: function () {
                            swal("Erreur de suppression", "", "error");
                        }
                    });
                } else {
                    swal.close();
                }
            });
            return false;
        });

        function sanitizeText(value) {
            if (value === null || value === undefined) {
                return '';
            }
            return String(value).trim();
        }

        function setPreviewValue(selector, value, emptyLabel) {
            const text = sanitizeText(value);
            $(selector).text(text !== '' ? text : (emptyLabel || '-'));
        }

        function renderPreviewChips(selector, items) {
            const $target = $(selector);
            $target.empty();
            if (!Array.isArray(items) || items.length === 0) {
                $target.append('<p class="exp-preview-empty">Aucun element.</p>');
                return;
            }

            items.forEach(function (item) {
                const value = sanitizeText(item && item.metaValue ? item.metaValue : item);
                if (value === '') {
                    return;
                }
                $target.append('<span class="exp-preview-chip"></span>');
                $target.find('.exp-preview-chip').last().text(value);
            });

            if ($target.children().length === 0) {
                $target.append('<p class="exp-preview-empty">Aucun element.</p>');
            }
        }

        function showPreviewModal() {
            const $modal = $('#apercuModal');
            try {
                if (typeof $modal.modal === 'function') {
                    $modal.modal('show');
                } else {
                    throw new Error('modal plugin unavailable');
                }
            } catch (e) {
                if ($('.modal-backdrop').length === 0) {
                    $('body').append('<div class="modal-backdrop fade in show"></div>');
                }
                $('body').addClass('modal-open');
                $modal.addClass('in show').css('display', 'block').attr('aria-hidden', 'false');
            }
        }

        function hidePreviewModal() {
            const $modal = $('#apercuModal');
            try {
                if (typeof $modal.modal === 'function') {
                    $modal.modal('hide');
                }
            } catch (e) {
                // no-op
            }
            $modal.removeClass('in show').css('display', 'none').attr('aria-hidden', 'true');
            $('body').removeClass('modal-open');
            $('.modal-backdrop').remove();
        }

        $(function () {
            const $modal = $('#apercuModal');
            if ($modal.length && !$modal.parent().is('body')) {
                $modal.appendTo('body');
            }
        });

        $(document).on('click', '.apercuExp', function (e) {
            e.preventDefault();
            var id = $(this).attr('attr-id');
            $('.apercuTitre').text('Chargement...');
            setPreviewValue('.previewTypeValue', '', '-');
            setPreviewValue('.villeValue', '', '-');
            setPreviewValue('.universValue', '', '-');
            setPreviewValue('.nomEvtValue', '', '-');
            setPreviewValue('.lieuValue', '', '-');
            setPreviewValue('.participantValue', '', '-');
            setPreviewValue('.precisionValue', 'Chargement...', '-');
            renderPreviewChips('.besoinValue', []);
            renderPreviewChips('.optionValue', []);
            showPreviewModal();
            $.ajax({
                url: "/{{ app.request.locale }}/admin/parcours_utilisateur/experiences/details/" + id,
                type: 'GET',
                success: function (data) {
                    try {
                        if (typeof data === 'string') {
                            data = JSON.parse(data);
                        }
                    } catch (e) {
                        swal('Erreur', "Format de donnees invalide pour l'aperçu.", 'error');
                        return;
                    }

                    const typeExperience = sanitizeText(data.exp_type_experience);
                    const ville = sanitizeText(data.exp_ville);
                    const univers = sanitizeText(data.exp_univers);
                    const nomEvt = sanitizeText(data.exp_nom_evt);
                    const lieuEvt = sanitizeText(data.exp_lieu_evt);
                    const participants = sanitizeText(data.exp_participants_evt);
                    const precisions = sanitizeText(data.exp_precisions);

                    const titleParts = [typeExperience, ville, univers].filter(function (v) { return v !== ''; });
                    $('.apercuTitre').text(titleParts.length ? titleParts.join(' - ') : ('#' + id));

                    setPreviewValue('.previewTypeValue', typeExperience, '-');
                    setPreviewValue('.villeValue', ville || lieuEvt, '-');
                    setPreviewValue('.universValue', univers, '-');
                    setPreviewValue('.nomEvtValue', nomEvt, '-');
                    setPreviewValue('.lieuValue', lieuEvt, '-');
                    setPreviewValue('.participantValue', participants, '-');
                    setPreviewValue('.precisionValue', precisions, 'Aucune precision.');

                    $('.previewEvtWrap').toggle(nomEvt !== '');
                    $('.previewLieuWrap').toggle(lieuEvt !== '');
                    $('.previewParticipantsWrap').toggle(participants !== '');

                    renderPreviewChips('.besoinValue', data.exp_besoins || []);
                    renderPreviewChips('.optionValue', data.exp_options || []);
                },
                error: function () {
                    swal('Erreur', "Impossible de charger l'aperçu du projet.", 'error');
                }
            });
        });

        $(".fermerModalApercu").click(function (e) {
            e.preventDefault();
            hidePreviewModal();
        });

        $('#apercuModal').on('hidden.bs.modal', function () {
            hidePreviewModal();
        });
    </script>
{% endblock %}
