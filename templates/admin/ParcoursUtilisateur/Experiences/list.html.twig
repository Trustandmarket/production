{% extends '@!EasyAdmin/layout.html.twig' %}
{% block page_title %}
    Parcours utilisateur - Experiences
{% endblock %}

{% block main %}
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.0.0-alpha.4/css/bootstrap.min.css"
          integrity="sha512-FOS5ANNUsuvefA5Fm6hZBLsxqfF105LIysEgV8VNz29jZLVYIhI+MOLKPBmMXgkHhARFHf5pE7KbXOLE6TXW0A=="
          crossorigin="anonymous" referrerpolicy="no-referrer"/>
    <link rel="stylesheet" href="{{ asset('toastr/toastr.min.css') }}">
    <link rel="stylesheet" href="{{ asset('admin/assets/sweetalert/sweetalert.css') }}">
    <link rel="stylesheet" href="{{ asset('admin/assets/css/loading-btn.css') }}">
    <link rel="stylesheet" href="{{ asset('admin/assets/css/loading.css') }}">
    <style>
        #main-menu { font-size: 14px; }
        .bo-filters {
            padding: 14px 16px;
            background: #fafafa;
            border-bottom: 1px solid #ececec;
        }
        .bo-filters .form-control { min-height: 38px; }
        .bo-table-meta {
            padding: 10px 16px;
            font-size: 13px;
            color: #666;
            border-bottom: 1px solid #f0f0f0;
        }
        .sortable-link {
            color: #2f466b;
            text-decoration: none;
            white-space: nowrap;
        }
        .sortable-link:hover { text-decoration: underline; }
        .table td, .table th { vertical-align: middle; }
        .type-filter-dropdown { position: relative; }
        .type-filter-toggle {
            width: 100%;
            min-height: 38px;
            border: 1px solid #ced4da;
            border-radius: .25rem;
            background: #fff;
            text-align: left;
            padding: .375rem .75rem;
            color: #495057;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
        }
        .type-filter-toggle .type-filter-label {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .type-filter-toggle .type-filter-caret {
            font-size: 11px;
            color: #7a7f86;
            flex: 0 0 auto;
        }
        .type-filter-menu {
            display: none;
            position: absolute;
            top: calc(100% + 4px);
            left: 0;
            right: 0;
            z-index: 1200;
            background: #fff;
            border: 1px solid #ced4da;
            border-radius: .25rem;
            box-shadow: 0 8px 20px rgba(0,0,0,.12);
            max-height: 230px;
            overflow-y: auto;
            padding: 8px 10px;
        }
        .type-filter-menu.open { display: block; }
        .type-filter-actions {
            display: flex;
            justify-content: space-between;
            gap: 8px;
            margin-bottom: 8px;
            padding-bottom: 8px;
            border-bottom: 1px solid #edf0f3;
        }
        .type-filter-actions button {
            background: none;
            border: 0;
            padding: 0;
            color: #2f466b;
            font-size: 13px;
            cursor: pointer;
        }
        .type-filter-option {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 6px;
            font-size: 14px;
            color: #2f2f2f;
        }
        .type-filter-option:last-child { margin-bottom: 0; }
    </style>
    <div class="content">
        <div class="animated fadeIn">
            <div class="clearfix"></div>
            <div class="row">
                <div class="col-lg-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="box-title">Parcours utilisateur - Experiences</h4>
                        </div>
                        <div class="card-body--">
                            {% set query = app.request.query.all %}
                            {% set baseQuery = query|merge({'_locale': lang}) %}

                            <div class="bo-filters">
                                <form method="get" action="{{ path('admin', baseQuery) }}" class="row">
                                    {% for key, val in query %}
                                        {% if key not in ['q', 'status', 'type', 'email', 'page', 'sort_by', 'sort_dir', 'per_page'] %}
                                            {% if val is iterable %}
                                                {% for subVal in val %}
                                                    <input type="hidden" name="{{ key }}[]" value="{{ subVal }}">
                                                {% endfor %}
                                            {% else %}
                                                <input type="hidden" name="{{ key }}" value="{{ val }}">
                                            {% endif %}
                                        {% endif %}
                                    {% endfor %}
                                    <div class="col-md-3 mb-2">
                                        <input class="form-control" type="text" name="q" value="{{ filters.q }}" placeholder="Recherche globale (id, email, ville, univers)">
                                    </div>
                                    <div class="col-md-2 mb-2">
                                        <select class="form-control" name="status">
                                            <option value="">Tous statuts</option>
                                            <option value="draft" {{ filters.status == 'draft' ? 'selected' : '' }}>Brouillon</option>
                                            <option value="publish" {{ filters.status == 'publish' ? 'selected' : '' }}>Publie</option>
                                            <option value="pending" {{ filters.status == 'pending' ? 'selected' : '' }}>En moderation</option>
                                        </select>
                                    </div>
                                    <div class="col-md-2 mb-2">
                                        <div class="type-filter-dropdown">
                                            <button type="button" class="type-filter-toggle js-type-filter-toggle">
                                                <span class="type-filter-label js-type-filter-label">
                                                    {% if filters.type is defined and filters.type|length > 0 %}
                                                        {{ filters.type|join(', ') }}
                                                    {% else %}
                                                        Type projet
                                                    {% endif %}
                                                </span>
                                                <span class="type-filter-caret">&#9662;</span>
                                            </button>
                                            <div class="type-filter-menu js-type-filter-menu">
                                                <div class="type-filter-actions">
                                                    <button type="button" class="js-type-select-all">Tout cocher</button>
                                                    <button type="button" class="js-type-clear-all">Tout vider</button>
                                                </div>
                                                {% if type_options|length > 0 %}
                                                    {% for t in type_options %}
                                                        <label class="type-filter-option">
                                                            <input type="checkbox" name="type[]" value="{{ t }}" {{ t in filters.type ? 'checked' : '' }}>
                                                            <span>{{ t }}</span>
                                                        </label>
                                                    {% endfor %}
                                                {% else %}
                                                    <div class="text-muted" style="font-size: 13px;">Aucun type disponible</div>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-2 mb-2">
                                        <input class="form-control" type="text" name="email" value="{{ filters.email }}" placeholder="Email client">
                                    </div>
                                    <div class="col-md-1 mb-2">
                                        <select class="form-control" name="per_page">
                                            {% for size in [10, 25, 50, 100] %}
                                                <option value="{{ size }}" {{ filters.per_page == size ? 'selected' : '' }}>{{ size }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                    <div class="col-md-2 mb-2">
                                        <button class="btn btn-primary" type="submit">Filtrer</button>
                                        <a class="btn btn-light" href="{{ path('admin', baseQuery|merge({'q': null, 'status': null, 'type': [], 'email': null, 'page': 1})) }}">Reset</a>
                                    </div>
                                </form>
                            </div>

                            <div class="bo-table-meta">
                                {{ pagination.total }} projet{{ pagination.total > 1 ? 's' : '' }} - page {{ pagination.page }} / {{ pagination.total_pages }}
                            </div>

                            <div class="table-stats order-table ov-h">
                                <table class="table">
                                    <thead>
                                    <tr>
                                        {% set qId = query|merge({'sort_by': 'id', 'sort_dir': filters.sort_by == 'id' and filters.sort_dir == 'asc' ? 'desc' : 'asc', 'page': 1, '_locale': lang}) %}
                                        {% set qType = query|merge({'sort_by': 'type', 'sort_dir': filters.sort_by == 'type' and filters.sort_dir == 'asc' ? 'desc' : 'asc', 'page': 1, '_locale': lang}) %}
                                        {% set qVille = query|merge({'sort_by': 'ville', 'sort_dir': filters.sort_by == 'ville' and filters.sort_dir == 'asc' ? 'desc' : 'asc', 'page': 1, '_locale': lang}) %}
                                        {% set qEmail = query|merge({'sort_by': 'email', 'sort_dir': filters.sort_by == 'email' and filters.sort_dir == 'asc' ? 'desc' : 'asc', 'page': 1, '_locale': lang}) %}
                                        {% set qStatus = query|merge({'sort_by': 'status', 'sort_dir': filters.sort_by == 'status' and filters.sort_dir == 'asc' ? 'desc' : 'asc', 'page': 1, '_locale': lang}) %}
                                        {% set qDate = query|merge({'sort_by': 'date', 'sort_dir': filters.sort_by == 'date' and filters.sort_dir == 'asc' ? 'desc' : 'asc', 'page': 1, '_locale': lang}) %}
                                        <th><a class="sortable-link" href="{{ path('admin', qId) }}">ID</a></th>
                                        <th><a class="sortable-link" href="{{ path('admin', qType) }}">Type</a></th>
                                        <th><a class="sortable-link" href="{{ path('admin', qVille) }}">Ville</a></th>
                                        <th><a class="sortable-link" href="{{ path('admin', qEmail) }}">Email</a></th>
                                        <th><a class="sortable-link" href="{{ path('admin', qStatus) }}">Statut</a></th>
                                        <th><a class="sortable-link" href="{{ path('admin', qDate) }}">Date</a></th>
                                        <th>Actions</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {% for m in experiences %}
                                        <tr style="background-color: #F7F7F7;font-weight: bold;">
                                            <td>{{ m.id }}</td>
                                            <td>{{ m.exp_type_experience }}</td>
                                            <td>{{ m.exp_ville_display }}</td>
                                            <td>{{ m.user }}</td>
                                            <td>
                                                {% if m.status|lower == 'draft' %}
                                                    <button class="btn btn-round btn-warning">En Brouillon</button>
                                                {% elseif m.status|lower == 'pending' %}
                                                    <button class="btn btn-round btn-info">En moderation</button>
                                                {% else %}
                                                    <button class="btn btn-round btn-success">Publiee</button>
                                                {% endif %}
                                            </td>
                                            <td>{{ m.created_at }}</td>
                                            <td>
                                                <a class="badge badge-pending post-details my-1 apercuExp"
                                                   attr-id="{{ m.id }}" href="" title="Details du post">
                                                    <i class="fa fa-eye "></i>
                                                </a>
                                                {% set url = ea_url().setController('App\\Controller\\Admin\\ParcoursUtilisateur\\Experiences\\WpPostsCrudController').setAction('edit').setEntityId(m.id) %}
                                                <a class="badge badge-pending update my-1" href="{{ url }}"
                                                   title="Modifier le post">
                                                    <i class="fa fa-edit "></i>
                                                </a>
                                                <a class="red delete my-1"
                                                   href="{{ path('post_delete_get', {id : m.id}) }}"
                                                   title="Supprimer l'experience">
                                                    <i class="fa fa-trash"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="7" class="text-center text-muted">Aucun projet trouve avec ces filtres.</td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>

                            {% if pagination.total_pages > 1 %}
                                <div class="p-3">
                                    <nav>
                                        <ul class="pagination mb-0">
                                            {% set prevPage = pagination.page - 1 %}
                                            {% set nextPage = pagination.page + 1 %}
                                            <li class="page-item {{ pagination.page <= 1 ? 'disabled' : '' }}">
                                                <a class="page-link" href="{{ path('admin', query|merge({'page': prevPage, '_locale': lang})) }}">Precedent</a>
                                            </li>
                                            {% for p in 1..pagination.total_pages %}
                                                {% if p == 1 or p == pagination.total_pages or (p >= pagination.page - 2 and p <= pagination.page + 2) %}
                                                    <li class="page-item {{ p == pagination.page ? 'active' : '' }}">
                                                        <a class="page-link" href="{{ path('admin', query|merge({'page': p, '_locale': lang})) }}">{{ p }}</a>
                                                    </li>
                                                {% endif %}
                                            {% endfor %}
                                            <li class="page-item {{ pagination.page >= pagination.total_pages ? 'disabled' : '' }}">
                                                <a class="page-link" href="{{ path('admin', query|merge({'page': nextPage, '_locale': lang})) }}">Suivant</a>
                                            </li>
                                        </ul>
                                    </nav>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade alert-dismissible in" id="apercuModal">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Experience <span class="apercuTitre"></span></h5>
                </div>
                <div class="modal-body">
                    <div class="recap_choix">
                        <div class="inline_choix musique_choose">
                            <h4>Ville:&nbsp;</h4>
                            <p style="font-weight: 300;" class="villeValue">Paris 15eme</p>
                        </div>
                        <div class="inline_choix musique_choose">
                            <h4>Style musical:&nbsp;</h4>
                            <p style="font-weight: 300;" class="universValue">Paris 15eme</p>
                        </div>
                        <div class="inline_choix divertissement_choose">
                            <h4>Votre evenement:&nbsp;</h4>
                            <p style="font-weight: 300;" class="nomEvtValue">Paris 15eme</p>
                        </div>
                        <div class="inline_choix divertissement_choose">
                            <h4>Le lieu:&nbsp;</h4>
                            <p style="font-weight: 300;" class="lieuValue">Pop / Folk</p>
                        </div>
                        <div class="inline_choix divertissement_choose">
                            <h4>Nombre de participants:&nbsp;</h4>
                            <p style="font-weight: 300;" class="participantValue">Pop / Folk</p>
                        </div>
                        <div style="margin-top: 2rem;">
                            <h4>Liste de vos besoins:</h4>
                            <div class="besoinValue" style="margin-top: 1.7rem;">
                                <p style="font-weight: 300;margin-bottom: 1rem;">Pop / Folk</p>
                            </div>
                        </div>
                        <div style="margin-top: 3rem;">
                            <h4>Les options retenues:</h4>
                            <div class="optionValue" style="margin-top: 1.7rem;">
                                <p style="font-weight: 300;margin-bottom: 1rem;">Pop / Folk</p>
                            </div>
                        </div>
                        <div style="margin-top: 3rem;">
                            <h4>Vos precisions pour une offre sur mesure:</h4>
                            <textarea class="precisionValue field_precisions_2 form-control" name="precisions_2"
                                      id="precisions_2" cols="30" rows="5"
                                      placeholder="Donnez-nous des details pour nous permettre de personnaliser votre offre."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-round btn-secondary close fermerModalApercu p-2" data-dismiss="modal">Masquer</button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block body_javascript %}
    <script src="https://code.jquery.com/jquery-3.6.1.min.js"
            integrity="sha256-o88AwQnZB+VDvE9tvIXrMQaPlFFSUTR+nldQm1LuPXQ=" crossorigin="anonymous"></script>
    <script src="https://npmcdn.com/tether@1.2.4/dist/js/tether.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.0.0-alpha.4/js/bootstrap.min.js"
            integrity="sha512-Cy3gSrKCS8aJ7AIaammc0wLXyKRmTa8ntgHvU01Tuz4EdsqVgk/lKzFm/b/8RxOWBaoHI2uGLLU6rXMbqKcGHA=="
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="{{ asset('toastr/toastr.min.js') }}"></script>
    <script src="{{ asset('admin/assets/sweetalert/sweetalert.min.js') }}"></script>
    <script type="text/javascript">
        (function () {
            const $dropdown = $('.type-filter-dropdown');
            const $toggle = $('.js-type-filter-toggle');
            const $menu = $('.js-type-filter-menu');
            const $label = $('.js-type-filter-label');
            const $checkboxes = $menu.find('input[name="type[]"]');
            const $selectAll = $('.js-type-select-all');
            const $clearAll = $('.js-type-clear-all');

            function updateTypeLabel() {
                const selected = $checkboxes.filter(':checked').map(function () {
                    return $(this).val();
                }).get();
                if (!selected.length) {
                    $label.text('Type projet');
                    return;
                }
                if (selected.length <= 2) {
                    $label.text(selected.join(', '));
                    return;
                }
                $label.text(selected.length + ' types selectionnes');
            }

            $toggle.on('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                $menu.toggleClass('open');
            });

            $(document).on('click', function (e) {
                if ($(e.target).closest('.type-filter-dropdown').length === 0) {
                    $menu.removeClass('open');
                }
            });

            $menu.on('change', 'input[name="type[]"]', function () {
                updateTypeLabel();
            });

            $selectAll.on('click', function (e) {
                e.preventDefault();
                $checkboxes.prop('checked', true).trigger('change');
            });

            $clearAll.on('click', function (e) {
                e.preventDefault();
                $checkboxes.prop('checked', false).trigger('change');
            });

            $dropdown.on('keydown', function (e) {
                if (e.key === 'Escape') {
                    $menu.removeClass('open');
                    $toggle.trigger('focus');
                }
            });

            updateTypeLabel();
        })();

        $(document).on('click', '.delete', function (e) {
            e.preventDefault();
            var t = $(this);
            var urlPath = $(this).attr('href');
            swal({
                title: "Suppression de l'experience",
                text: "Attention l'experience sera supprimee et n'apparaitra plus sur votre site",
                type: "info",
                showCancelButton: true,
                confirmButtonClass: "btn-danger",
                confirmButtonText: "Supprimer",
                cancelButtonText: "Annuler",
                closeOnConfirm: false,
                closeOnCancel: false,
                showLoaderOnConfirm: true
            }, function (isConfirm) {
                if (isConfirm) {
                    $.ajax({
                        url: urlPath,
                        type: 'GET',
                        success: function (reponse) {
                            if (reponse == 1) {
                                swal("Suppression terminee", "", "success");
                                t.parents('tr').hide();
                            } else {
                                swal("Erreur de suppression", "", "error");
                            }
                        },
                        error: function () {
                            swal("Erreur de suppression", "", "error");
                        }
                    });
                } else {
                    swal.close();
                }
            });
            return false;
        });

        $('.apercuExp').on('click', function (e) {
            e.preventDefault();
            var id = $(this).attr('attr-id');
            $.ajax({
                url: "/{{ app.request.locale }}/admin/parcours_utilisateur/experiences/details/" + id,
                type: 'GET',
                success: function (data) {
                    data = JSON.parse(data);
                    $("#apercuModal").fadeTo("slow", 1, function () {
                        if (data.exp_type_experience == "Musique") {
                            $('.apercuTitre').text(data.exp_type_experience + " - " + data.exp_ville + " - " + data.exp_univers);
                            $('.villeValue').text(data.exp_ville);
                            $('.universValue').text(data.exp_univers);
                            $('.musique_choose').fadeIn();
                            $('.divertissement_choose').fadeOut();
                        } else {
                            $('.apercuTitre').text(data.exp_type_experience + " - " + data.exp_nom_evt + " - " + data.exp_lieu_evt);
                            $('.nomEvtValue').text(data.exp_nom_evt);
                            $('.lieuValue').text(data.exp_lieu_evt);
                            $('.participantValue').text(+data.exp_participants_evt);
                            $('.musique_choose').fadeOut();
                            $('.divertissement_choose').fadeIn();
                        }

                        $('.besoinValue').empty();
                        if (data.exp_besoins && data.exp_besoins.length > 0) {
                            data.exp_besoins.forEach((element) => {
                                $('.besoinValue').append('<p style="font-weight: 300;margin-bottom: 1rem;">' + element.metaValue + '</p>');
                            })
                        }

                        $('.optionValue').empty();
                        if (data.exp_options && data.exp_options.length > 0) {
                            data.exp_options.forEach((element) => {
                                $('.optionValue').append('<p style="font-weight: 300;margin-bottom: 1rem;">' + element.metaValue + '</p>');
                            })
                        }

                        $('.precisionValue').val(data.exp_precisions);
                    });
                }
            });
        });

        $(".fermerModalApercu").click(function () {
            $("#apercuModal").fadeTo("slow", 0, function () {
                $("#apercuModal").css("display", "none");
                $(".modal-backdrop").css("display", "none");
            });
        });
    </script>
{% endblock %}
