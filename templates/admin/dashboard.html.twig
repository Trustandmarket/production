<style>
.menu {font-size: 14px;}
.dashboard-metrics-section {
    margin-bottom: 24px;
}

.dashboard-page-title {
    margin: 0;
    color: #101828;
    font-size: 28px;
    line-height: 1.2;
    font-weight: 700;
    text-transform: uppercase;
    display: inline-block !important;
    width: auto !important;
    max-width: none !important;
    border: 0 !important;
    border-bottom: 0 !important;
    box-shadow: none !important;
    text-decoration: none !important;
    background-image: none !important;
    background: transparent !important;
    padding: 0 !important;
}

.dashboard-page-header {
    margin-bottom: 24px;
    padding-bottom: 0;
    border: 0 !important;
    box-shadow: none !important;
}

.dashboard-metrics-grid {
    display: flex;
    flex-wrap: wrap;
    margin: 0 -10px;
}

.dashboard-metrics-title {
    margin: 0 0 16px;
    color: #101828;
    font-size: 18px;
    line-height: 1.3;
    font-weight: 700;
    text-transform: uppercase;
}

.dashboard-metric-item {
    width: 20%;
    padding: 0 10px 20px;
}

.dashboard-metric-card {
    height: 100%;
    border: 1px solid #e6ebf1;
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 8px 22px rgba(15, 23, 42, 0.06);
}

.dashboard-metric-card .card-body {
    display: flex;
    align-items: center;
    min-height: 112px;
}

.dashboard-metric-icon {
    width: 52px;
    height: 52px;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    color: #fff;
    margin-right: 16px;
    flex: 0 0 auto;
}

.dashboard-metric-icon.users { background: #3b82f6; }
.dashboard-metric-icon.subscribers { background: #14b8a6; }
.dashboard-metric-icon.subscribers-verified { background: #0f766e; }
.dashboard-metric-icon.professionals { background: #8b5cf6; }
.dashboard-metric-icon.professionals-verified { background: #6d28d9; }
.dashboard-metric-icon.announcements { background: #f59e0b; }
.dashboard-metric-icon.announcements-rejected { background: #ef4444; }
.dashboard-metric-icon.announcements-draft { background: #64748b; }
.dashboard-metric-icon.announcements-moderation { background: #f97316; }
.dashboard-metric-icon.announcements-published { background: #22c55e; }

.dashboard-metric-label {
    margin: 0 0 6px;
    color: #667085;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.35;
}

.dashboard-metric-value {
    margin: 0;
    color: #101828;
    font-size: 30px;
    line-height: 1;
    font-weight: 700;
}

@media (max-width: 1199.98px) {
    .dashboard-metric-item {
        width: 33.3333%;
    }
}

@media (max-width: 767.98px) {
    .dashboard-metric-item {
        width: 50%;
    }
}

@media (max-width: 575.98px) {
    .dashboard-metric-item {
        width: 100%;
    }
}
</style>
<div class="content">
    <div class="dashboard-page-header">
        <h1 class="dashboard-page-title">TABLEAU DE BORD METIER</h1>
    </div>
    <div class="dashboard-metrics-section">
        <h2 class="dashboard-metrics-title">KPI Utilisateurs</h2>
        <div class="dashboard-metrics-grid">
            <div class="dashboard-metric-item">
                <div class="card dashboard-metric-card">
                    <div class="card-body">
                        <div class="dashboard-metric-icon users">
                            <i class="pe-7f-users"></i>
                        </div>
                        <div>
                            <p class="dashboard-metric-label">Utilisateurs total</p>
                            <p class="dashboard-metric-value">{{ users }}</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="dashboard-metric-item">
                <div class="card dashboard-metric-card">
                    <div class="card-body">
                        <div class="dashboard-metric-icon subscribers">
                            <i class="pe-7f-id"></i>
                        </div>
                        <div>
                            <p class="dashboard-metric-label">Abonnes</p>
                            <p class="dashboard-metric-value">{{ subscribers }}</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="dashboard-metric-item">
                <div class="card dashboard-metric-card">
                    <div class="card-body">
                        <div class="dashboard-metric-icon subscribers-verified">
                            <i class="pe-7f-check"></i>
                        </div>
                        <div>
                            <p class="dashboard-metric-label">Abonnes verifies</p>
                            <p class="dashboard-metric-value">{{ verified_subscribers }}</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="dashboard-metric-item">
                <div class="card dashboard-metric-card">
                    <div class="card-body">
                        <div class="dashboard-metric-icon professionals">
                            <i class="pe-7f-portfolio"></i>
                        </div>
                        <div>
                            <p class="dashboard-metric-label">Professionnels</p>
                            <p class="dashboard-metric-value">{{ professionals }}</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="dashboard-metric-item">
                <div class="card dashboard-metric-card">
                    <div class="card-body">
                        <div class="dashboard-metric-icon professionals-verified">
                            <i class="pe-7f-medal"></i>
                        </div>
                        <div>
                            <p class="dashboard-metric-label">Professionnels verifies</p>
                            <p class="dashboard-metric-value">{{ verified_professionals }}</p>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <h2 class="dashboard-metrics-title">KPI Services</h2>
        <div class="dashboard-metrics-grid">
            <div class="dashboard-metric-item">
                <div class="card dashboard-metric-card">
                    <div class="card-body">
                        <div class="dashboard-metric-icon announcements">
                            <i class="pe-7f-speaker"></i>
                        </div>
                        <div>
                            <p class="dashboard-metric-label">Annonces total</p>
                            <p class="dashboard-metric-value">{{ announcement_total }}</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="dashboard-metric-item">
                <div class="card dashboard-metric-card">
                    <div class="card-body">
                        <div class="dashboard-metric-icon announcements-rejected">
                            <i class="pe-7f-close-circle"></i>
                        </div>
                        <div>
                            <p class="dashboard-metric-label">Annonces rejetees</p>
                            <p class="dashboard-metric-value">{{ announcement_rejected }}</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="dashboard-metric-item">
                <div class="card dashboard-metric-card">
                    <div class="card-body">
                        <div class="dashboard-metric-icon announcements-draft">
                            <i class="pe-7f-edit"></i>
                        </div>
                        <div>
                            <p class="dashboard-metric-label">Annonces en brouillon</p>
                            <p class="dashboard-metric-value">{{ announcement_draft }}</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="dashboard-metric-item">
                <div class="card dashboard-metric-card">
                    <div class="card-body">
                        <div class="dashboard-metric-icon announcements-moderation">
                            <i class="pe-7f-attention"></i>
                        </div>
                        <div>
                            <p class="dashboard-metric-label">Annonces en moderation</p>
                            <p class="dashboard-metric-value">{{ announcement_moderation }}</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="dashboard-metric-item">
                <div class="card dashboard-metric-card">
                    <div class="card-body">
                        <div class="dashboard-metric-icon announcements-published">
                            <i class="pe-7f-check"></i>
                        </div>
                        <div>
                            <p class="dashboard-metric-label">Annonces publiees</p>
                            <p class="dashboard-metric-value">{{ announcement_published }}</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="box-title">Evolution des annonces / commandes au cours de l'annee {{ 'now'|date('Y') }}</h4>
                </div>
                <div class="row">
                    <div class="col-lg-12">
                        <div class="card-body">
                            <div id="traffic-chart" class="traffic-chart"></div>
                            <b style="color: #f48684;"> Annonces</b> |
                            <b style="color: #93cf96;">Commandes</b>
                        </div>
                    </div>
                </div>
                <div class="card-body"></div>
            </div>
        </div>
    </div>
</div>

{% endblock %}

{% block content_footer %}
    Made with by Kbr-Global Tech Team
{% endblock %}

{% block body_javascript %}
<script src="https://code.jquery.com/jquery-3.6.1.min.js" integrity="sha256-o88AwQnZB+VDvE9tvIXrMQaPlFFSUTR+nldQm1LuPXQ=" crossorigin="anonymous"></script>
